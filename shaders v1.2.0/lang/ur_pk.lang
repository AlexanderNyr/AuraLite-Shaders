shaderDescription=AuraLite v1.2.0 — طبیعی بادل، آسمان اور پانی، رنگ درست کرنے کے سلائیڈر
# AuraLite Shaders v1.2.0 - Copyright (c) 2026 AlexanderNyr. Licensed under CC BY-NC-SA 4.0.
# ==============================================================================
# AuraLite Shader Pack - Urdu Language Translations
# ==============================================================================

# ==============================================================================
# Quality Profiles
# ==============================================================================
profile.VERY_LOW=بہت کم
profile.VERY_LOW.comment=مکمل زیادہ سے زیادہ FPS۔ تمام اضافی بند: کوئی سایہ نہیں، کوئی بادل نہیں، کوئی PBR نہیں، کوئی SSR نہیں، کوئی روشنی کی کرن نہیں۔ صرف کم از کم رینڈرنگ۔
profile.LOW=کم
profile.LOW.comment=ہلکا لیکن کھیلنے کے قابل۔ پتوں/پانی کی اینیمیشن، روشن ستارے، FXAA، وینیٹ برقرار رکھتا ہے۔ کوئی سایہ، بادل یا PBR نہیں۔
profile.MED=درمیانہ
profile.MED.comment=روزمرہ کا مثالی نقطہ۔ سایے 1024، بادل، PBR، تیز SSR، روشنی کی کرنیں، پتوں کا SSS، گیلی عکاسی، دھند، شہاب ثاقب۔
profile.HIGH=زیادہ
profile.HIGH.comment=شوقیہ کا معیار۔ سایے 2048، متوازن SSR، TAA، نازک SSAO، متوازن روشنی کی کرنیں، SMAA۔
profile.ULTRA=الٹرا
profile.ULTRA.comment=ہائی اینڈ۔ سایے 4096، اعلی SSR، متوازن SSAO، اعلی روشنی کی کرنیں، مستحکم TAA، تمام اثرات آن۔
profile.EXTREME=انتہائی
profile.EXTREME.comment=سنیمائی زیادہ سے زیادہ۔ سب کچھ زیادہ سے زیادہ: PBR لامحدود رینج، فوٹوگرافک (AgX) ٹون میپ، سب سے گہرا SSAO، شہاب ثاقب طوفان۔
profile.CUSTOM=حسب ضرورت
profile.CUSTOM.comment=صارف کی طرف سے ترمیم شدہ حسب ضرورت ترتیبات۔

screen.TRANSLATION_NOTICE=⚠ ترجموں میں غلطیاں ہو سکتی ہیں
screen.TRANSLATION_NOTICE.comment=کچھ لوکلائزیشن سٹرنگز غلط ہو سکتی ہیں۔ اگر کچھ عجیب لگے تو انگریزی اصل سے موازنہ کریں۔

# Screens
screen.LIGHTING=روشنی کی ترتیبات
screen.LIGHTING.comment=سائے، روشنی کے رنگ اور چمک کنفیگر کریں۔

screen.FOLIAGE=پودوں کی ترتیبات
screen.FOLIAGE.comment=گھاس اور پتوں کے لیے لہراتی اینیمیشنز کنفیگر کریں۔

screen.WATER=پانی کی ترتیبات
screen.WATER.comment=لہریں، شفافیت اور پانی کا انداز کنفیگر کریں۔

screen.CLOUDS_MENU=آسمان اور بادل
screen.CLOUDS_MENU.comment=3D بادلوں اور آسمانی اثرات کی جسمانی اونچائی، موٹائی اور انداز کنفیگر کریں۔

screen.POST_PROCESS=پوسٹ پروسیسنگ اور دھند
screen.POST_PROCESS.comment=ایکسپوژر، دھند اور سینمائی اثرات کنفیگر کریں۔
screen.POST_FOG=Fog & Image
screen.POST_FOG.comment=Fog density, ground mist, heat shimmer and dithering.

# Options
option.SHADOWS=متحرک سائے
option.SHADOWS.comment=سورج اور چاند سے نرم متحرک سائے فعال یا غیر فعال کریں۔

option.shadowMapResolution=سائے کی ریزولوشن
option.shadowMapResolution.comment=شیڈو میپ کوالٹی تبدیل کریں۔ زیادہ اقدار کارکردگی کو کم کر سکتی ہیں۔

option.PBR_LIGHTING=PBR روشنی (LabPBR)
option.PBR_LIGHTING.comment=دھاتوں، کھردرے پن اور 3D نارمل نقشوں کے لیے فزیکل بیسڈ رینڈرنگ فعال کریں (PBR ریسورس پیک درکار ہے)۔

option.PBR_POM=3D بلاک ریلیف (POM)
option.PBR_POM.comment=3D بلاک ساخت کے لیے فزیکل بیسڈ پیرالیکس اوکلوژن میپنگ فعال کریں۔ غیر مطابقت پذیر ریسورس پیکس پر غیر فعال کرنے کی سفارش کی جاتی ہے۔

option.PBR_STRENGTH=PBR شدت
option.PBR_STRENGTH.comment=PBR دھاتی سطحوں کی عکاسی اور چمک کو کنٹرول کریں۔

value.PBR_STRENGTH.1=لطیف
value.PBR_STRENGTH.2=معیاری
value.PBR_STRENGTH.3=آئینہ

option.SSAO=SSAO / SAO اوکلوژن
option.SSAO.comment=Extreme profile: screen-space ambient occlusion for contact shadows in corners, under blocks, and around geometry intersections.
option.SSAO_STRENGTH=SSAO طاقت
option.SSAO_STRENGTH.comment=اسکرین اسپیس ایمبیئنٹ اوکلوژن کی گہرائی کو کنٹرول کرتا ہے۔ صرف اس وقت فعال جب SSAO فعال ہو۔
value.SSAO_STRENGTH.1=لطیف
value.SSAO_STRENGTH.2=متوازن
value.SSAO_STRENGTH.3=گہرا

option.LIGHTMAP_WARMTH=مشعل کی گرمی
option.LIGHTMAP_WARMTH.comment=بلاک/مشعل کی روشنی کی گرمی اور رنگ ایڈجسٹ کریں۔

value.LIGHTMAP_WARMTH.1=آرام دہ
value.LIGHTMAP_WARMTH.2=گرم
value.LIGHTMAP_WARMTH.3=شدید

option.WAVING_LEAVES=لہراتے پتے
option.WAVING_LEAVES.comment=درخت کے پتوں کے لیے نرم لہراتی اینیمیشنز فعال کریں۔

option.WAVING_GRASS=لہراتی نباتات
option.WAVING_GRASS.comment=گھاس، پھولوں اور فصلوں کے لیے لہراتی اینیمیشنز فعال کریں۔

option.WIND_SPEED=ہوا کی رفتار
option.WIND_SPEED.comment=پتوں، پودوں اور پانی کی لہروں کی لہرانے کی رفتار کو کنٹرول کریں۔

value.WIND_SPEED.1=نرم
value.WIND_SPEED.2=ہوا کا جھونکا
value.WIND_SPEED.3=آندھی

option.WATER_WAVES=پانی کی لہریں
option.WATER_WAVES.comment=Enable 3D geometric waves on the water surface.

option.WATER_TRANSPARENCY=پانی کی کثافت
option.WATER_TRANSPARENCY.comment=Control the transparency and opacity of the water.

value.WATER_TRANSPARENCY.1=صاف
value.WATER_TRANSPARENCY.2=متوازن
value.WATER_TRANSPARENCY.3=گہرا

option.PROCEDURAL_CLOUDS=والیومیٹرک 3D بادل
option.PROCEDURAL_CLOUDS.comment=جسمانی طور پر اڑنے کے قابل 3D بادل فعال کریں جن تک پہنچا اور اڑان بھری جا سکتی ہے۔

option.CLOUD_HEIGHT=بادل کی اونچائی
option.CLOUD_HEIGHT.comment=دنیا میں بادل کی تہہ کی جسمانی اونچائی (Y-سطح) سیٹ کریں (میٹر میں)۔


option.CLOUD_THICKNESS=بادل کی موٹائی
option.CLOUD_THICKNESS.comment=بادلوں کی عمودی موٹائی اور حجم کنفیگر کریں۔


option.CLOUD_DISTANCE=کلاؤڈ رینڈر فاصلہ
option.CLOUD_DISTANCE.comment=والیومیٹرک بادلوں کے لیے زیادہ سے زیادہ ڈرا فاصلہ۔ کوالٹی پروفائلز خودکار طور پر اسے بڑھاتے ہیں۔

option.CLOUD_SHADOWS=بادل کے سائے
option.CLOUD_SHADOWS.comment=زمین پر والیومیٹرک بادل کثافت سے شفاف طریقہ کار کے سائے شامل کرتا ہے۔ کوالٹی پروفائلز کے ذریعے متوازن۔
option.CLOUD_SHADOW_STRENGTH=بادل کے سائے کی طاقت
option.CLOUD_SHADOW_STRENGTH.comment=کنٹرول کرتا ہے کہ شفاف بادل کے سائے کتنے نظر آنے والے اور ڈرامائی ہیں۔
value.CLOUD_SHADOW_STRENGTH.1=نرم
value.CLOUD_SHADOW_STRENGTH.2=متوازن
value.CLOUD_SHADOW_STRENGTH.3=ڈرامائی

option.GODRAYS=سورج کی کرنیں (Godrays)
option.GODRAYS.comment=Adds physically-inspired volumetric single-scattering sun shafts with Beer-Lambert extinction, Mie phase and shadow-map occlusion.
option.GODRAYS_QUALITY=Godrays معیار
option.GODRAYS_QUALITY.comment=Controls the sample count and integration distance of physically-based volumetric godrays.
value.GODRAYS_QUALITY.1=تیز
value.GODRAYS_QUALITY.2=متوازن
value.GODRAYS_QUALITY.3=بلند

option.AURORA_MODE=قطبی روشنی
option.AURORA_MODE.comment=رات کے آسمان پر حقیقت پسندانہ بہتی ہوئی قطبی روشنی کی نمائش کو کنٹرول کریں۔

value.AURORA_MODE.0=غیر فعال
value.AURORA_MODE.1=صرف ٹھنڈے بایوم میں
value.AURORA_MODE.2=ہمیشہ فعال

option.AURORA_SPEED=قطبی روشنی کی رفتار
option.AURORA_SPEED.comment=شمالی روشنیوں کی لہرانے اور بہنے کی رفتار کو کنٹرول کریں۔

value.AURORA_SPEED.1=سست
value.AURORA_SPEED.2=معیاری
value.AURORA_SPEED.3=تیز

option.AURORA_STRENGTH=قطبی روشنی کی چمک
option.AURORA_STRENGTH.comment=شمالی روشنیوں کی مجموعی چمک کو کنٹرول کریں۔

value.AURORA_STRENGTH.1=نرم
value.AURORA_STRENGTH.2=معیاری
value.AURORA_STRENGTH.3=چمکتا ہوا

option.AURORA_QUALITY=Aurora Quality
option.AURORA_QUALITY.comment=Raymarch steps for Aurora Borealis. Higher settings smooth curtain volume and reduce visible layering; the new centered sampling removes per-pixel grain.
value.AURORA_QUALITY.1=Soft (8 steps)
value.AURORA_QUALITY.2=Balanced (12 steps)
value.AURORA_QUALITY.3=Silky (18 steps)
option.NEBULA_BRIGHTNESS=ملکی وے کی چمک
option.NEBULA_BRIGHTNESS.comment=رات کو ترچھی بھوری کہکشاں نیبولا کی چمک کو ایڈجسٹ کریں۔

value.NEBULA_BRIGHTNESS.1=مدھم
value.NEBULA_BRIGHTNESS.2=معیاری
value.NEBULA_BRIGHTNESS.3=روشن

option.STARS_BRIGHTNESS=ستاروں کی چمک
option.STARS_BRIGHTNESS.comment=رات کو ستاروں کی چمک اور جگمگاتی چمک کو کنٹرول کریں۔

value.STARS_BRIGHTNESS.1=مدھم
value.STARS_BRIGHTNESS.2=معیاری
value.STARS_BRIGHTNESS.3=چمکدار

option.STARS_AMOUNT=ستاروں کی کثافت
option.STARS_AMOUNT.comment=آسمان میں ستاروں کی مجموعی مقدار اور کثافت کو کنٹرول کریں۔

value.STARS_AMOUNT.1=کم
value.STARS_AMOUNT.2=معیاری
value.STARS_AMOUNT.3=گھنا

option.RAINBOW_STRENGTH=قوس قزح کی شدت
option.RAINBOW_STRENGTH.comment=بارش کے بعد قوس قزح کی چمک اور رنگ کی سنترپتی کنفیگر کریں۔

value.RAINBOW_STRENGTH.1=لطیف
value.RAINBOW_STRENGTH.2=متوازن
value.RAINBOW_STRENGTH.3=جاندار

option.COZY_LIGHTS=مشعل کی جھلملاہٹ
option.COZY_LIGHTS.comment=مشعلوں، الاؤ اور لالٹینوں کے لیے گرم، آرام دہ، حقیقی وقت کی جھلملاتی اینیمیشنز فعال کریں۔

option.WET_REFLECTIONS=بارش کی نمی کے انعکاسات
option.WET_REFLECTIONS.comment=جب بارش ہوتی ہے تو زمین، گھاس اور پتھر جیسے ٹھوس بلاکس آسمان کے نیچے گیلے، تاریک اور چمکدار ہو جاتے ہیں۔

option.GROUND_MIST=نچلی زمینی دھند (Y=62-66)
option.GROUND_MIST.comment=صبح/شام کی نرم، سنہری سفید دھند کی چادریں فعال کریں جو طلوع اور غروب کے وقت پانی اور برف پر پھسلتی ہیں۔

option.FOG_DENSITY_LEVEL=دھند کی کثافت
option.FOG_DENSITY_LEVEL.comment=ماحولیاتی افق دھند کی طاقت کو کنٹرول کریں۔

value.FOG_DENSITY_LEVEL.1=کم
value.FOG_DENSITY_LEVEL.2=درمیانہ
value.FOG_DENSITY_LEVEL.3=بلند







option.TAA=ٹیمپورل اینٹی الائیزنگ (TAA)
option.TAA.comment=موشن ری پروجیکشن اور نیبرہڈ کلپنگ کے ساتھ ٹیمپورل ریزولو۔ اعلی پری سیٹس پر جھلملاہٹ اور دانتے دار کناروں کو کم کرتا ہے۔
option.TAA_STRENGTH=TAA طاقت
option.TAA_STRENGTH.comment=تاریخ ملاپ کو کنٹرول کرتا ہے۔ زیادہ زیادہ مستحکم ہے لیکن حرکت کے دوران نرم ہو سکتا ہے۔
value.TAA_STRENGTH.1=ہلکا
value.TAA_STRENGTH.2=متوازن
value.TAA_STRENGTH.3=مستحکم

option.TAA_JITTER=کیمرے کا جھٹکا (TAA)
option.TAA_JITTER.comment=سب پکسل کیمرہ جھٹکا (Halton) جو TAA کو سب پکسل تفصیلات دوبارہ تشکیل دینے دیتا ہے۔ ڈیفالٹ طور پر بند تاکہ تصویر بالکل مستحکم رہے؛ ہلکا اور اس سے اوپر اعلی تعدد جھلملاہٹ ختم کرتا ہے مگر ہلکی وقتی لرزش پیدا کرتا ہے۔ TAA آن ہونا ضروری ہے۔
value.TAA_JITTER.0=بند
value.TAA_JITTER.1=ہلکا
value.TAA_JITTER.2=معیاری
value.TAA_JITTER.3=مضبوط


option.WATER_RIFFLES=پانی کی لہر کی طاقت
option.WATER_RIFFLES.comment=Adjust the waviness and intensity of the fine normal map ripples on the water.

value.WATER_RIFFLES.1=پرسکون
value.WATER_RIFFLES.2=معیاری
value.WATER_RIFFLES.3=موجزن

option.WATER_SPECULAR_STRENGTH=پانی کی عکاسی چمک
option.WATER_SPECULAR_STRENGTH.comment=Adjust the brightness of sun/moon reflections on the water ripples.

value.WATER_SPECULAR_STRENGTH.1=نرم
value.WATER_SPECULAR_STRENGTH.2=معیاری
value.WATER_SPECULAR_STRENGTH.3=چمکتا ہوا

option.SHADOW_SOFTNESS=سائے کی نرمی
option.SHADOW_SOFTNESS.comment=کنٹرول کرتا ہے کہ سائے کے کنارے کتنے نرم اور پھیلے ہوئے نظر آتے ہیں۔ ہموار نیم سائے کے لیے گھمائے گئے پوئسن ڈسک فلٹرنگ استعمال کرتا ہے۔

value.SHADOW_SOFTNESS.1=تیز
value.SHADOW_SOFTNESS.2=نرم
value.SHADOW_SOFTNESS.3=انتہائی نرم

# ==============================================================================
# Sun & Moon Lighting (extended)
# ==============================================================================
screen.SUN_MOON=سورج اور چاند
screen.SUN_MOON.comment=سورج اور چاند کی شدت، رنگ کا درجہ حرارت اور ماحولیاتی اثرات کو باریک بینی سے ایڈجسٹ کریں۔

option.SUN_INTENSITY=سورج کی شدت
option.SUN_INTENSITY.comment=براہ راست سورج کی روشنی کی ماسٹر چمک۔ زیادہ = مضبوط دن کا تضاد۔
value.SUN_INTENSITY.1=دھیما
value.SUN_INTENSITY.2=معیاری
value.SUN_INTENSITY.3=بلند
value.SUN_INTENSITY.4=دہکتا ہوا

option.MOON_INTENSITY=چاند کی شدت
option.MOON_INTENSITY.comment=چاندنی کی ماسٹر چمک۔ زیادہ = روشن، زیادہ نظر آنے والی راتیں۔
value.MOON_INTENSITY.1=گھپ اندھیری رات
value.MOON_INTENSITY.2=معیاری
value.MOON_INTENSITY.3=روشن چاند
value.MOON_INTENSITY.4=مکمل رات

option.SUN_TEMPERATURE=سورج کے رنگ کا درجہ حرارت
option.SUN_TEMPERATURE.comment=سورج کے کیلون وکر کو منتقل کرتا ہے۔ حقیقت پسندانہ ٹینر ہیلینڈ بلیک باڈی استعمال کرتا ہے؛ گرم = سنہری؛ ٹھنڈا = غیر جانبدار سفید۔
value.SUN_TEMPERATURE.1=ٹھنڈا / غیر جانبدار
value.SUN_TEMPERATURE.2=حقیقت پسندانہ
value.SUN_TEMPERATURE.3=گرم سنہری

option.MOON_TEMPERATURE=چاند کے رنگ کا درجہ حرارت
option.MOON_TEMPERATURE.comment=چاندنی کا رنگ۔ برفیلا = نیلا سرد؛ چاندی = حقیقت پسندانہ 4100K؛ گرم = ہارویسٹ مون کریم۔
value.MOON_TEMPERATURE.1=برفیلا نیلا
value.MOON_TEMPERATURE.2=چاندی (حقیقت پسندانہ)
value.MOON_TEMPERATURE.3=گرم کریم

option.SUN_HALO=سورج کا ہالہ (مائی سکیٹر)
option.SUN_HALO.comment=سورج کے قریب دیکھتے وقت زمین پر ایک نرم گرم چمک شامل کرتا ہے (مائی فارورڈ سکیٹرنگ)۔

option.SUNRISE_GLOW=بہتر طلوع/غروب آفتاب کی چمک
option.SUNRISE_GLOW.comment=مضبوط گرم بیک سکیٹر کو فعال کرتا ہے جو نیچے سورج سے دور سطحوں کے ارد گرد لپیٹتا ہے۔

# ==============================================================================
# Extended shadow settings
# ==============================================================================
option.shadowDistance=سائے کا فاصلہ
option.shadowDistance.comment=زیادہ سے زیادہ فاصلہ جہاں تک متحرک سایے رینڈر کیے جاتے ہیں۔ زیادہ اقدار سایوں کو رینڈر فاصلے تک پھیلاتی ہیں۔ پھیلے ہوئے دائرے میں کارکردگی برقرار رکھنے کے لیے Shadow LOD استعمال کریں۔
value.shadowDistance.60.0=قریب (60م)
value.shadowDistance.80.0=معیاری (80م)
value.shadowDistance.120.0=دور (120م)
value.shadowDistance.160.0=الٹرا (160م)
value.shadowDistance.256.0=توسیع شدہ (256 میٹر)
value.shadowDistance.384.0=رینڈر فاصلہ (384 میٹر)
value.shadowDistance.192.0=DH Seam (192m)
