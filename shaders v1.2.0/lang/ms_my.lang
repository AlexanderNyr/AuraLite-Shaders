# ==============================================================================
# Quality Profiles
# ==============================================================================
profile.VERY_LOW=Sangat Rendah
profile.VERY_LOW.comment=FPS maksimum mutlak. Semua tambahan dimatikan: tiada bayang-bayang, awan, PBR, SSR, cahaya. Hanya rendering minimum.
profile.LOW=Rendah
profile.LOW.comment=Ringan tetapi boleh dimainkan. Mengekalkan animasi dedaunan/air, bintang lebih terang, FXAA, vignette. Tiada bayang-bayang, awan atau PBR.
profile.MED=Sederhana
profile.MED.comment=Titik manis harian. Bayang-bayang 1024, awan, PBR, SSR Pantas, cahaya, SSS dedaunan, pantulan basah, kabus, meteor.
profile.HIGH=Tinggi
profile.HIGH.comment=Kualiti peminat. Bayang-bayang 2048, SSR Seimbang, TAA, SSAO Halus, cahaya Seimbang, SMAA.
profile.ULTRA=Ultra
profile.ULTRA.comment=High-end. Bayang-bayang 4096, SSR Tinggi, SSAO Seimbang, cahaya Tinggi, TAA Stabil, semua kesan dihidupkan.
profile.EXTREME=Ekstrem
profile.EXTREME.comment=Maksimum sinematik. Semua dimaksimumkan: PBR Julat tanpa had, pemetaan ton fotografi (AgX), SSAO paling dalam, ribut meteor.
profile.CUSTOM=Tersuai
profile.CUSTOM.comment=Tetapan tersuai yang diubah suai pengguna.

screen.TRANSLATION_NOTICE=⚠ Terjemahan mungkin mengandungi ralat
screen.TRANSLATION_NOTICE.comment=Sesetengah rentetan penyetempatan mungkin tidak tepat. Jika sesuatu kelihatan pelik, bandingkan dengan bahasa Inggeris asal.

# Screens
screen.LIGHTING=Tetapan Pencahayaan
screen.LIGHTING.comment=Konfigurasikan bayang-bayang, warna cahaya, dan kecerahan.

screen.FOLIAGE=Tetapan Tumbuhan
screen.FOLIAGE.comment=Konfigurasikan animasi bergoyang untuk rumput dan daun.

screen.WATER=Tetapan Air
screen.WATER.comment=Konfigurasikan ombak, ketelusan, dan gaya air.

screen.CLOUDS_MENU=Langit & Awan
screen.CLOUDS_MENU.comment=Konfigurasikan ketinggian fizikal, ketebalan, dan gaya awan 3D dan kesan langit.

screen.POST_PROCESS=Pasca-pemprosesan & Kabus
screen.POST_PROCESS.comment=Konfigurasikan pendedahan, kabus, dan kesan sinematik.
screen.POST_FOG=Fog & Image
screen.POST_FOG.comment=Fog density, ground mist, heat shimmer and dithering.

# Options
option.SHADOWS=Bayang-bayang Dinamik
option.SHADOWS.comment=Dayakan atau lumpuhkan bayang-bayang dinamik lembut daripada matahari dan bulan.

option.shadowMapResolution=Resolusi Bayang-bayang
option.shadowMapResolution.comment=Tukar kualiti peta bayang-bayang. Nilai lebih tinggi mungkin menurunkan prestasi.

option.PBR_LIGHTING=Pencahayaan PBR (LabPBR)
option.PBR_LIGHTING.comment=Dayakan rendering berasaskan fizik untuk logam, kekasaran, dan peta normal 3D (pek sumber PBR diperlukan).

option.PBR_POM=Relief Blok 3D (POM)
option.PBR_POM.comment=Dayakan Pemetaan Oklusi Paralaks berasaskan fizik untuk tekstur blok 3D. Disyorkan untuk dilumpuhkan pada pek sumber yang tidak serasi.

option.PBR_STRENGTH=Keamatan PBR
option.PBR_STRENGTH.comment=Kawal kepantulan dan kilauan permukaan logam PBR.

value.PBR_STRENGTH.1=Halus
value.PBR_STRENGTH.2=Piawai
value.PBR_STRENGTH.3=Cermin

option.SSAO=Oklusi SSAO / SAO
option.SSAO.comment=Extreme profile: screen-space ambient occlusion for contact shadows in corners, under blocks, and around geometry intersections.
option.SSAO_STRENGTH=Kekuatan SSAO
option.SSAO_STRENGTH.comment=Mengawal kedalaman oklusi ambien ruang skrin. Hanya aktif apabila SSAO didayakan.
value.SSAO_STRENGTH.1=Halus
value.SSAO_STRENGTH.2=Seimbang
value.SSAO_STRENGTH.3=Dalam

option.LIGHTMAP_WARMTH=Kehangatan Obor
option.LIGHTMAP_WARMTH.comment=Laraskan kehangatan dan warna cahaya blok/obor.

value.LIGHTMAP_WARMTH.1=Selesa
value.LIGHTMAP_WARMTH.2=Hangat
value.LIGHTMAP_WARMTH.3=Sengit

option.WAVING_LEAVES=Daun Bergoyang
option.WAVING_LEAVES.comment=Dayakan animasi bergoyang lembut untuk daun pokok.

option.WAVING_GRASS=Tumbuhan Bergoyang
option.WAVING_GRASS.comment=Dayakan animasi bergoyang untuk rumput, bunga, dan tanaman.

option.WIND_SPEED=Kelajuan Angin
option.WIND_SPEED.comment=Kawal kelajuan bergoyang daun, tumbuhan, dan ombak air.

value.WIND_SPEED.1=Lembut
value.WIND_SPEED.2=Bayu
value.WIND_SPEED.3=Ribut

option.WATER_WAVES=Ombak Air
option.WATER_WAVES.comment=Enable 3D geometric waves on the water surface.

option.WATER_TRANSPARENCY=Ketumpatan Air
option.WATER_TRANSPARENCY.comment=Control the transparency and opacity of the water.

value.WATER_TRANSPARENCY.1=Jernih
value.WATER_TRANSPARENCY.2=Seimbang
value.WATER_TRANSPARENCY.3=Dalam

option.PROCEDURAL_CLOUDS=Awan 3D Volumetrik
option.PROCEDURAL_CLOUDS.comment=Dayakan awan 3D boleh terbang secara fizikal yang boleh dicapai dan diterbangi.

option.CLOUD_HEIGHT=Ketinggian Awan
option.CLOUD_HEIGHT.comment=Tetapkan ketinggian fizikal (paras-Y) dek awan di dunia (dalam meter).


option.CLOUD_THICKNESS=Ketebalan Awan
option.CLOUD_THICKNESS.comment=Konfigurasikan ketebalan menegak dan isipadu awan.


option.CLOUD_DISTANCE=Jarak Rendering Awan
option.CLOUD_DISTANCE.comment=Jarak lukisan maksimum untuk awan volumetrik. Profil kualiti meningkatkannya secara automatik.

option.CLOUD_SHADOWS=Bayang-bayang Awan
option.CLOUD_SHADOWS.comment=Menambah bayang-bayang prosedur telus daripada ketumpatan awan volumetrik pada rupa bumi. Diseimbangkan oleh profil kualiti.
option.CLOUD_SHADOW_STRENGTH=Kekuatan Bayang-bayang Awan
option.CLOUD_SHADOW_STRENGTH.comment=Mengawal betapa jelas dan dramatik bayang-bayang awan lut sinar.
value.CLOUD_SHADOW_STRENGTH.1=Lembut
value.CLOUD_SHADOW_STRENGTH.2=Seimbang
value.CLOUD_SHADOW_STRENGTH.3=Dramatik

option.GODRAYS=Sinar Matahari (Godrays)
option.GODRAYS.comment=Adds physically-inspired volumetric single-scattering sun shafts with Beer-Lambert extinction, Mie phase and shadow-map occlusion.
option.GODRAYS_QUALITY=Kualiti Godrays
option.GODRAYS_QUALITY.comment=Controls the sample count and integration distance of physically-based volumetric godrays.
value.GODRAYS_QUALITY.1=Pantas
value.GODRAYS_QUALITY.2=Seimbang
value.GODRAYS_QUALITY.3=Tinggi

option.AURORA_MODE=Cahaya utara (Aurora Borealis)
option.AURORA_MODE.comment=Kawal paparan aurora mengalir realistik pada langit malam.

value.AURORA_MODE.0=Dilumpuhkan
value.AURORA_MODE.1=Hanya dalam Biom Sejuk
value.AURORA_MODE.2=Sentiasa Didayakan

option.AURORA_SPEED=Kelajuan Aurora
option.AURORA_SPEED.comment=Kawal kelajuan bergoyang dan mengalir cahaya utara.

value.AURORA_SPEED.1=Perlahan
value.AURORA_SPEED.2=Piawai
value.AURORA_SPEED.3=Pantas

option.AURORA_STRENGTH=Kecerahan Aurora
option.AURORA_STRENGTH.comment=Kawal kecerahan pancaran keseluruhan cahaya utara.

value.AURORA_STRENGTH.1=Lembut
value.AURORA_STRENGTH.2=Piawai
value.AURORA_STRENGTH.3=Bercahaya

option.AURORA_QUALITY=Aurora Quality
option.AURORA_QUALITY.comment=Raymarch steps for Aurora Borealis. Higher settings smooth curtain volume and reduce visible layering; the new centered sampling removes per-pixel grain.
value.AURORA_QUALITY.1=Soft (8 steps)
value.AURORA_QUALITY.2=Balanced (12 steps)
value.AURORA_QUALITY.3=Silky (18 steps)
option.NEBULA_BRIGHTNESS=Kecerahan Bima Sakti
option.NEBULA_BRIGHTNESS.comment=Laraskan kecerahan pancaran nebula galaksi kecoklatan pepenjuru pada waktu malam.

value.NEBULA_BRIGHTNESS.1=Pudar
value.NEBULA_BRIGHTNESS.2=Piawai
value.NEBULA_BRIGHTNESS.3=Cerah

option.STARS_BRIGHTNESS=Kecerahan Bintang
option.STARS_BRIGHTNESS.comment=Kawal kecerahan dan pancaran berkilauan bintang pada waktu malam.

value.STARS_BRIGHTNESS.1=Pudar
value.STARS_BRIGHTNESS.2=Piawai
value.STARS_BRIGHTNESS.3=Bersinar

option.STARS_AMOUNT=Ketumpatan Bintang
option.STARS_AMOUNT.comment=Kawal jumlah dan ketumpatan keseluruhan bintang di langit.

value.STARS_AMOUNT.1=Sedikit
value.STARS_AMOUNT.2=Piawai
value.STARS_AMOUNT.3=Padat

option.RAINBOW_STRENGTH=Keamatan Pelangi
option.RAINBOW_STRENGTH.comment=Konfigurasikan kecerahan dan ketepuan warna pelangi selepas hujan.

value.RAINBOW_STRENGTH.1=Halus
value.RAINBOW_STRENGTH.2=Seimbang
value.RAINBOW_STRENGTH.3=Meriah

option.COZY_LIGHTS=Kelipan Obor
option.COZY_LIGHTS.comment=Dayakan animasi kelipan masa nyata yang hangat dan selesa untuk obor, unggun api, dan lampu tanglung.

option.WET_REFLECTIONS=Pantulan Kebasahan Hujan
option.WET_REFLECTIONS.comment=Apabila hujan, blok pepejal seperti tanah, rumput, dan batu menjadi basah, gelap, dan berkilat di bawah langit.

option.GROUND_MIST=Kabus Tanah Rendah (Y=62-66)
option.GROUND_MIST.comment=Dayakan lapisan kabus pagi/petang lembut, putih keemasan yang meluncur di atas air dan ais pada waktu subuh dan senja.

option.FOG_DENSITY_LEVEL=Ketumpatan Kabus
option.FOG_DENSITY_LEVEL.comment=Kawal kekuatan kabus ufuk atmosfera.

value.FOG_DENSITY_LEVEL.1=Rendah
value.FOG_DENSITY_LEVEL.2=Sederhana
value.FOG_DENSITY_LEVEL.3=Tinggi







option.TAA=Anti-Aliasing Sementara (TAA)
option.TAA.comment=Resolusi sementara dengan reprojeksi gerakan dan pemotongan kejiranan. Mengurangkan kelipan dan tepi bergerigi pada praset tinggi.
option.TAA_STRENGTH=Kekuatan TAA
option.TAA_STRENGTH.comment=Mengawal penggabungan sejarah. Lebih tinggi lebih stabil tetapi boleh menjadi lebih lembut semasa pergerakan.
value.TAA_STRENGTH.1=Ringan
value.TAA_STRENGTH.2=Seimbang
value.TAA_STRENGTH.3=Stabil

option.TAA_JITTER=Gegaran kamera (TAA)
option.TAA_JITTER.comment=Gegaran kamera subpiksel (Halton) yang membolehkan TAA membina semula butiran subpiksel. Dimatikan secara lalai untuk imej yang sangat stabil; Halus ke atas menghilangkan kelipan frekuensi tinggi dengan sedikit goyangan temporal. Memerlukan TAA dihidupkan.
value.TAA_JITTER.0=Mati
value.TAA_JITTER.1=Halus
value.TAA_JITTER.2=Standard
value.TAA_JITTER.3=Kuat


option.WATER_RIFFLES=Kekuatan Riak Air
option.WATER_RIFFLES.comment=Adjust the waviness and intensity of the fine normal map ripples on the water.

value.WATER_RIFFLES.1=Tenang
value.WATER_RIFFLES.2=Piawai
value.WATER_RIFFLES.3=Bergelora

option.WATER_SPECULAR_STRENGTH=Kilauan Specular Air
option.WATER_SPECULAR_STRENGTH.comment=Adjust the brightness of sun/moon reflections on the water ripples.

value.WATER_SPECULAR_STRENGTH.1=Lembut
value.WATER_SPECULAR_STRENGTH.2=Piawai
value.WATER_SPECULAR_STRENGTH.3=Berkilauan

option.SHADOW_SOFTNESS=Kelembutan Bayang-bayang
option.SHADOW_SOFTNESS.comment=Mengawal betapa lembut dan meresap tepi bayang-bayang kelihatan. Menggunakan penapisan cakera Poisson berputar untuk penumbra licin.

value.SHADOW_SOFTNESS.1=Tajam
value.SHADOW_SOFTNESS.2=Lembut
value.SHADOW_SOFTNESS.3=Ultra Lembut

# ==============================================================================
# Sun & Moon Lighting (extended)
# ==============================================================================
screen.SUN_MOON=Matahari & Bulan
screen.SUN_MOON.comment=Perhalusi keamatan matahari & bulan, suhu warna, dan kesan atmosfera.

option.SUN_INTENSITY=Keamatan Matahari
option.SUN_INTENSITY.comment=Kecerahan induk cahaya matahari langsung. Lebih tinggi = kontras siang lebih kuat.
value.SUN_INTENSITY.1=Malap
value.SUN_INTENSITY.2=Piawai
value.SUN_INTENSITY.3=Tinggi
value.SUN_INTENSITY.4=Berkobar

option.MOON_INTENSITY=Keamatan Bulan
option.MOON_INTENSITY.comment=Kecerahan induk cahaya bulan. Lebih tinggi = malam lebih cerah, lebih kelihatan.
value.MOON_INTENSITY.1=Malam Gelap Legam
value.MOON_INTENSITY.2=Piawai
value.MOON_INTENSITY.3=Bulan Terang
value.MOON_INTENSITY.4=Malam Penuh

option.SUN_TEMPERATURE=Suhu Warna Matahari
option.SUN_TEMPERATURE.comment=Menganjakkan lengkung Kelvin matahari. Realistik menggunakan jasad hitam Tanner Helland; hangat = keemasan; sejuk = putih neutral.
value.SUN_TEMPERATURE.1=Sejuk / Neutral
value.SUN_TEMPERATURE.2=Realistik
value.SUN_TEMPERATURE.3=Keemasan Hangat

option.MOON_TEMPERATURE=Suhu Warna Bulan
option.MOON_TEMPERATURE.comment=Warna cahaya bulan. Ais = kebiruan sejuk; Perak = realistik 4100K; Hangat = krim bulan-tuaian.
value.MOON_TEMPERATURE.1=Biru Ais
value.MOON_TEMPERATURE.2=Perak (Realistik)
value.MOON_TEMPERATURE.3=Krim Hangat

option.SUN_HALO=Halo Matahari (Serakan Mie)
option.SUN_HALO.comment=Menambah pancaran hangat lembut pada rupa bumi apabila melihat berhampiran matahari (serakan hadapan Mie).

option.SUNRISE_GLOW=Pancaran Matahari Terbit/Terbenam Dipertingkatkan
option.SUNRISE_GLOW.comment=Mendayakan serakan belakang hangat yang lebih kuat yang membalut permukaan menghadap jauh dari matahari rendah.

# ==============================================================================
# Extended shadow settings
# ==============================================================================
option.shadowDistance=Jarak Bayang-bayang
option.shadowDistance.comment=Jarak maksimum di mana bayang-bayang dinamik di-render. Nilai yang lebih tinggi mengembangkan bayang-bayang ke jarak render; guna Shadow LOD untuk mengekalkan prestasi pada julat yang dilanjutkan.
value.shadowDistance.60.0=Dekat (60m)
value.shadowDistance.80.0=Piawai (80m)
value.shadowDistance.120.0=Jauh (120m)
value.shadowDistance.160.0=Ultra (160 m)
value.shadowDistance.256.0=Dilanjutkan (256 m)
value.shadowDistance.384.0=Jarak render (384 m)
value.shadowDistance.192.0=DH Seam (192m)
value.shadowDistance.512.0=DH Extended (512m)
value.shadowDistance.768.0=DH Far (768m)

option.SHADOW_LOD=LOD bayang
option.SHADOW_LOD.comment=Mengawal kemerosotan kualiti bayang-bayang dengan jarak. Dengan jarak bayang-bayang yang dilanjutkan (256-384 m), LOD mengurangkan bilangan sampel dan meningkatkan jejari penapis pada jarak untuk mengekalkan prestasi. Mati = kualiti seragam (lambat). Seimbang = pengurangan pada 25-50% jarak. Agresif = pengurangan maksimum pada 15-60% jarak. Bayang-bayang dilangkau sepenuhnya melepasi 95% jarak render.
value.SHADOW_LOD.0=Mati (kualiti seragam)
value.SHADOW_LOD.1=Seimbang
value.SHADOW_LOD.2=Agresif
option.DH_SHADOW_RANGE=Distant Horizons Shadow Range
option.DH_SHADOW_RANGE.comment=Maximum range where Distant Horizons LOD terrain and water can receive samples from the shared DH shadow map. Seam keeps shadows close to vanilla chunks; Far extends coverage but can cost more GPU time. No effect without Distant Horizons.
value.DH_SHADOW_RANGE.1=Seam (1.25x)
value.DH_SHADOW_RANGE.2=Extended (2x)
value.DH_SHADOW_RANGE.3=Far (4x)
option.SHADOW_PCSS_BLUR=Pengaburan jarak PCSS
option.SHADOW_PCSS_BLUR.comment=Mendayakan pelembutan penumbra PCSS yang meningkatkan kekaburan bayang-bayang dengan jarak dan semasa hujan. Lumpuhkan untuk kelembutan tetap (bayang-bayang jauh lebih tajam, kurang realistik).
value.SHADOW_PCSS_BLUR.0=Mati (kelembutan tetap)
value.SHADOW_PCSS_BLUR.1=Aktif (penumbra PCSS)


option.AMBIENT_BRIGHTNESS=Angkat Bayang-bayang / Ambien
option.AMBIENT_BRIGHTNESS.comment=Mengawal betapa gelap kawasan berbayang kelihatan pada waktu malam dan di dalam gua.
value.AMBIENT_BRIGHTNESS.1=Gelap
value.AMBIENT_BRIGHTNESS.2=Piawai
value.AMBIENT_BRIGHTNESS.3=Diangkat (Cerah)

option.SHADOW_TINT=Warna Bayang-bayang
option.SHADOW_TINT.comment=Mewarnai bayang-bayang siang hari. Bayang-bayang dunia sebenar di bawah langit biru mempunyai warna sejuk yang halus.
value.SHADOW_TINT.1=Kelabu neutral
value.SHADOW_TINT.2=Biru sejuk (realistik)
value.SHADOW_TINT.3=Hangat

option.LIGHT_WRAP=Bungkusan Cahaya
option.LIGHT_WRAP.comment=Melembutkan terminator antara permukaan bercahaya dan tidak bercahaya. Realistik = Lambert fizikal; Lembut = menyenangkan untuk tangkapan skrin.
value.LIGHT_WRAP.1=Realistik (Lambert)
value.LIGHT_WRAP.2=Bungkusan Lembut
value.LIGHT_WRAP.3=Bergaya

# v0.2.9 — water/underwater option value labels (English fallback)
value.WATER_WAVE_SCALE.1=Tenang
value.WATER_WAVE_SCALE.2=Piawai
value.WATER_WAVE_SCALE.3=Bergelora
value.WATER_WAVE_SCALE.4=Ribut
value.WATER_WAVE_DETAIL.1=Kasar
value.WATER_WAVE_DETAIL.2=Piawai
value.WATER_WAVE_DETAIL.3=Padat
value.UNDERWATER_NIGHT_DARKNESS.1=Kolam Diterangi Bulan
value.UNDERWATER_NIGHT_DARKNESS.2=Pudar
value.UNDERWATER_NIGHT_DARKNESS.3=Malam Sebenar
value.UNDERWATER_NIGHT_DARKNESS.4=Gelap Legam
# ==============================================================================
# Experimental Tab & New Sky (v1.1.0)
# ==============================================================================
screen.EXPERIMENTAL=Eksperimental
screen.EXPERIMENTAL.comment=Eksperimental

screen.ATMOSPHERE_OPTIONS=Atmosphere
screen.ATMOSPHERE_OPTIONS.comment=Physical-sky scattering, altitude and temporal resolve controls.
option.ATMOSPHERE_TURBIDITY=Atmospheric Turbidity
option.ATMOSPHERE_TURBIDITY.comment=Controls aerosol haze in Physical Sky. Crisp gives a deep blue sky; Hazy gives a brighter, softer horizon and stronger forward scatter.
value.ATMOSPHERE_TURBIDITY.1=Crisp
value.ATMOSPHERE_TURBIDITY.2=Balanced
value.ATMOSPHERE_TURBIDITY.3=Hazy
option.ATMOSPHERE_SCALE=Atmosphere Scale
option.ATMOSPHERE_SCALE.comment=Converts Minecraft altitude into atmosphere height for Physical Sky. Compact makes mountains affect the sky less; Cinematic preserves the original large-scale altitude effect.
value.ATMOSPHERE_SCALE.1=Compact (25m/block)
value.ATMOSPHERE_SCALE.2=Balanced (50m/block)
value.ATMOSPHERE_SCALE.3=Cinematic (100m/block)
option.GROUND_BOUNCE_MODE=Ground Bounce Albedo
option.GROUND_BOUNCE_MODE.comment=Controls the lower-atmosphere ground-bounce colour in Physical Sky. Auto adapts to cold and swamp biome signals.
value.GROUND_BOUNCE_MODE.0=Auto (Biome-aware)
value.GROUND_BOUNCE_MODE.1=Neutral Soil
value.GROUND_BOUNCE_MODE.2=Vegetation
value.GROUND_BOUNCE_MODE.3=Snow
value.GROUND_BOUNCE_MODE.4=Desert
option.SKY_TEMPORAL=Physical Sky Temporal Resolve
option.SKY_TEMPORAL.comment=Uses rotation-only history blending for Physical Sky to smooth low-sample scattering and horizon gradients. Disable if animated cloud/aurora ghosting is noticeable.
option.SKY_MODE=Langit Baharu (Serakan Atmosfera)
option.SKY_STYLE=Gaya Langit
option.SKY_STYLE.comment=Arah artistik langit fizikal. Realistik = saiz sudut sebenar dan warna neutral (rupa astronomi). Separuh realistik = matahari/bulan mudah dibaca (×2,8), warna lebih kaya, cahaya lembut. Fantasi = matahari/bulan besar (×5,5), korona besar, palet hijau-biru/merah tua/nila terang.
option.SKY_MODE.comment=EXPERIMENTAL — off in all profiles. Gradient (legacy, default) or Physical realtime scattering with true multiple scattering (Rayleigh+Mie+Ozone, 1st+2nd+3rd order). Enable manually in this tab.
value.SKY_MODE.0=Kecerunan (Lama)
value.SKY_STYLE.0=Realistik
value.SKY_STYLE.1=Separa realistik
value.SKY_STYLE.2=Fantasi
value.SKY_MODE.1=Realtime Scattering

option.SKY_QUALITY=Kualiti Serakan Langit
option.SKY_QUALITY.comment=Kualiti Serakan Langit
value.SKY_QUALITY.1=Pantas
value.SKY_QUALITY.2=Standard
value.SKY_QUALITY.3=Tinggi

# --- Auto-added missing translations (v1.1.0 sync) ---
option.FOLIAGE_SSS=SSS Dedaunan
option.FOLIAGE_SSS.comment=Mendayakan serakan subpermukaan (kelutsinaran) untuk daun, rumput, dan tumbuhan apabila melihat bertentangan cahaya.
option.GODRAYS_STRENGTH=Keamatan Godrays
option.GODRAYS_STRENGTH.comment=Kecerahan pancaran cahaya volumetrik. Halus: kabus atmosfera lembut. Seimbang: sinar jelas kelihatan. Dramatik: pancaran sinematik berani.
value.GODRAYS_STRENGTH.1=Halus
value.GODRAYS_STRENGTH.2=Seimbang
value.GODRAYS_STRENGTH.3=Dramatik
option.SHOOTING_STARS=Meteor (Bintang Jatuh)
option.SHOOTING_STARS.comment=Meteor berasaskan fizik yang memasuki mesosfera (~80-120 km). Merender lengkung 3D bulatan besar sebenar dengan lengkung cahaya ablasi, warna plasma jasad hitam (3500-5500 K), kepupusan Rayleigh berhampiran ufuk, dan jejak pengionan berterusan pada bola api.
option.SHOOTING_STARS_FREQUENCY=Aktiviti Meteor (ZHR)
option.SHOOTING_STARS_FREQUENCY.comment=Kadar Sejam Zenit anggaran. Sporadik = latar belakang realistik ~10 sejam. Aktif = hujan ringan. Ribut = ketumpatan puncak (~100/jam).
value.SHOOTING_STARS_FREQUENCY.1=Sporadik (~10/jam)
value.SHOOTING_STARS_FREQUENCY.2=Hujan Aktif
value.SHOOTING_STARS_FREQUENCY.3=Ribut Meteor
option.SHOOTING_STARS_BRIGHTNESS=Skala Magnitud
