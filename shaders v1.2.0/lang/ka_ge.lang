# ==============================================================================
# AuraLite Shader Pack - Georgian Language Translations
# ==============================================================================

# ==============================================================================
# Quality Profiles
# ==============================================================================
profile.VERY_LOW=ძალიან დაბალი
profile.VERY_LOW.comment=აბსოლუტური FPS მაქსიმუმი. ყველა დამატებითი გამორთულია: არ არის ჩრდილები, ღრუბლები, PBR, SSR, სინათლის სხივები. მხოლოდ მინიმალური რენდერი.
profile.LOW=დაბალი
profile.LOW.comment=მსუბუქი, მაგრამ სათამაშო. ინარჩუნებს ფოთლების/წყლის ანიმაციას, უფრო ნათელ ვარსკვლავებს, FXAA-ს, ვინიეტს. ჩრდილების, ღრუბლების და PBR-ის გარეშე.
profile.MED=საშუალო
profile.MED.comment=ყოველდღიური ტკბილი წერტილი. ჩრდილები 1024, ღრუბლები, PBR, SSR სწრაფი, სინათლის სხივები, ფოთლების SSS, სველი ანარეკლი, ნისლი, მეტეორები.
profile.HIGH=მაღალი
profile.HIGH.comment=მოყვარულის ხარისხი. ჩრდილები 2048, SSR დაბალანსებული, TAA, SSAO ნაზი, სინათლის სხივები დაბალანსებული, SMAA.
profile.ULTRA=ულტრა
profile.ULTRA.comment=მაღალი დონის. ჩრდილები 4096, SSR მაღალი, SSAO დაბალანსებული, სინათლის სხივები მაღალი, TAA სტაბილური, ყველა ეფექტი ჩართული.
profile.EXTREME=ექსტრემალური
profile.EXTREME.comment=კინემატოგრაფიული მაქსიმუმი. ყველაფერი მაქსიმუმზე: PBR შეუზღუდებელი დიაპაზონი, ფოტოგრაფიული (AgX) ტონის რუკა, ყველაზე ღრმა SSAO, მეტეორის ქარიშხალი.
profile.CUSTOM=მორგებული
profile.CUSTOM.comment=მომხმარებლის მიერ შეცვლილი მორგებული პარამეტრები.

screen.TRANSLATION_NOTICE=⚠ თარგმანები შეიძლება შეიცავდეს შეცდომებს
screen.TRANSLATION_NOTICE.comment=ზოგიერთი ლოკალიზაციის სტრიქონი შეიძლება არაზუსტი იყოს. თუ რაღაც უცნაურად გამოიყურება, შეადარეთ ინგლისურ ორიგინალს.

# Screens
screen.LIGHTING=განათების პარამეტრები
screen.LIGHTING.comment=დააკონფიგურირეთ ჩრდილები, სინათლის ფერები და სიკაშკაშე.

screen.FOLIAGE=მცენარეულობის პარამეტრები
screen.FOLIAGE.comment=დააკონფიგურირეთ ბალახისა და ფოთლების რხევის ანიმაცია.

screen.WATER=წყლის პარამეტრები
screen.WATER.comment=დააკონფიგურირეთ ტალღები, გამჭვირვალობა და წყლის სტილი.

screen.CLOUDS_MENU=ცა და ღრუბლები
screen.CLOUDS_MENU.comment=დააკონფიგურირეთ 3D ღრუბლების და ცის ეფექტების ფიზიკური სიმაღლე, სისქე და სტილი.

screen.POST_PROCESS=პოსტ-პროცესინგი და ნისლი
screen.POST_PROCESS.comment=დააკონფიგურირეთ ექსპოზიცია, ნისლი და კინემატოგრაფიული ეფექტები.
screen.POST_FOG=Fog & Image
screen.POST_FOG.comment=Fog density, ground mist, heat shimmer and dithering.

# Options
option.SHADOWS=დინამიური ჩრდილები
option.SHADOWS.comment=ჩართეთ ან გამორთეთ მზისა და მთვარის რბილი დინამიური ჩრდილები.

option.shadowMapResolution=ჩრდილის გარჩევადობა
option.shadowMapResolution.comment=შეცვალეთ ჩრდილის რუკის ხარისხი. მაღალმა მნიშვნელობებმა შესაძლოა შეამციროს წარმადობა.

option.PBR_LIGHTING=PBR განათება (LabPBR)
option.PBR_LIGHTING.comment=ჩართეთ ფიზიკურად სწორი რენდერინგი ლითონებისთვის, სიმქისისთვის და 3D ნორმალური რუქებისთვის (საჭიროა PBR რესურს პაკეტი).

option.PBR_POM=3D ბლოკის რელიეფი (POM)
option.PBR_POM.comment=ჩართეთ ფიზიკურად სწორი Parallax Occlusion Mapping 3D ბლოკის ტექსტურებისთვის. რეკომენდირებულია გამორთვა შეუთავსებელ რესურს პაკეტებზე.

option.PBR_STRENGTH=PBR ინტენსივობა
option.PBR_STRENGTH.comment=აკონტროლეთ PBR ლითონის ზედაპირების არეკვლა და ბზინვარება.

value.PBR_STRENGTH.1=ნაზი
value.PBR_STRENGTH.2=სტანდარტული
value.PBR_STRENGTH.3=სარკისებრი

option.SSAO=SSAO / SAO ოკლუზია
option.SSAO.comment=Extreme profile: screen-space ambient occlusion for contact shadows in corners, under blocks, and around geometry intersections.
option.SSAO_STRENGTH=SSAO სიძლიერე
option.SSAO_STRENGTH.comment=აკონტროლებს ეკრანის სივრცის გარემო ოკლუზიის სიღრმეს. აქტიურია მხოლოდ მაშინ, როცა SSAO ჩართულია.
value.SSAO_STRENGTH.1=ნაზი
value.SSAO_STRENGTH.2=დაბალანსებული
value.SSAO_STRENGTH.3=ღრმა

option.LIGHTMAP_WARMTH=ჩირაღდნის სითბო
option.LIGHTMAP_WARMTH.comment=დაარეგულირეთ ბლოკის/ჩირაღდნის სინათლის სითბო და ფერი.

value.LIGHTMAP_WARMTH.1=მყუდრო
value.LIGHTMAP_WARMTH.2=თბილი
value.LIGHTMAP_WARMTH.3=ინტენსიური

option.WAVING_LEAVES=ფოთლების ქანაობა
option.WAVING_LEAVES.comment=ჩართეთ ხის ფოთლების ნაზი ქანაობის ანიმაცია.

option.WAVING_GRASS=მცენარეულობის ქანაობა
option.WAVING_GRASS.comment=ჩართეთ ბალახის, ყვავილების და კულტურების ქანაობის ანიმაცია.

option.WIND_SPEED=ქარის სიჩქარე
option.WIND_SPEED.comment=აკონტროლეთ ფოთლების, მცენარეების და წყლის ტალღების ქანაობის სიჩქარე.

value.WIND_SPEED.1=ნაზი
value.WIND_SPEED.2=ნიავი
value.WIND_SPEED.3=ქარიშხალი

option.WATER_WAVES=წყლის ტალღები
option.WATER_WAVES.comment=Enable 3D geometric waves on the water surface.

option.WATER_TRANSPARENCY=წყლის სიმკვრივე
option.WATER_TRANSPARENCY.comment=Control the transparency and opacity of the water.

value.WATER_TRANSPARENCY.1=გამჭვირვალე
value.WATER_TRANSPARENCY.2=დაბალანსებული
value.WATER_TRANSPARENCY.3=ღრმა

option.PROCEDURAL_CLOUDS=მოცულობითი 3D ღრუბლები
option.PROCEDURAL_CLOUDS.comment=ჩართეთ ფიზიკურად გადასაფრენი 3D ღრუბლები, რომლებსაც შეგიძლიათ მიაღწიოთ და გაუფრინდეთ.

option.CLOUD_HEIGHT=ღრუბლის სიმაღლე
option.CLOUD_HEIGHT.comment=დააყენეთ ღრუბლის ფენის ფიზიკური სიმაღლე (Y-დონე) სამყაროში (მეტრებში).


option.CLOUD_THICKNESS=ღრუბლის სისქე
option.CLOUD_THICKNESS.comment=დააკონფიგურირეთ ღრუბლების ვერტიკალური სისქე და მოცულობა.


option.CLOUD_DISTANCE=ღრუბლის რენდერის მანძილი
option.CLOUD_DISTANCE.comment=მაქსიმალური დახატვის მანძილი მოცულობითი ღრუბლებისთვის. ხარისხის პროფილები ავტომატურად ზრდის მას.

option.CLOUD_SHADOWS=ღრუბლის ჩრდილები
option.CLOUD_SHADOWS.comment=ამატებს გამჭვირვალე პროცედურულ ჩრდილებს მოცულობითი ღრუბლის სიმკვრივიდან რელიეფზე. დაბალანსებულია ხარისხის პროფილებით.
option.CLOUD_SHADOW_STRENGTH=ღრუბლის ჩრდილის სიძლიერე
option.CLOUD_SHADOW_STRENGTH.comment=აკონტროლებს რამდენად თვალსაჩინო და დრამატულია გამჭვირვალე ღრუბლის ჩრდილები.
value.CLOUD_SHADOW_STRENGTH.1=რბილი
value.CLOUD_SHADOW_STRENGTH.2=დაბალანსებული
value.CLOUD_SHADOW_STRENGTH.3=დრამატული

option.GODRAYS=მზის სხივები (Godrays)
option.GODRAYS.comment=Adds physically-inspired volumetric single-scattering sun shafts with Beer-Lambert extinction, Mie phase and shadow-map occlusion.
option.GODRAYS_QUALITY=Godrays ხარისხი
option.GODRAYS_QUALITY.comment=Controls the sample count and integration distance of physically-based volumetric godrays.
value.GODRAYS_QUALITY.1=სწრაფი
value.GODRAYS_QUALITY.2=დაბალანსებული
value.GODRAYS_QUALITY.3=მაღალი

option.AURORA_MODE=ჩრდილოეთის ნათება
option.AURORA_MODE.comment=აკონტროლეთ რეალისტური მოძრავი ჩრდილოეთის ნათების ჩვენება ღამის ცაზე.

value.AURORA_MODE.0=გამორთული
value.AURORA_MODE.1=მხოლოდ ცივ ბიომებში
value.AURORA_MODE.2=ყოველთვის ჩართული

option.AURORA_SPEED=ნათების სიჩქარე
option.AURORA_SPEED.comment=აკონტროლეთ ჩრდილოეთის ნათების ქანაობისა და დინების სიჩქარე.

value.AURORA_SPEED.1=ნელი
value.AURORA_SPEED.2=სტანდარტული
value.AURORA_SPEED.3=სწრაფი

option.AURORA_STRENGTH=ნათების სიკაშკაშე
option.AURORA_STRENGTH.comment=აკონტროლეთ ჩრდილოეთის ნათების საერთო ბზინვარების სიკაშკაშე.

value.AURORA_STRENGTH.1=რბილი
value.AURORA_STRENGTH.2=სტანდარტული
value.AURORA_STRENGTH.3=ბრწყინვალე

option.AURORA_QUALITY=Aurora Quality
option.AURORA_QUALITY.comment=Raymarch steps for Aurora Borealis. Higher settings smooth curtain volume and reduce visible layering; the new centered sampling removes per-pixel grain.
value.AURORA_QUALITY.1=Soft (8 steps)
value.AURORA_QUALITY.2=Balanced (12 steps)
value.AURORA_QUALITY.3=Silky (18 steps)
option.NEBULA_BRIGHTNESS=ირმის ნახტომის სიკაშკაშე
option.NEBULA_BRIGHTNESS.comment=დაარეგულირეთ ღამით დიაგონალური მოყავისფრო გალაქტიკური ნისლეულის ბზინვარების სიკაშკაშე.

value.NEBULA_BRIGHTNESS.1=მკრთალი
value.NEBULA_BRIGHTNESS.2=სტანდარტული
value.NEBULA_BRIGHTNESS.3=ნათელი

option.STARS_BRIGHTNESS=ვარსკვლავების სიკაშკაშე
option.STARS_BRIGHTNESS.comment=აკონტროლეთ ღამით ვარსკვლავების სიკაშკაშე და ციმციმა ბზინვარება.

value.STARS_BRIGHTNESS.1=მკრთალი
value.STARS_BRIGHTNESS.2=სტანდარტული
value.STARS_BRIGHTNESS.3=ბრწყინვალე

option.STARS_AMOUNT=ვარსკვლავების სიმკვრივე
option.STARS_AMOUNT.comment=აკონტროლეთ ცაში ვარსკვლავების საერთო რაოდენობა და სიმკვრივე.

value.STARS_AMOUNT.1=ცოტა
value.STARS_AMOUNT.2=სტანდარტული
value.STARS_AMOUNT.3=მკვრივი

option.RAINBOW_STRENGTH=ცისარტყელას ინტენსივობა
option.RAINBOW_STRENGTH.comment=დააკონფიგურირეთ წვიმის შემდგომი ცისარტყელას სიკაშკაშე და ფერის გაჯერება.

value.RAINBOW_STRENGTH.1=ნაზი
value.RAINBOW_STRENGTH.2=დაბალანსებული
value.RAINBOW_STRENGTH.3=ცოცხალი

option.COZY_LIGHTS=ჩირაღდნის ციმციმი
option.COZY_LIGHTS.comment=ჩართეთ თბილი, მყუდრო, რეალურ დროში ციმციმის ანიმაცია ჩირაღდნებისთვის, კოცონებისთვის და ფარნებისთვის.

option.WET_REFLECTIONS=წვიმის სინესტის ანარეკლები
option.WET_REFLECTIONS.comment=წვიმის დროს მყარი ბლოკები, როგორიცაა მიწა, ბალახი და ქვა, ცის ქვეშ სველი, მუქი და პრიალა ხდება.

option.GROUND_MIST=დაბალი მიწისზედა ნისლი (Y=62-66)
option.GROUND_MIST.comment=ჩართეთ რბილი, ოქროსფერ-თეთრი დილის/საღამოს ნისლის ფენები, რომლებიც სრიალებენ წყალსა და ყინულზე გამთენიისას და დაბინდებისას.

option.FOG_DENSITY_LEVEL=ნისლის სიმკვრივე
option.FOG_DENSITY_LEVEL.comment=აკონტროლეთ ატმოსფერული ჰორიზონტის ნისლის სიძლიერე.

value.FOG_DENSITY_LEVEL.1=დაბალი
value.FOG_DENSITY_LEVEL.2=საშუალო
value.FOG_DENSITY_LEVEL.3=მაღალი







option.TAA=დროითი ანტი-ალიასინგი (TAA)
option.TAA.comment=დროითი გადაწყვეტა მოძრაობის ხელახალი პროექციით და მეზობლის ამოჭრით. ამცირებს ციმციმს და დაკბილულ კიდეებს მაღალ პრესეტებზე.
option.TAA_STRENGTH=TAA სიძლიერე
option.TAA_STRENGTH.comment=აკონტროლებს ისტორიის შერევას. მაღალი უფრო სტაბილურია, მაგრამ მოძრაობისას შეიძლება უფრო რბილი იყოს.
value.TAA_STRENGTH.1=მსუბუქი
value.TAA_STRENGTH.2=დაბალანსებული
value.TAA_STRENGTH.3=სტაბილური

option.TAA_JITTER=კამერის რხევა (TAA)
