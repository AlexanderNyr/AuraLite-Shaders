# ==============================================================================
# Quality Profiles
# ==============================================================================
profile.VERY_LOW=Sangat Rendah
profile.VERY_LOW.comment=FPS maksimum absolut. Semua ekstra mati: tanpa bayangan, awan, PBR, SSR, godrays. Hanya rendering minimal.
profile.LOW=Rendah
profile.MED=Sedang
profile.HIGH=Tinggi
profile.ULTRA=Ultra
profile.EXTREME=Ekstrem
profile.EXTREME.comment=Maks sinematik. Semuanya maksimal: PBR Rentang tak terbatas, pemetaan nada fotografis (AgX), SSAO terdalam, badai meteor.
profile.CUSTOM=Kustom
profile.CUSTOM.comment=Pengaturan kustom yang dimodifikasi pengguna.
profile.HIGH.comment=Kualitas antusias. Bayangan 2048, SSR Seimbang, TAA, SSAO Halus, godrays Seimbang, SMAA.
profile.LOW.comment=Ringan tapi playable. Menjaga animasi dedaunan/air, bintang lebih terang, FXAA, vignette. Tanpa bayangan, awan, atau PBR.
profile.MED.comment=Titik manis sehari-hari. Bayangan 1024, awan, PBR, SSR Cepat, godrays, foliage SSS, refleksi basah, kabut, bintang jatuh.
profile.ULTRA.comment=High-end. Bayangan 4096, SSR Tinggi, SSAO Seimbang, godrays Tinggi, TAA Stabil, semua efek aktif.

screen.TRANSLATION_NOTICE=⚠ Terjemahan mungkin mengandung kesalahan
