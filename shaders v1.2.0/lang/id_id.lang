option.SUN_HALO.comment=Menambahkan cahaya hangat lembut pada medan saat melihat dekat matahari (hamburan maju Mie).
option.SUNRISE_GLOW=Cahaya Terbit/Terbenam yang Ditingkatkan
option.SUNRISE_GLOW.comment=Mengaktifkan hamburan balik hangat yang lebih kuat yang membungkus permukaan yang membelakangi matahari rendah.

# ==============================================================================
# Pengaturan Bayangan Diperluas
# ==============================================================================
option.shadowDistance=Jarak Bayangan
option.shadowDistance.comment=Jarak maksimum di mana bayangan dinamis di-render. Nilai yang lebih tinggi memperluas bayangan ke jarak render; gunakan Shadow LOD untuk mempertahankan kinerja pada rentang yang diperluas.
value.shadowDistance.60.0=Dekat (60m)
value.shadowDistance.80.0=Standar (80m)
value.shadowDistance.120.0=Jauh (120m)
value.shadowDistance.160.0=Ultra (160 m)
value.shadowDistance.256.0=Diperluas (256 m)
value.shadowDistance.384.0=Jarak render (384 m)
value.shadowDistance.192.0=DH Seam (192m)
value.shadowDistance.512.0=DH Extended (512m)
value.shadowDistance.768.0=DH Far (768m)

option.SHADOW_LOD=LOD bayangan
option.SHADOW_LOD.comment=Mengontrol degradasi kualitas bayangan dengan jarak. Dengan jarak bayangan yang diperluas (256-384 m), LOD mengurangi jumlah sampel dan meningkatkan radius filter pada jarak untuk mempertahankan kinerja. Mati = kualitas seragam (lambat). Seimbang = pengurangan pada 25-50% jarak. Agresif = pengurangan maksimum pada 15-60% jarak. Bayangan dilewati sepenuhnya di luar 95% jarak render.
value.SHADOW_LOD.0=Mati (kualitas seragam)
value.SHADOW_LOD.1=Seimbang
value.SHADOW_LOD.2=Agresif
option.DH_SHADOW_RANGE=Distant Horizons Shadow Range
option.DH_SHADOW_RANGE.comment=Maximum range where Distant Horizons LOD terrain and water can receive samples from the shared DH shadow map. Seam keeps shadows close to vanilla chunks; Far extends coverage but can cost more GPU time. No effect without Distant Horizons.
value.DH_SHADOW_RANGE.1=Seam (1.25x)
value.DH_SHADOW_RANGE.2=Extended (2x)
value.DH_SHADOW_RANGE.3=Far (4x)
option.SHADOW_PCSS_BLUR=Blur jarak PCSS
option.SHADOW_PCSS_BLUR.comment=Mengaktifkan pelembutan penumbra PCSS yang meningkatkan keburaman bayangan dengan jarak dan saat hujan. Nonaktifkan untuk kelembutan tetap (bayangan jauh lebih tajam, kurang realistis).
value.SHADOW_PCSS_BLUR.0=Mati (kelembutan tetap)
value.SHADOW_PCSS_BLUR.1=Aktif (PCSS penumbra)

option.AMBIENT_BRIGHTNESS=Pengangkatan Bayangan / Ambien
option.AMBIENT_BRIGHTNESS.comment=Mengontrol seberapa gelap area yang teduh terlihat di malam hari dan di gua-gua.
value.AMBIENT_BRIGHTNESS.1=Gelap
value.AMBIENT_BRIGHTNESS.2=Standar
value.AMBIENT_BRIGHTNESS.3=Terangkat (Terang)
option.SHADOW_TINT=Corak Bayangan
option.SHADOW_TINT.comment=Memberi corak pada bayangan siang hari. Bayangan dunia nyata di bawah langit biru memiliki corak dingin yang halus.
value.SHADOW_TINT.1=Abu-abu Netral
value.SHADOW_TINT.2=Biru Sejuk (Realistis)
value.SHADOW_TINT.3=Hangat
option.LIGHT_WRAP=Pembungkus Cahaya
option.LIGHT_WRAP.comment=Melembutkan garis batas antara permukaan yang tersinari dan tidak. Realistis = Lambert fisik; Lembut = menyenangkan untuk tangkapan layar.
value.LIGHT_WRAP.1=Realistis (Lambert)
value.LIGHT_WRAP.2=Pembungkus Lembut
value.LIGHT_WRAP.3=Bergaya

