value.SKY_QUALITY.3=Tinggi

# --- Auto-added missing translations (v1.1.0 sync) ---
option.FOLIAGE_SSS=SSS Dedaunan
option.FOLIAGE_SSS.comment=Mengaktifkan hamburan sub-permukaan (translusensi) untuk daun, rumput, dan tanaman saat melihat ke arah cahaya.
option.GODRAYS_STRENGTH=Intensitas Godrays
option.GODRAYS_STRENGTH.comment=Kecerahan berkas cahaya volumetrik. Halus: kabut atmosfer lembut. Seimbang: sinar yang terlihat jelas. Dramatis: berkas sinematik yang mencolok.
value.GODRAYS_STRENGTH.1=Halus
value.GODRAYS_STRENGTH.2=Seimbang
value.GODRAYS_STRENGTH.3=Dramatis
option.SHOOTING_STARS=Meteor (Bintang Jatuh)
option.SHOOTING_STARS.comment=Meteor berbasis fisik yang memasuki mesosfer (~80-120 km). Merender busur 3D lingkaran besar sejati dengan kurva cahaya ablasi, warna plasma benda hitam (3500-5500 K), pemadaman Rayleigh dekat cakrawala, dan jejak ionisasi persisten pada bola api.
option.SHOOTING_STARS_FREQUENCY=Aktivitas Meteor (ZHR)
option.SHOOTING_STARS_FREQUENCY.comment=Perkiraan Tingkat Per Jam Zenital. Sporadis = latar belakang realistis ~10 per jam. Aktif = hujan meteor ringan. Badai = kepadatan puncak (~100/jam).
value.SHOOTING_STARS_FREQUENCY.1=Sporadis (~10/jam)
value.SHOOTING_STARS_FREQUENCY.2=Hujan Meteor Aktif
value.SHOOTING_STARS_FREQUENCY.3=Badai Meteor
option.SHOOTING_STARS_BRIGHTNESS=Skala Magnitudo
option.SHOOTING_STARS_BRIGHTNESS.comment=Pengali utama pada skala magnitudo meteor. Redup = rata-rata realistis; Terang = menskalakan bola api untuk visibilitas sinematik.
value.SHOOTING_STARS_BRIGHTNESS.1=Redup (Realistis)
value.SHOOTING_STARS_BRIGHTNESS.2=Standar
value.SHOOTING_STARS_BRIGHTNESS.3=Bola Api Terang
option.SPATIAL_AA_MODE=Anti-Aliasing Spasial
option.SPATIAL_AA_MODE.comment=Pilih metode anti-aliasing pasca-proses. FXAA cepat dan murah. SMAA menggunakan buffer kedalaman untuk kualitas lebih baik pada tepi geometri. Dapat dikombinasikan dengan TAA.
value.SPATIAL_AA_MODE.0=Nonaktif
value.SPATIAL_AA_MODE.1=FXAA (Cepat)
value.SPATIAL_AA_MODE.2=SMAA (Kualitas)
option.HEAT_SHIMMER=Kilauan Panas Di Atas Lava
option.HEAT_SHIMMER.comment=Aktifkan efek distorsi panas ruang layar yang halus di atas permukaan lava.
option.HEAT_SHIMMER_STRENGTH=Kekuatan Kilauan Panas
option.HEAT_SHIMMER_STRENGTH.comment=Mengontrol intensitas distorsi panas di atas lava.
value.HEAT_SHIMMER_STRENGTH.1=Halus
value.HEAT_SHIMMER_STRENGTH.2=Seimbang
value.HEAT_SHIMMER_STRENGTH.3=Kuat
option.SSR=Refleksi Ruang Layar (SSR)
option.SSR.comment=Menambahkan lingkungan reflektif real-time pada air, permukaan basah, dan blok logam PBR. Diaktifkan mulai dari profil Sedang di v1.0.4.
option.SSR_QUALITY=Kualitas SSR
option.SSR_QUALITY.comment=Mengontrol presisi dan jarak sinar refleksi ruang layar. Lebih tinggi = refleksi lebih tajam tetapi lebih banyak biaya GPU.
value.SSR_QUALITY.1=Cepat (12 langkah)
value.SSR_QUALITY.2=Seimbang (24 langkah)
value.SSR_QUALITY.3=Tinggi (40 langkah)
option.SSR_STRENGTH=Kekuatan SSR
option.SSR_STRENGTH.comment=Mengontrol seberapa terlihat dan menonjol lingkungan yang dipantulkan pada permukaan reflektif.
option.WATER_WAVE_SCALE=Amplitudo Gelombang
option.WATER_WAVE_SCALE.comment=Mengontrol kecuraman gelombang permukaan air yang terlihat. Tenang = seperti cermin, Badai = pantulan yang sangat pecah.
option.WATER_WAVE_DETAIL=Detail Gelombang
option.WATER_WAVE_DETAIL.comment=Mengontrol berapa banyak gelombang kecil muncul per blok. Kasar = beberapa gelombang besar, Padat = banyak riak kecil.
option.UNDERWATER_NIGHT_DARKNESS=Kegelapan Malam Bawah Air
option.UNDERWATER_NIGHT_DARKNESS.comment=Mengontrol seberapa gelap pemandangan bawah air di malam hari. Kolam Bercahaya Bulan mempertahankan kecerahan; Gelap Gulita memberikan kegelapan ekstrem gaya survival.
value.SSR_STRENGTH.1=Halus
value.SSR_STRENGTH.2=Seimbang
value.SSR_STRENGTH.3=Kuat
option.PBR_DISTANCE=Jarak Render PBR
option.PBR_DISTANCE.comment=Jarak maksimum untuk sorotan specular PBR. Menghemat GPU pada medan jauh. Dekat (16m) untuk Rendah, Standar (48m) untuk Sedang, Jauh (128m) untuk Tinggi/Ultra, Tak Terbatas untuk Ekstrem.
value.PBR_DISTANCE.1=Dekat (16m)
value.PBR_DISTANCE.2=Standar (48m)
value.PBR_DISTANCE.3=Jauh (128m)
value.PBR_DISTANCE.4=Tak Terbatas

