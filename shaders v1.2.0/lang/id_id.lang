# [v1.1.3]
option.CLOUD_QUALITY=Kualitas ray-marching awan
option.CLOUD_QUALITY.comment=Raymarch resolution: how many samples the cloud volume gets along the ray (14/24/36/56 steps). Lower it for FPS -- it costs shape detail only in combination with CLOUD_DETAIL below.
option.BLOOM=HDR Bloom
option.BLOOM.comment=Enable or disable the HDR bloom pass. When disabled, AuraLite skips all five bloom composite passes for lower GPU load.
option.HDR_BLOOM=Cahaya HDR
option.HDR_BLOOM.comment=Kekuatan cahaya gaussian lebar di sekitar sumber sangat terang: piringan matahari/bulan, lava, portal, kilau panas. Menggunakan pass piramida bloom baru.
value.HDR_BLOOM.1=Halus
value.HDR_BLOOM.2=Seimbang
value.HDR_BLOOM.3=Kuat
option.POST_SHARPEN=Ketajaman (CAS)
option.POST_SHARPEN.comment=Masker unsharp lembut pasca-TAA yang mengembalikan detail tekstur yang dilembutkan oleh akumulasi temporal. Nonaktifkan untuk gambar lebih lembut dan sinematik.

# [v1.1.3]

# ==============================================================================
# Only the three channel sliders carry a colour code, because there the colour
# IS the information: red gain is red, green is green, blue is blue. Everything
# else stays default white — a menu does not need a palette to be readable.
# ==============================================================================
screen.COLOR=Colour Grading
screen.COLOR.comment=Exposure, per-channel gain, brightness, contrast, saturation, gamma and vignette — all as sliders.
screen.COLOR_TONE=Tone
screen.COLOR_TONE.comment=Exposure, brightness, contrast, saturation and output gamma.
screen.COLOR_RGB=Channels
screen.COLOR_RGB.comment=Per-channel red/green/blue gain plus warm-cool and green-magenta balance.
screen.COLOR_LOOK=Look
screen.COLOR_LOOK.comment=Selective vibrance, vignette strength and the tone-mapping curve.

option.COLOR_EXPOSURE=Exposure
option.COLOR_EXPOSURE.comment=Linear exposure, applied before tone mapping. Above 1.00 the scene brightens and highlights roll off instead of clipping.
option.COLOR_BRIGHTNESS=Brightness
option.COLOR_BRIGHTNESS.comment=Midtone lift applied after tone mapping. Because it is a curve and not a multiply, blacks stay black and highlights cannot clip.
option.COLOR_CONTRAST=Contrast
option.COLOR_CONTRAST.comment=Contrast around middle grey (0.5) — the classic brightness/contrast operation.
option.COLOR_SATURATION=Saturation
option.COLOR_SATURATION.comment=0.00 is greyscale, 1.00 is untouched, above 1.00 is oversaturated.
option.COLOR_GAMMA=Output Gamma
option.COLOR_GAMMA.comment=Output encode exponent. 2.20 is the pack default. Lower values lift shadows, higher values crush them.
option.COLOR_TONEMAP=Tone Curve
option.COLOR_TONEMAP.comment=Which filmic curve maps HDR to the screen. ACES is the pack default.
value.COLOR_TONEMAP.1=ACES (default)
value.COLOR_TONEMAP.2=ACES soft
value.COLOR_TONEMAP.3=ACES punchy
value.COLOR_TONEMAP.4=Photographic (AgX-like)

option.COLOR_RED=§cRed Gain§r
option.COLOR_RED.comment=Multiplies scene-linear red before tone mapping.
option.COLOR_GREEN=§aGreen Gain§r
option.COLOR_GREEN.comment=Multiplies scene-linear green before tone mapping.
option.COLOR_BLUE=§9Blue Gain§r
option.COLOR_BLUE.comment=Multiplies scene-linear blue before tone mapping.
option.COLOR_LUMA_PROTECT=Keep Brightness (luma protect)
option.COLOR_LUMA_PROTECT.comment=On: the RGB / warmth / tint sliders shift colour but leave average brightness alone. Off: raw channel multipliers, which also brighten or darken the frame.
option.COLOR_WARMTH=Warmth
option.COLOR_WARMTH.comment=Moves the red/blue balance without touching green. Positive is warmer (sunset), negative is cooler (overcast, moonlight).
option.COLOR_TINT=Tint
option.COLOR_TINT.comment=Moves the green/magenta balance. Positive is greener, negative is magenta.

option.COLOR_VIBRANCE=Selective Vibrance
option.COLOR_VIBRANCE.comment=Saturation that treats colours differently: muted ones move more than already-saturated ones. 0.00 reproduces the pack's built-in look exactly.
option.COLOR_VIGNETTE=Vignette Strength
option.COLOR_VIGNETTE.comment=Corner darkening. 0.00 disables it without switching VIGNETTE off; 2.00 doubles it.
option.VIGNETTE=Vignette
option.VIGNETTE.comment=Master switch for corner darkening. Use Vignette Strength to dial the amount.

option.CLOUD_MODE=Cloud Renderer
option.CLOUD_MODE.comment=Volumetric: the ray marches through a 3D density field and every sample shadows itself toward the sun (self-shadowing, silver lining, real depth). Layered sheets: the v1.1.4 look, cheaper.
value.CLOUD_MODE.0=Layered sheets (v1.1.4)
value.CLOUD_MODE.1=Volumetric
option.CLOUD_COVERAGE=Cloud Coverage
option.CLOUD_COVERAGE.comment=How much of the sky the clouds fill. This changes cloud fraction, not brightness: it moves the threshold the density noise has to cross.
value.CLOUD_COVERAGE.1=Clear
value.CLOUD_COVERAGE.2=Scattered
value.CLOUD_COVERAGE.3=Broken
value.CLOUD_COVERAGE.4=Broken to overcast
value.CLOUD_COVERAGE.5=Overcast
option.CLOUD_DENSITY=Cloud Density
option.CLOUD_DENSITY.comment=Extinction coefficient of the cloud medium, in 1/m. Real water clouds sit between 0.005 and 0.1; 0.030 is a typical cumulus. Higher makes clouds darker and more opaque inside.
value.CLOUD_QUALITY.1=Cheap (14 steps)
value.CLOUD_QUALITY.2=Standard (24 steps)
value.CLOUD_QUALITY.3=High (36 steps)
value.CLOUD_QUALITY.4=Extreme (56 steps)
option.CLOUD_DETAIL=Cloud Shape Detail
option.CLOUD_DETAIL.comment=How small a feature the cloud shape can carry: 1080 m at 1, 540 m at 2, 270 m at 3, 135 m at 4. Independent of the raymarch resolution above, so you can keep crisp cloud tops and still lower the step count for FPS. Raising both together is the expensive combination.
value.CLOUD_DETAIL.1=Low (2 octaves, 1080 m)
value.CLOUD_DETAIL.2=Medium (3 octaves, 540 m)
value.CLOUD_DETAIL.3=High (4 octaves, 270 m)
value.CLOUD_DETAIL.4=Extreme (5 octaves, 135 m)

option.VEGETATION_CANOPY=Vegetation Canopy
option.VEGETATION_CANOPY.comment=Shade foliage as a canopy (light reaching the inside of the crown) instead of flat vertical cards.
option.GROUND_MIST_DENSITY=Ground Mist Density
option.GROUND_MIST_DENSITY.comment=How much mist pools in the low ground at dawn.
value.GROUND_MIST_DENSITY.1=Light
value.GROUND_MIST_DENSITY.2=Standard
value.GROUND_MIST_DENSITY.3=Heavy
option.UNDERWATER_WAVES=Underwater Waves
option.UNDERWATER_WAVES.comment=Distortion and caustics seen from below the surface. Caustics stay off by default: they are a stylistic choice, not a physical necessity.
value.UNDERWATER_WAVES.0=Off (calm)
value.UNDERWATER_WAVES.1=Subtle
value.UNDERWATER_WAVES.2=Light caustics
value.UNDERWATER_WAVES.3=Strong

option.CLOUD_CIRRUS=Cirrus Veil
option.CLOUD_CIRRUS.comment=High, thin ice cloud above the cumulus. It is raymarched like the rest, just thin and cheap. Off leaves the cumulus deck alone in the sky.
option.DITHER_STRENGTH=Output Dither
option.DITHER_STRENGTH.comment=Sub-pixel noise added before tone mapping to break up 8-bit banding in smooth sky gradients. It is a trade: less banding, a little grain. Light is half of what v1.1.4 used.
value.DITHER_STRENGTH.1=Off
value.DITHER_STRENGTH.2=Light (half of v1.1.4)
value.DITHER_STRENGTH.3=Medium
value.DITHER_STRENGTH.4=v1.1.4

option.CLOUD_HEIGHT.comment=Base altitude of the cloud deck in metres. 1200 m is a typical fair-weather cumulus base; Minecraft's own clouds sit at 192 and look like a low ceiling for that reason.
value.CLOUD_HEIGHT.1=Low (400 m)
value.CLOUD_HEIGHT.2=Cumulus base (1200 m)
value.CLOUD_HEIGHT.3=High (2400 m)
value.CLOUD_HEIGHT.4=Very high (3600 m)
option.CLOUD_THICKNESS.comment=Deck depth as a fraction of the base altitude: half, equal, or one and a half times. Fair-weather cumulus is 500-1500 m deep.
value.CLOUD_THICKNESS.1=Thin (0.5x)
value.CLOUD_THICKNESS.2=Normal (1.0x)
value.CLOUD_THICKNESS.3=Deep (1.5x)
option.CLOUD_DISTANCE.comment=How far the deck is drawn. Cloud colour is washed toward the sky with distance (aerial perspective), so the far end fades out instead of ending on an edge.
value.CLOUD_DISTANCE.1=6 km
value.CLOUD_DISTANCE.2=12 km
value.CLOUD_DISTANCE.3=20 km
value.CLOUD_DISTANCE.4=32 km

option.CLOUD_MICRO=Droplet Spectrum
option.CLOUD_MICRO.comment=Controls droplet size, which sets how much a given water content scatters and how strongly forward-scattering the phase function is. Continental air has many small droplets (brighter, more diffuse); maritime air has fewer, larger ones (darker, sharper silver lining).
value.CLOUD_MICRO.1=Continental (6 um, g=0.82)
value.CLOUD_MICRO.2=Typical (8 um, g=0.85)
value.CLOUD_MICRO.3=Maritime (12 um, g=0.87)
option.CLOUD_SCALE=Cloud Size
option.CLOUD_SCALE.comment=Width of one cloud cell relative to the depth of the deck. Real cumulus are about as wide as they are thick: compact cumulus roughly match their depth, congestus reach three depths across. Larger cells mean fewer, broader clouds in view; smaller cells mean a busier sky.
value.CLOUD_SCALE.1=Compact (1.2x depth)
value.CLOUD_SCALE.2=Typical (1.8x depth)
value.CLOUD_SCALE.3=Broad (3.0x depth)
option.CLOUD_BASE_VARIATION=Condensation Level Spread
option.CLOUD_BASE_VARIATION.comment=How much the cloud base height varies between clouds. Real cumulus share a nearly level base because every thermal condenses at the same height, but over tens of kilometres surface temperature and moisture drift, so the level is ragged rather than one shelf. Smaller values give the clean shelf of a calm afternoon; larger values give a broken, stormy sky where each cell has its own base.
value.CLOUD_BASE_VARIATION.1=Even (±40 m)
value.CLOUD_BASE_VARIATION.2=Natural (±120 m)
value.CLOUD_BASE_VARIATION.3=Ragged (±250 m)
option.CLOUD_UPDRAFT=Updraft Speed
option.CLOUD_UPDRAFT.comment=How fast the cloud body streams upward. Real cumulus are conveyor belts: air rises through them at 1-3 m/s in fair weather and 20-30 m/s in a storm core, so the shape keeps being replaced from below and the tops appear to boil. The deck itself stays at the same altitude; only the structure inside moves. Storms multiply this.
value.CLOUD_UPDRAFT.1=Drifting (1.5 m/s)
value.CLOUD_UPDRAFT.2=Natural (2.5 m/s)
value.CLOUD_UPDRAFT.3=Vigorous (4.0 m/s)
option.CLOUD_DENSITY.comment=Liquid water content of the cloud core, in g/m3. Extinction is derived from it and from droplet size, not set directly.
option.CLOUD_MID_LAYER=Lapisan awan ketinggian menengah
option.CLOUD_MID_LAYER.comment=Lapisan tambahan yang berkembang di ketinggian menengah; dapat menurunkan FPS.

value.CLOUD_DENSITY.1=Thin (0.075 g/m3)
value.CLOUD_DENSITY.2=Typical (0.15 g/m3)
value.CLOUD_DENSITY.3=Dense (0.30 g/m3)
