value.SHADOW_SOFTNESS.1=Tajam
value.SHADOW_SOFTNESS.2=Lembut
value.SHADOW_SOFTNESS.3=Sangat Lembut

option.SSAO=Oklusi SSAO / SAO
option.SSAO.comment=Profil Ekstrim: screen-space ambient occlusion untuk bayangan kontak di sudut, bawah blok, dan sekitar perpotongan geometri.
