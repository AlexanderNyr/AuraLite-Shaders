# ==============================================================================
# Experimental Tab & New Sky (v1.1.0)
# ==============================================================================
screen.EXPERIMENTAL=Experimentell
screen.EXPERIMENTAL.comment=Experimentell

screen.ATMOSPHERE_OPTIONS=Atmosphere
screen.ATMOSPHERE_OPTIONS.comment=Physical-sky scattering, altitude and temporal resolve controls.
option.ATMOSPHERE_TURBIDITY=Atmospheric Turbidity
option.ATMOSPHERE_TURBIDITY.comment=Controls aerosol haze in Physical Sky. Crisp gives a deep blue sky; Hazy gives a brighter, softer horizon and stronger forward scatter.
value.ATMOSPHERE_TURBIDITY.1=Crisp
value.ATMOSPHERE_TURBIDITY.2=Balanced
value.ATMOSPHERE_TURBIDITY.3=Hazy
option.ATMOSPHERE_SCALE=Atmosphere Scale
option.ATMOSPHERE_SCALE.comment=Converts Minecraft altitude into atmosphere height for Physical Sky. Compact makes mountains affect the sky less; Cinematic preserves the original large-scale altitude effect.
value.ATMOSPHERE_SCALE.1=Compact (25m/block)
value.ATMOSPHERE_SCALE.2=Balanced (50m/block)
value.ATMOSPHERE_SCALE.3=Cinematic (100m/block)
option.GROUND_BOUNCE_MODE=Ground Bounce Albedo
option.GROUND_BOUNCE_MODE.comment=Controls the lower-atmosphere ground-bounce colour in Physical Sky. Auto adapts to cold and swamp biome signals.
value.GROUND_BOUNCE_MODE.0=Auto (Biome-aware)
value.GROUND_BOUNCE_MODE.1=Neutral Soil
value.GROUND_BOUNCE_MODE.2=Vegetation
value.GROUND_BOUNCE_MODE.3=Snow
value.GROUND_BOUNCE_MODE.4=Desert
option.SKY_TEMPORAL=Physical Sky Temporal Resolve
option.SKY_TEMPORAL.comment=Uses rotation-only history blending for Physical Sky to smooth low-sample scattering and horizon gradients. Disable if animated cloud/aurora ghosting is noticeable.
option.SKY_MODE=Ny himmel (Atmosfärisk spridning)
option.SKY_STYLE=Himmelstil
option.SKY_STYLE.comment=Konstnärlig riktning för den fysiska himlen. Realistiskt = verkliga vinkelstorlekar och neutrala färger (astronomiutseende). Halvrealistiskt = läsbar sol/måne (×2,8), rikare färg, mjuk glöd. Fantasy = stor sol/måne (×5,5), stor korona, livfull turkos/karmosin/indigo.
option.SKY_MODE.comment=EXPERIMENTAL — off in all profiles. Gradient (legacy, default) or Physical realtime scattering with true multiple scattering (Rayleigh+Mie+Ozone, 1st+2nd+3rd order). Enable manually in this tab.
value.SKY_MODE.0=Gradient (Äldre)
value.SKY_STYLE.0=Realistisk
value.SKY_STYLE.1=Halvrealistisk
value.SKY_STYLE.2=Fantasi
value.SKY_MODE.1=Realtime Scattering

option.SKY_QUALITY=Himlens spridningskvalitet
option.SKY_QUALITY.comment=Himlens spridningskvalitet
value.SKY_QUALITY.1=Snabb
value.SKY_QUALITY.2=Standard
value.SKY_QUALITY.3=Hög

# --- Auto-added missing translations (v1.1.0 sync) ---
option.FOLIAGE_SSS=Lövverk-SSS
option.FOLIAGE_SSS.comment=Aktiverar subsurface scattering (genomskinlighet) för löv, gräs och växter i motljus.
option.GODRAYS_STRENGTH=Godrays-intensitet
option.GODRAYS_STRENGTH.comment=Ljusstyrkan hos de volymetriska ljusstrålarna. Subtil: mjuk atmosfärisk dis. Balanserad: tydligt synliga strålar. Dramatisk: djärva filmiska strålar.
value.GODRAYS_STRENGTH.1=Subtil
value.GODRAYS_STRENGTH.2=Balanserad
value.GODRAYS_STRENGTH.3=Dramatisk
option.SHOOTING_STARS=Meteorer (Stjärnfall)
option.SHOOTING_STARS.comment=Fysikbaserade meteorer som kommer in i mesosfären (~80-120 km). Renderar äkta storcirkel-3D-bågar med ablationsljuskurvor, svartkroppsplasmafärg (3500-5500 K), Rayleigh-extinktion nära horisonten och bestående joniseringsspår på eldklot.
option.SHOOTING_STARS_FREQUENCY=Meteoraktivitet (ZHR)
option.SHOOTING_STARS_FREQUENCY.comment=Ungefärlig zenital timfrekvens. Sporadisk = realistisk bakgrund på ~10 per timme. Aktiv = mild skur. Storm = topptäthet (~100/tim).
value.SHOOTING_STARS_FREQUENCY.1=Sporadisk (~10/tim)
value.SHOOTING_STARS_FREQUENCY.2=Aktiv Skur
value.SHOOTING_STARS_FREQUENCY.3=Meteorstorm
option.SHOOTING_STARS_BRIGHTNESS=Magnitudskala
option.SHOOTING_STARS_BRIGHTNESS.comment=Huvudmultiplikator på meteor-magnitudskalan. Svag = realistiskt genomsnitt; Ljus = skalar eldklot för filmisk synlighet.
value.SHOOTING_STARS_BRIGHTNESS.1=Svag (Realistisk)
value.SHOOTING_STARS_BRIGHTNESS.2=Standard
value.SHOOTING_STARS_BRIGHTNESS.3=Ljusa Eldklot
option.SPATIAL_AA_MODE=Spatial Kantutjämning
option.SPATIAL_AA_MODE.comment=Välj metod för efterbehandlingskantutjämning. FXAA är snabb och billig. SMAA använder djupbuffert för bättre kvalitet på geometriska kanter. Kan kombineras med TAA.
value.SPATIAL_AA_MODE.0=Av
value.SPATIAL_AA_MODE.1=FXAA (Snabb)
value.SPATIAL_AA_MODE.2=SMAA (Kvalitet)
option.HEAT_SHIMMER=Värmedaller Ovanför Lava
option.HEAT_SHIMMER.comment=Aktivera en subtil screen-space värmedistorsionseffekt ovanför lavaytor.
option.HEAT_SHIMMER_STRENGTH=Värmedallerstyrka
option.HEAT_SHIMMER_STRENGTH.comment=Styr intensiteten av värmedistorsionen ovanför lava.
value.HEAT_SHIMMER_STRENGTH.1=Subtil
value.HEAT_SHIMMER_STRENGTH.2=Balanserad
value.HEAT_SHIMMER_STRENGTH.3=Stark
option.SSR=Skärmutrymmesreflektioner (SSR)
option.SSR.comment=Lägger till realtidsreflekterad miljö på vatten, våta ytor och metalliska PBR-block. Aktiverat från Medel och uppåt i v1.0.4.
option.SSR_QUALITY=SSR-kvalitet
option.SSR_QUALITY.comment=Styr precisionen och strålavståndet för skärmutrymmesreflektioner. Högre = skarpare reflektioner men mer GPU-kostnad.
value.SSR_QUALITY.1=Snabb (12 steg)
value.SSR_QUALITY.2=Balanserad (24 steg)
value.SSR_QUALITY.3=Hög (40 steg)
option.SSR_STRENGTH=SSR-styrka
option.SSR_STRENGTH.comment=Styr hur synlig och framträdande den reflekterade miljön framstår på reflekterande ytor.
option.WATER_WAVE_SCALE=Vågamplitud
option.WATER_WAVE_SCALE.comment=Styr den synliga branthet av vattenytans vågor. Lugnt = spegelblankt, Stormigt = starkt brutna reflektioner.
option.WATER_WAVE_DETAIL=Vågdetalj
option.WATER_WAVE_DETAIL.comment=Styr hur många små vågor som visas per block. Grov = några stora vågor, Tät = många små krusningar.
option.UNDERWATER_NIGHT_DARKNESS=Undervattensnattmörker
option.UNDERWATER_NIGHT_DARKNESS.comment=Styr hur mörk undervattensscenen blir på natten. Månbelyst Damm behåller ljusstyrkan; Becksvart ger extrem survival-mörker.
value.SSR_STRENGTH.1=Subtil
value.SSR_STRENGTH.2=Balanserad
value.SSR_STRENGTH.3=Stark
option.PBR_DISTANCE=PBR-renderingsavstånd
option.PBR_DISTANCE.comment=Maximalt avstånd för PBR-spekulärhöjdpunkter. Sparar GPU på avlägsen terräng. Nära (16m) för Låg, Standard (48m) för Medel, Långt (128m) för Hög/Ultra, Obegränsat för Extrem.
value.PBR_DISTANCE.1=Nära (16m)
value.PBR_DISTANCE.2=Standard (48 m)
value.PBR_DISTANCE.3=Långt (128m)
value.PBR_DISTANCE.4=Obegränsad

