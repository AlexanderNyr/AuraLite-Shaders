# ==============================================================================
# Quality Profiles
# ==============================================================================
profile.VERY_LOW=Çok Düşük
profile.VERY_LOW.comment=Mutlak maksimum FPS. Tüm ekstralar kapalı: gölge yok, bulut yok, PBR yok, SSR yok, ışık huzmesi yok. Sadece minimum render.
profile.LOW=Düşük
profile.MED=Orta
profile.HIGH=Yüksek
profile.ULTRA=Ultra
profile.EXTREME=Aşırı
profile.EXTREME.comment=Sinematik maksimum. Her şey maksimumda: PBR Sınırsız menzil, fotoğrafik (AgX) ton eşleme, en derin SSAO, meteor fırtınaları.
profile.CUSTOM=Özel
profile.CUSTOM.comment=Kullanıcı tarafından özelleştirilmiş ayarlar.
profile.HIGH.comment=Meraklı kalitesi. Gölgeler 2048, SSR Dengeli, TAA, SSAO İnce, ışık huzmeleri Dengeli, SMAA.
profile.LOW.comment=Hafif ama oynanabilir. Yaprak/su animasyonunu, daha parlak yıldızları, FXAA, vinyeti korur. Gölge, bulut veya PBR yok.
profile.MED.comment=Günlük tatlı nokta. Gölgeler 1024, bulutlar, PBR, SSR Hızlı, ışık huzmeleri, yeşillik SSS, ıslak yansımalar, sis, kayan yıldızlar.
profile.ULTRA.comment=High-end. Gölgeler 4096, SSR Yüksek, SSAO Dengeli, ışık huzmeleri Yüksek, TAA Stabil, tüm efektler açık.

screen.TRANSLATION_NOTICE=⚠ Çeviriler hatalar içerebilir
screen.TRANSLATION_NOTICE.comment=Bazı çeviri metinleri hatalı olabilir. Bir şey garip görünüyorsa İngilizce orijinaliyle karşılaştırın.

# Screens
screen.LIGHTING=Aydınlatma Ayarları
screen.LIGHTING.comment=Gölgeleri, ışık renklerini ve parlaklığı yapılandırın.
screen.FOLIAGE=Bitki Örtüsü Ayarları
screen.FOLIAGE.comment=Çim ve yaprakların sallanma animasyonlarını yapılandırın.
screen.WATER=Su Ayarları
screen.WATER.comment=Dalgaları, saydamlığı ve su stilini yapılandırın.
screen.CLOUDS_MENU=Gökyüzü ve Bulutlar
screen.CLOUDS_MENU.comment=3D bulutların ve gökyüzü efektlerinin fiziksel yüksekliğini, kalınlığını ve stilini yapılandırın.
screen.POST_PROCESS=Son İşleme ve Sis
screen.POST_PROCESS.comment=Pozlamayı, sisi ve sinematik efektleri yapılandırın.
screen.POST_FOG=Fog & Image
screen.POST_FOG.comment=Fog density, ground mist, heat shimmer and dithering.

# Options
option.SHADOWS=Dinamik Gölgeler
option.SHADOWS.comment=Güneş ve aydan gelen yumuşak dinamik gölgeleri etkinleştirin veya devre dışı bırakın.
option.shadowMapResolution=Gölge Çözünürlüğü
option.shadowMapResolution.comment=Gölge haritası kalitesini değiştirin. Daha yüksek değerler performansı düşürebilir.
option.PBR_LIGHTING=PBR Aydınlatma (LabPBR)
option.PBR_LIGHTING.comment=Metaller, pürüzlülük ve 3D normal haritalar için fiziksel tabanlı render'ı etkinleştirin (PBR kaynak paketi gereklidir).
option.PBR_POM=3D Blok Kabartması (POM)
option.PBR_POM.comment=3D blok dokuları için fiziksel tabanlı Paralaks Oklüzyon Haritalamasını etkinleştirin. Uyumsuz kaynak paketlerinde devre dışı bırakılması önerilir.
option.PBR_STRENGTH=PBR Yoğunluğu
option.PBR_STRENGTH.comment=PBR metalik yüzeylerin yansıtıcılığını ve parlaklığını kontrol edin.
value.PBR_STRENGTH.1=Hafif
value.PBR_STRENGTH.2=Standart
value.PBR_STRENGTH.3=Ayna
option.LIGHTMAP_WARMTH=Meşale Sıcaklığı
option.LIGHTMAP_WARMTH.comment=Blok/meşale ışığının sıcaklığını ve rengini ayarlayın.
value.LIGHTMAP_WARMTH.1=Samimi
value.LIGHTMAP_WARMTH.2=Sıcak
value.LIGHTMAP_WARMTH.3=Yoğun
option.WAVING_LEAVES=Sallanan Yapraklar
option.WAVING_LEAVES.comment=Ağaç yaprakları için hafif sallanma animasyonlarını etkinleştirin.
option.WAVING_GRASS=Sallanan Bitki Örtüsü
option.WAVING_GRASS.comment=Çim, çiçek ve mahsuller için sallanma animasyonlarını etkinleştirin.
option.WIND_SPEED=Rüzgar Hızı
option.WIND_SPEED.comment=Yaprakların, bitkilerin ve su dalgalarının sallanma hızını kontrol edin.
value.WIND_SPEED.1=Hafif
value.WIND_SPEED.2=Esinti
value.WIND_SPEED.3=Fırtına
option.WATER_WAVES=Su Dalgaları
option.WATER_WAVES.comment=Su yüzeyinde 3D geometrik dalgaları etkinleştirir.
option.WATER_TRANSPARENCY=Su Yoğunluğu
option.WATER_TRANSPARENCY.comment=Suyun şeffaflığını ve opaklığını kontrol eder.
value.WATER_TRANSPARENCY.1=Berrak
value.WATER_TRANSPARENCY.2=Dengeli
value.WATER_TRANSPARENCY.3=Derin
option.PROCEDURAL_CLOUDS=Hacimsel 3D Bulutlar
option.PROCEDURAL_CLOUDS.comment=Ulaşılabilen ve içinden uçulabilen fiziksel olarak uçulabilir 3D bulutları etkinleştirin.
option.CLOUD_HEIGHT=Bulut Yüksekliği
option.CLOUD_HEIGHT.comment=Dünyadaki bulut katmanının fiziksel yüksekliğini (Y seviyesi) ayarlayın (metre cinsinden).
option.CLOUD_THICKNESS=Bulut Kalınlığı
option.CLOUD_THICKNESS.comment=Bulutların dikey kalınlığını ve hacmini yapılandırın.
option.AURORA_MODE=Kuzey Işıkları
option.AURORA_MODE.comment=Gece gökyüzünde gerçekçi akan kuzey ışıklarının görüntülenmesini kontrol edin.
value.AURORA_MODE.0=Devre Dışı
value.AURORA_MODE.1=Sadece Soğuk Biyomlarda
value.AURORA_MODE.2=Her Zaman Etkin
option.AURORA_SPEED=Kuzey Işıkları Hızı
option.AURORA_SPEED.comment=Kuzey ışıklarının dalgalanma ve akış hızını kontrol edin.
value.AURORA_SPEED.1=Yavaş
value.AURORA_SPEED.2=Standart
value.AURORA_SPEED.3=Hızlı
option.AURORA_STRENGTH=Kuzey Işıkları Parlaklığı
option.AURORA_STRENGTH.comment=Kuzey ışıklarının genel parıltı parlaklığını kontrol edin.
value.AURORA_STRENGTH.1=Yumuşak
value.AURORA_STRENGTH.2=Standart
value.AURORA_STRENGTH.3=Parlayan
option.AURORA_QUALITY=Aurora Quality
option.AURORA_QUALITY.comment=Raymarch steps for Aurora Borealis. Higher settings smooth curtain volume and reduce visible layering; the new centered sampling removes per-pixel grain.
value.AURORA_QUALITY.1=Soft (8 steps)
value.AURORA_QUALITY.2=Balanced (12 steps)
value.AURORA_QUALITY.3=Silky (18 steps)
option.NEBULA_BRIGHTNESS=Samanyolu Parlaklığı
option.NEBULA_BRIGHTNESS.comment=Geceleri diyagonal kahverengimsi galaktik bulutsunun parıltı parlaklığını ayarlayın.
value.NEBULA_BRIGHTNESS.1=Sönük
value.NEBULA_BRIGHTNESS.2=Standart
value.NEBULA_BRIGHTNESS.3=Parlak
option.STARS_BRIGHTNESS=Yıldız Parlaklığı
option.STARS_BRIGHTNESS.comment=Geceleri yıldızların parlaklığını ve pırıltılı ışıltısını kontrol edin.
value.STARS_BRIGHTNESS.1=Soluk
value.STARS_BRIGHTNESS.2=Standart
value.STARS_BRIGHTNESS.3=Muhteşem
option.STARS_AMOUNT=Yıldız Yoğunluğu
option.STARS_AMOUNT.comment=Gökyüzündeki yıldızların genel miktarını ve yoğunluğunu kontrol edin.
value.STARS_AMOUNT.1=Az
value.STARS_AMOUNT.2=Standart
value.STARS_AMOUNT.3=Yoğun
option.RAINBOW_STRENGTH=Gökkuşağı Yoğunluğu
option.RAINBOW_STRENGTH.comment=Yağmur sonrası gökkuşağının parlaklığını ve renk doygunluğunu yapılandırın.
value.RAINBOW_STRENGTH.1=Hafif
value.RAINBOW_STRENGTH.2=Dengeli
value.RAINBOW_STRENGTH.3=Canlı
option.COZY_LIGHTS=Meşale Titremesi
option.COZY_LIGHTS.comment=Meşaleler, kamp ateşleri ve fenerler için sıcak, samimi, gerçek zamanlı titreme animasyonlarını etkinleştirin.
option.WET_REFLECTIONS=Yağmur Islaklığı Yansımaları
option.WET_REFLECTIONS.comment=Yağmur yağarken, zemin, çim ve taş gibi katı bloklar gökyüzü altında ıslak, koyu ve parlak hale gelir.
option.GROUND_MIST=Alçak Zemin Sisi (Y=62-66)
option.GROUND_MIST.comment=Şafak ve alacakaranlıkta su ve buzun üzerinde kayan yumuşak, altın-beyaz sabah/akşam sis tabakalarını etkinleştirin.
option.FOG_DENSITY_LEVEL=Sis Yoğunluğu
option.FOG_DENSITY_LEVEL.comment=Atmosferik ufuk sisinin gücünü kontrol edin.
value.FOG_DENSITY_LEVEL.1=Düşük
value.FOG_DENSITY_LEVEL.2=Orta
value.FOG_DENSITY_LEVEL.3=Yüksek

option.TAA=Zamansal Kenar Yumuşatma (TAA)
option.TAA.comment=Hareket yeniden projeksiyonu ve komşuluk kırpma ile zamansal çözümleme. Yüksek ön ayarlarda titremeyi ve pürüzlü kenarları azaltır.
option.TAA_STRENGTH=TAA Gücü
option.TAA_STRENGTH.comment=Geçmiş karışımını kontrol eder. Daha yüksek değer daha kararlıdır ancak hareket sırasında daha yumuşak olabilir.
value.TAA_STRENGTH.1=Hafif
value.TAA_STRENGTH.2=Dengeli
value.TAA_STRENGTH.3=Kararlı

option.TAA_JITTER=Kamera titremesi (TAA)
option.TAA_JITTER.comment=TAA'nın alt piksel detayları yeniden oluşturmasını sağlayan alt piksel Halton kamera titremesi. Tamamen sabit bir görüntü için varsayılan olarak kapalı; İnce ve üzeri yüksek frekanslı titreşimi hafif zamansal sallanma pahasına giderir. TAA'nın açık olmasını gerektirir.
value.TAA_JITTER.0=Kapalı
value.TAA_JITTER.1=İnce
value.TAA_JITTER.2=Standart
value.TAA_JITTER.3=Güçlü
option.WATER_RIFFLES=Su Dalgacığı Gücü
option.WATER_RIFFLES.comment=Su üzerindeki ince normal map dalgacıklarının yoğunluğunu ayarlar.
value.WATER_RIFFLES.1=Sakin
value.WATER_RIFFLES.2=Standart
value.WATER_RIFFLES.3=Çırpıntılı
option.WATER_SPECULAR_STRENGTH=Su Speküler Parıltısı
option.WATER_SPECULAR_STRENGTH.comment=Su dalgacıklarındaki güneş/ay yansımalarının parlaklığını ayarlar.
value.WATER_SPECULAR_STRENGTH.1=Yumuşak
value.WATER_SPECULAR_STRENGTH.2=Standart
value.WATER_SPECULAR_STRENGTH.3=Parıldayan
option.SHADOW_SOFTNESS=Gölge Yumuşaklığı
option.SHADOW_SOFTNESS.comment=Gölge kenarlarının ne kadar yumuşak ve dağınık göründüğünü kontrol eder. Pürüzsüz yarı gölge için döndürülmüş Poisson diski filtrelemesi kullanır.
value.SHADOW_SOFTNESS.1=Keskin
value.SHADOW_SOFTNESS.2=Yumuşak
value.SHADOW_SOFTNESS.3=Ultra Yumuşak

option.SSAO=SSAO / SAO Tıkanıklığı
option.SSAO.comment=Aşırı profil: köşelerde, blokların altında ve geometri kesişimlerinde temas gölgeleri için ekran alanı ortam gölgelemesi.
option.SSAO_STRENGTH=SSAO Gücü
option.SSAO_STRENGTH.comment=Ekran uzayı ortam tıkanıklığının derinliğini kontrol eder. Yalnızca SSAO etkinleştirildiğinde aktiftir.
value.SSAO_STRENGTH.1=Hafif
value.SSAO_STRENGTH.2=Dengeli
value.SSAO_STRENGTH.3=Derin

option.CLOUD_DISTANCE=Bulut Render Mesafesi
option.CLOUD_DISTANCE.comment=Hacimsel bulutlar için maksimum çizim mesafesi. Kalite profilleri bunu otomatik olarak artırır.

option.CLOUD_SHADOWS=Bulut Gölgeleri
option.CLOUD_SHADOWS.comment=Hacimsel bulut yoğunluğundan gelen saydam prosedürel gölgeleri araziye ekler. Kalite profilleri tarafından dengelenir.
option.CLOUD_SHADOW_STRENGTH=Bulut Gölgesi Gücü
option.CLOUD_SHADOW_STRENGTH.comment=Saydam bulut gölgelerinin ne kadar görünür ve etkileyici olduğunu kontrol eder.
value.CLOUD_SHADOW_STRENGTH.1=Yumuşak
value.CLOUD_SHADOW_STRENGTH.2=Dengeli
value.CLOUD_SHADOW_STRENGTH.3=Dramatik

option.GODRAYS=Godrays / Güneş Işınları
option.GODRAYS.comment=Adds realistic screen-space sun shafts through sky gaps and behind geometry.
option.GODRAYS_QUALITY=Godrays Kalitesi
option.GODRAYS_QUALITY.comment=Controls sample count and cost of godrays.
value.GODRAYS_QUALITY.1=Hızlı
value.GODRAYS_QUALITY.2=Dengeli
value.GODRAYS_QUALITY.3=Yüksek

# ==============================================================================
# Sun and Moon (extended lighting)
# ==============================================================================
screen.SUN_MOON=Güneş ve Ay
screen.SUN_MOON.comment=Güneş ve ay yoğunluğunu, renk sıcaklığını ve atmosferik efektleri ince ayar yapın.
option.SUN_INTENSITY=Güneş Yoğunluğu
option.SUN_INTENSITY.comment=Doğrudan güneş ışığının ana parlaklığı. Daha yüksek = daha güçlü gündüz kontrastı.
value.SUN_INTENSITY.1=Sönük
value.SUN_INTENSITY.2=Standart
value.SUN_INTENSITY.3=Parlak
value.SUN_INTENSITY.4=Kavurucu
option.MOON_INTENSITY=Ay Yoğunluğu
option.MOON_INTENSITY.comment=Ay ışığının ana parlaklığı. Daha yüksek = daha parlak, daha görünür geceler.
value.MOON_INTENSITY.1=Zifiri Gece
value.MOON_INTENSITY.2=Standart
value.MOON_INTENSITY.3=Parlak Ay
value.MOON_INTENSITY.4=Tam Gece
option.SUN_TEMPERATURE=Güneş Renk Sıcaklığı
option.SUN_TEMPERATURE.comment=Güneşin Kelvin eğrisini kaydırır. Gerçekçi, Tanner Helland kara cismini kullanır; sıcak = altın; soğuk = nötr beyaz.
value.SUN_TEMPERATURE.1=Serin / Nötr
value.SUN_TEMPERATURE.2=Gerçekçi
value.SUN_TEMPERATURE.3=Sıcak Altın
option.MOON_TEMPERATURE=Ay Renk Sıcaklığı
option.MOON_TEMPERATURE.comment=Ay ışığının tonu. Buzlu = mavimsi soğuk; Gümüş = gerçekçi 4100K; Sıcak = hasat ayı kreması.
value.MOON_TEMPERATURE.1=Buzul Mavisi
value.MOON_TEMPERATURE.2=Gümüş (Gerçekçi)
value.MOON_TEMPERATURE.3=Sıcak Krem
option.SUN_HALO=Güneş Halesi (Mie Saçılması)
option.SUN_HALO.comment=Güneşe yakın bakıldığında arazide yumuşak sıcak bir parıltı ekler (Mie ileri saçılması).
option.SUNRISE_GLOW=Gelişmiş Gün Doğumu/Batımı Parıltısı
option.SUNRISE_GLOW.comment=Alçak güneşten uzağa bakan yüzeyleri saran daha güçlü sıcak geri saçılımı etkinleştirir.

# ==============================================================================
# Extended shadow settings
# ==============================================================================
option.shadowDistance=Gölge Mesafesi
option.shadowDistance.comment=Dinamik gölgelerin işlendiği maksimum mesafe. Daha yüksek değerler gölgeleri render mesafesine kadar genişletir; genişletilmiş aralıklarda performansı korumak için Shadow LOD kullanın.
value.shadowDistance.60.0=Yakın (60m)
value.shadowDistance.80.0=Standart (80m)
value.shadowDistance.120.0=Uzak (120m)
value.shadowDistance.160.0=Ultra (160 m)
value.shadowDistance.256.0=Genişletilmiş (256 m)
value.shadowDistance.384.0=Render mesafesi (384 m)
value.shadowDistance.192.0=DH Seam (192m)
value.shadowDistance.512.0=DH Extended (512m)
value.shadowDistance.768.0=DH Far (768m)

option.SHADOW_LOD=Gölge LOD
option.SHADOW_LOD.comment=Gölgelerin mesafeyle bozulmasını kontrol eder. Genişletilmiş gölge mesafesinde (256-384 m), LOD performansı korumak için örnek sayısını azaltır ve uzaktaki filtre yarıçapını artırır. Kapalı = tek tip kalite (yavaş). Dengeli = mesafenin %25-50'sinde azaltma. Agresif = mesafenin %15-60'ında maksimum azaltma. Gölgeler, render mesafesinin %95'inden sonra tamamen atlanır.
value.SHADOW_LOD.0=Kapalı (tek tip kalite)
value.SHADOW_LOD.1=Dengeli
value.SHADOW_LOD.2=Agresif
option.DH_SHADOW_RANGE=Distant Horizons Shadow Range
option.DH_SHADOW_RANGE.comment=Maximum range where Distant Horizons LOD terrain and water can receive samples from the shared DH shadow map. Seam keeps shadows close to vanilla chunks; Far extends coverage but can cost more GPU time. No effect without Distant Horizons.
value.DH_SHADOW_RANGE.1=Seam (1.25x)
value.DH_SHADOW_RANGE.2=Extended (2x)
value.DH_SHADOW_RANGE.3=Far (4x)
option.SHADOW_PCSS_BLUR=PCSS mesafe bulanıklığı
option.SHADOW_PCSS_BLUR.comment=Mesafe ve yağmur sırasında gölge bulanıklığını artıran PCSS yarı gölge yumuşatmayı etkinleştirir. Sabit yumuşaklık için devre dışı bırakın (uzak gölgeler daha keskin, daha az gerçekçi).
value.SHADOW_PCSS_BLUR.0=Kapalı (sabit yumuşaklık)
value.SHADOW_PCSS_BLUR.1=Açık (PCSS yarı gölge)

option.AMBIENT_BRIGHTNESS=Gölge Kaldırma / Ortam
option.AMBIENT_BRIGHTNESS.comment=Geceleri ve mağaralarda gölgeli alanların ne kadar karanlık göründüğünü kontrol eder.
value.AMBIENT_BRIGHTNESS.1=Karanlık
value.AMBIENT_BRIGHTNESS.2=Standart
value.AMBIENT_BRIGHTNESS.3=Yükseltilmiş (Parlak)
option.SHADOW_TINT=Gölge Tonu
option.SHADOW_TINT.comment=Gündüz gölgelerini tonlar. Gerçek dünyadaki gölgeler mavi gökyüzü altında hafif soğuk bir tona sahiptir.
value.SHADOW_TINT.1=Nötr Gri
value.SHADOW_TINT.2=Serin Mavi (Gerçekçi)
value.SHADOW_TINT.3=Sıcak
option.LIGHT_WRAP=Işık Sarma
option.LIGHT_WRAP.comment=Aydınlatılmış ve aydınlatılmamış yüzeyler arasındaki terminatörü yumuşatır. Gerçekçi = fiziksel Lambert; Yumuşak = ekran görüntüleri için hoş.
value.LIGHT_WRAP.1=Gerçekçi (Lambert)
value.LIGHT_WRAP.2=Yumuşak Sarma
value.LIGHT_WRAP.3=Stilize

