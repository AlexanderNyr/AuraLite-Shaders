# ==============================================================================
# Quality Profiles
# ==============================================================================
profile.VERY_LOW=נמוך מאוד
profile.VERY_LOW.comment=FPS מקסימלי מוחלט. כל התוספות כבויות: ללא צללים, עננים, PBR, SSR, קרני אור. רק עיבוד מינימלי.
profile.LOW=נמוך
profile.MED=בינוני
profile.HIGH=גבוה
profile.ULTRA=אולטרה
profile.EXTREME=קיצוני
profile.EXTREME.comment=קולנועי מקסימלי. הכל במקסימום: PBR טווח בלתי מוגבל, מיפוי גוונים צילומי (AgX), SSAO העמוק ביותר, סופות מטאורים.
profile.CUSTOM=מותאם אישית
profile.CUSTOM.comment=הגדרות מותאמות אישית ששונו על ידי המשתמש.
profile.HIGH.comment=איכות לחובבים. צללים 2048, SSR מאוזן, TAA, SSAO עדין, קרניים מאוזנות, SMAA.
profile.LOW.comment=קל אך שמיש. שומר על אנימציית עלווה/מים, כוכבים בהירים יותר, FXAA, וינייט. ללא צללים, עננים או PBR.
profile.MED.comment=נקודת המתיקות היומיומית. צללים 1024, עננים, PBR, SSR מהיר, קרני אור, SSS עלווה, השתקפויות רטובות, ערפל, כוכבים נופלים.
profile.ULTRA.comment=High-end. צללים 4096, SSR גבוה, SSAO מאוזן, קרניים גבוהות, TAA יציב, כל האפקטים פועלים.

screen.TRANSLATION_NOTICE=⚠ התרגומים עשויים להכיל שגיאות
screen.TRANSLATION_NOTICE.comment=מחרוזות תרגום מסוימות עשויות להיות לא מדויקות. אם משהו נראה מוזר, השווה למקור באנגלית.

# Screens
screen.LIGHTING=הגדרות תאורה
screen.LIGHTING.comment=הגדר צללים, צבעי אור ובהירות.
screen.FOLIAGE=הגדרות צמחייה
screen.FOLIAGE.comment=הגדר אנימציות נדנוד לעשב ולעלים.
screen.WATER=הגדרות מים
screen.WATER.comment=הגדר גלים, שקיפות וסגנון מים.
screen.CLOUDS_MENU=שמיים ועננים
screen.CLOUDS_MENU.comment=הגדר את הגובה הפיזי, העובי והסגנון של עננים תלת-ממדיים ואפקטי שמיים.
screen.POST_PROCESS=עיבוד אחר וערפל
screen.POST_PROCESS.comment=הגדר חשיפה, ערפל ואפקטים קולנועיים.
screen.POST_FOG=Fog & Image
screen.POST_FOG.comment=Fog density, ground mist, heat shimmer and dithering.

# Options
option.SHADOWS=צללים דינמיים
option.SHADOWS.comment=אפשר או בטל צללים דינמיים רכים מהשמש והירח.
option.shadowMapResolution=רזולוציית צל
option.shadowMapResolution.comment=שנה את איכות מפת הצל. ערכים גבוהים יותר עלולים להוריד את הביצועים.
option.PBR_LIGHTING=תאורת PBR (LabPBR)
option.PBR_LIGHTING.comment=אפשר עיבוד מבוסס פיזיקה עבור מתכות, חספוס ומפות נורמל תלת-ממדיות (נדרשת חבילת משאבי PBR).
option.PBR_POM=תבליט בלוק תלת-ממדי (POM)
option.PBR_POM.comment=אפשר מיפוי חסימת פרלקס מבוסס פיזיקה עבור טקסטורות בלוק תלת-ממדיות. מומלץ לבטל בחבילות משאבים לא תואמות.
option.PBR_STRENGTH=עוצמת PBR
option.PBR_STRENGTH.comment=שלוט ברפלקטיביות ובברק של משטחים מתכתיים PBR.
value.PBR_STRENGTH.1=עדין
value.PBR_STRENGTH.2=סטנדרטי
value.PBR_STRENGTH.3=מראה
option.LIGHTMAP_WARMTH=חום הלפיד
option.LIGHTMAP_WARMTH.comment=התאם את החום והצבע של אור בלוק/לפיד.
value.LIGHTMAP_WARMTH.1=נעים
value.LIGHTMAP_WARMTH.2=חם
value.LIGHTMAP_WARMTH.3=אינטנסיבי
option.WAVING_LEAVES=עלים מתנדנדים
option.WAVING_LEAVES.comment=אפשר אנימציות נדנוד עדינות לעלי עצים.
option.WAVING_GRASS=צמחייה מתנדנדת
option.WAVING_GRASS.comment=אפשר אנימציות נדנוד לעשב, פרחים ויבולים.
option.WIND_SPEED=מהירות רוח
option.WIND_SPEED.comment=שלוט במהירות הנדנוד של עלים, צמחים וגלי מים.
value.WIND_SPEED.1=עדין
value.WIND_SPEED.2=משב
value.WIND_SPEED.3=סערה
option.WATER_WAVES=גלי מים
option.WATER_WAVES.comment=מפעיל גלים גיאומטריים תלת-ממדיים על פני המים.
option.WATER_TRANSPARENCY=צפיפות מים
option.WATER_TRANSPARENCY.comment=שולט בשקיפות ובאטימות של המים.
value.WATER_TRANSPARENCY.1=צלול
value.WATER_TRANSPARENCY.2=מאוזן
value.WATER_TRANSPARENCY.3=עמוק
option.PROCEDURAL_CLOUDS=עננים תלת-ממדיים ווליומטריים
option.PROCEDURAL_CLOUDS.comment=אפשר עננים תלת-ממדיים בני טיסה פיזית שניתן להגיע אליהם ולטוס דרכם.
option.CLOUD_HEIGHT=גובה ענן
option.CLOUD_HEIGHT.comment=הגדר את הגובה הפיזי (רמת Y) של שכבת העננים בעולם (במטרים).
option.CLOUD_THICKNESS=עובי ענן
option.CLOUD_THICKNESS.comment=הגדר את העובי האנכי והנפח של העננים.
option.AURORA_MODE=זוהר צפוני
option.AURORA_MODE.comment=שלוט בתצוגה של זוהר צפוני זורם ריאליסטי בשמי הלילה.
value.AURORA_MODE.0=מושבת
value.AURORA_MODE.1=רק בביומות קרים
value.AURORA_MODE.2=תמיד מופעל
option.AURORA_SPEED=מהירות זוהר
option.AURORA_SPEED.comment=שלוט במהירות הנדנוד והזרימה של האורות הצפוניים.
value.AURORA_SPEED.1=איטי
value.AURORA_SPEED.2=סטנדרטי
value.AURORA_SPEED.3=מהיר
option.AURORA_STRENGTH=בהירות זוהר
option.AURORA_STRENGTH.comment=שלוט בבהירות הזוהר הכוללת של האורות הצפוניים.
value.AURORA_STRENGTH.1=רך
value.AURORA_STRENGTH.2=סטנדרטי
value.AURORA_STRENGTH.3=זוהר
option.AURORA_QUALITY=Aurora Quality
option.AURORA_QUALITY.comment=Raymarch steps for Aurora Borealis. Higher settings smooth curtain volume and reduce visible layering; the new centered sampling removes per-pixel grain.
value.AURORA_QUALITY.1=Soft (8 steps)
value.AURORA_QUALITY.2=Balanced (12 steps)
value.AURORA_QUALITY.3=Silky (18 steps)
option.NEBULA_BRIGHTNESS=בהירות שביל החלב
option.NEBULA_BRIGHTNESS.comment=התאם את בהירות הזוהר של הערפילית הגלקטית האלכסונית החומה בלילה.
value.NEBULA_BRIGHTNESS.1=עמום
value.NEBULA_BRIGHTNESS.2=סטנדרטי
value.NEBULA_BRIGHTNESS.3=בהיר
option.STARS_BRIGHTNESS=בהירות כוכבים
option.STARS_BRIGHTNESS.comment=שלוט בבהירות ובברק הנוצץ של הכוכבים בלילה.
value.STARS_BRIGHTNESS.1=חלש
value.STARS_BRIGHTNESS.2=סטנדרטי
value.STARS_BRIGHTNESS.3=מבריק
option.STARS_AMOUNT=צפיפות כוכבים
option.STARS_AMOUNT.comment=שלוט בכמות הכוללת ובצפיפות הכוכבים בשמיים.
value.STARS_AMOUNT.1=מעט
value.STARS_AMOUNT.2=סטנדרטי
value.STARS_AMOUNT.3=צפוף
option.RAINBOW_STRENGTH=עוצמת קשת
option.RAINBOW_STRENGTH.comment=הגדר את הבהירות ורוויית הצבע של הקשת שלאחר הגשם.
value.RAINBOW_STRENGTH.1=עדין
value.RAINBOW_STRENGTH.2=מאוזן
value.RAINBOW_STRENGTH.3=עז
option.COZY_LIGHTS=הבהוב לפיד
option.COZY_LIGHTS.comment=אפשר אנימציות הבהוב חמות ונעימות בזמן אמת ללפידים, מדורות ופנסים.
option.WET_REFLECTIONS=השתקפויות רטיבות גשם
option.WET_REFLECTIONS.comment=כשיורד גשם, בלוקים מוצקים כמו קרקע, עשב ואבן הופכים רטובים, כהים ומבריקים תחת השמיים.
option.GROUND_MIST=ערפל קרקע נמוך (Y=62-66)
option.GROUND_MIST.comment=אפשר שכבות ערפל בוקר/ערב רכות בגוון זהב-לבן המחליקות מעל מים וקרח בשחר ובדמדומים.
option.FOG_DENSITY_LEVEL=צפיפות ערפל
option.FOG_DENSITY_LEVEL.comment=שלוט בעוצמת ערפל האופק האטמוספרי.
value.FOG_DENSITY_LEVEL.1=נמוך
value.FOG_DENSITY_LEVEL.2=בינוני
value.FOG_DENSITY_LEVEL.3=גבוה

option.TAA=החלקת קצוות זמנית (TAA)
option.TAA.comment=פתרון זמני עם הקרנה מחדש של תנועה וחיתוך שכונתי. מפחית ריצוד וקצוות משוננים בהגדרות מוקדמות גבוהות.
option.TAA_STRENGTH=עוצמת TAA
option.TAA_STRENGTH.comment=שולט במיזוג ההיסטוריה. גבוה יותר יציב יותר אך יכול להיות רך יותר במהלך תנועה.
value.TAA_STRENGTH.1=קליל
value.TAA_STRENGTH.2=מאוזן
value.TAA_STRENGTH.3=יציב

option.TAA_JITTER=רעידת מצלמה (TAA)
option.TAA_JITTER.comment=רעידת מצלמה תת-פיקסלית (Halton) המאפשרת ל-TAA לשחזר פרטים תת-פיקסליים. כבוי כברירת מחדל לתמונה יציבה לחלוטין; עדין ומעלה מסיר הבהוב בתדר גבוה במחיר תנודה זמנית קלה. דורש TAA מופעל.
value.TAA_JITTER.0=כבוי
value.TAA_JITTER.1=עדין
value.TAA_JITTER.2=רגיל
value.TAA_JITTER.3=חזק
option.WATER_RIFFLES=עוצמת אדוות מים
option.WATER_RIFFLES.comment=מתאים את עוצמת האדוות העדינות של מפת הנורמלים על המים.
value.WATER_RIFFLES.1=רגוע
value.WATER_RIFFLES.2=סטנדרטי
value.WATER_RIFFLES.3=סוער
option.WATER_SPECULAR_STRENGTH=זוהר ספקולרי של מים
option.WATER_SPECULAR_STRENGTH.comment=מתאים את הבהירות של השתקפויות השמש/הירח על אדוות המים.
value.WATER_SPECULAR_STRENGTH.1=רך
value.WATER_SPECULAR_STRENGTH.2=סטנדרטי
value.WATER_SPECULAR_STRENGTH.3=נוצץ
option.SHADOW_SOFTNESS=רכות צל
option.SHADOW_SOFTNESS.comment=שולט עד כמה רכים ומפוזרים נראים קצוות הצל. משתמש בסינון דיסק פואסון מסובב לחצי-צל חלק.
value.SHADOW_SOFTNESS.1=חד
value.SHADOW_SOFTNESS.2=רך
value.SHADOW_SOFTNESS.3=רך במיוחד

option.SSAO=חסימת SSAO / SAO
option.SSAO.comment=פרופיל קיצוני: חסימה היקפית במרחב המסך לצללי מגע בפינות, מתחת לקוביות ובמפגשי גאומטריה.
option.SSAO_STRENGTH=עוצמת SSAO
option.SSAO_STRENGTH.comment=שולט בעומק חסימת הסביבה במרחב המסך. פעיל רק כאשר SSAO מופעל.
value.SSAO_STRENGTH.1=עדין
value.SSAO_STRENGTH.2=מאוזן
value.SSAO_STRENGTH.3=עמוק

option.CLOUD_DISTANCE=מרחק עיבוד עננים
option.CLOUD_DISTANCE.comment=מרחק ציור מרבי לעננים ווליומטריים. פרופילי איכות מגדילים אותו אוטומטית.

option.CLOUD_SHADOWS=צללי עננים
option.CLOUD_SHADOWS.comment=מוסיף צללים פרוצדורליים שקופים מצפיפות עננים ווליומטריים על השטח. מאוזן על ידי פרופילי איכות.
option.CLOUD_SHADOW_STRENGTH=עוצמת צל עננים
option.CLOUD_SHADOW_STRENGTH.comment=שולט עד כמה נראים ודרמטיים צללי העננים השקופים.
value.CLOUD_SHADOW_STRENGTH.1=רך
value.CLOUD_SHADOW_STRENGTH.2=מאוזן
value.CLOUD_SHADOW_STRENGTH.3=דרמטי

option.GODRAYS=קרני שמש (Godrays)
option.GODRAYS.comment=Adds realistic screen-space sun shafts through sky gaps and behind geometry.
option.GODRAYS_QUALITY=איכות Godrays
option.GODRAYS_QUALITY.comment=Controls sample count and cost of godrays.
value.GODRAYS_QUALITY.1=מהיר
value.GODRAYS_QUALITY.2=מאוזן
value.GODRAYS_QUALITY.3=גבוה

# ==============================================================================
# Sun and Moon (extended lighting)
# ==============================================================================
screen.SUN_MOON=שמש וירח
screen.SUN_MOON.comment=כוונן במדויק את עוצמת השמש והירח, טמפרטורת הצבע והאפקטים האטמוספריים.
option.SUN_INTENSITY=עוצמת שמש
option.SUN_INTENSITY.comment=בהירות ראשית של אור שמש ישיר. גבוה יותר = ניגודיות יום חזקה יותר.
value.SUN_INTENSITY.1=עמום
value.SUN_INTENSITY.2=סטנדרטי
value.SUN_INTENSITY.3=גבוה
value.SUN_INTENSITY.4=לוהט
option.MOON_INTENSITY=עוצמת ירח
option.MOON_INTENSITY.comment=בהירות ראשית של אור הירח. גבוה יותר = לילות בהירים וגלויים יותר.
value.MOON_INTENSITY.1=לילה שחור
value.MOON_INTENSITY.2=סטנדרטי
value.MOON_INTENSITY.3=ירח בהיר
value.MOON_INTENSITY.4=לילה מלא
option.SUN_TEMPERATURE=טמפרטורת צבע השמש
option.SUN_TEMPERATURE.comment=מזיז את עקומת קלווין של השמש. ריאליסטי משתמש בגוף שחור של טאנר הלנד; חם = זהוב; קריר = לבן ניטרלי.
value.SUN_TEMPERATURE.1=קריר / ניטרלי
value.SUN_TEMPERATURE.2=ריאליסטי
value.SUN_TEMPERATURE.3=זהב חם
option.MOON_TEMPERATURE=טמפרטורת צבע הירח
option.MOON_TEMPERATURE.comment=גוון אור הירח. קפוא = כחלחל קר; כסוף = ריאליסטי 4100K; חם = קרם ירח קציר.
value.MOON_TEMPERATURE.1=כחול קפוא
value.MOON_TEMPERATURE.2=כסוף (ריאליסטי)
value.MOON_TEMPERATURE.3=קרם חם
option.SUN_HALO=הילת שמש (פיזור מי)
option.SUN_HALO.comment=מוסיף זוהר חמים ורך על השטח כאשר מסתכלים ליד השמש (פיזור מי קדימה).
option.SUNRISE_GLOW=זוהר זריחה/שקיעה משופר
option.SUNRISE_GLOW.comment=מאפשר פיזור אחורי חם וחזק יותר העוטף משטחים הפונים הרחק מהשמש הנמוכה.

# ==============================================================================
# Extended shadow settings
# ==============================================================================
option.shadowDistance=מרחק צל
option.shadowDistance.comment=המרחק המקסימלי שבו צללים דינמיים מעובדים. ערכים גבוהים יותר מרחיבים את הצללים למרחק העיבוד; השתמש ב-Shadow LOD כדי לשמור על ביצועים בטווחים מורחבים.
value.shadowDistance.60.0=קרוב (60מ')
value.shadowDistance.80.0=סטנדרטי (80מ')
value.shadowDistance.120.0=רחוק (120מ')
value.shadowDistance.160.0=אולטרה (160מ')
value.shadowDistance.256.0=מורחב (256 מ')
value.shadowDistance.384.0=מרחק עיבוד (384 מ')
value.shadowDistance.192.0=DH Seam (192m)
value.shadowDistance.512.0=DH Extended (512m)
value.shadowDistance.768.0=DH Far (768m)

option.SHADOW_LOD=LOD צללים
option.SHADOW_LOD.comment=שולט בהידרדרות איכות הצללים עם המרחק. עם מרחק צל מורחב (256-384 מ'), LOD מקטין את מספר הדגימות ומגדיל את רדיוס המסנן במרחק כדי לשמור על ביצועים. כבוי = איכות אחידה (איטי). מאוזן = הפחתה ב-25-50% מהמרחק. אגרסיבי = הפחתה מקסימלית ב-15-60% מהמרחק. צללים מודלגים לחלוטין מעבר ל-95% ממרחק העיבוד.
value.SHADOW_LOD.0=כבוי (איכות אחידה)
value.SHADOW_LOD.1=מאוזן
value.SHADOW_LOD.2=אגרסיבי
option.DH_SHADOW_RANGE=Distant Horizons Shadow Range
option.DH_SHADOW_RANGE.comment=Maximum range where Distant Horizons LOD terrain and water can receive samples from the shared DH shadow map. Seam keeps shadows close to vanilla chunks; Far extends coverage but can cost more GPU time. No effect without Distant Horizons.
value.DH_SHADOW_RANGE.1=Seam (1.25x)
value.DH_SHADOW_RANGE.2=Extended (2x)
value.DH_SHADOW_RANGE.3=Far (4x)
option.SHADOW_PCSS_BLUR=טשטוש PCSS לפי מרחק
option.SHADOW_PCSS_BLUR.comment=מאפשר ריכוך PCSS penumbra שמגביר את טשטוש הצללים עם המרחק ובגשם. כבה לרכות קבועה (צללים רחוקים חדים יותר, פחות ריאליסטיים).
value.SHADOW_PCSS_BLUR.0=כבוי (רכות קבועה)
value.SHADOW_PCSS_BLUR.1=מופעל (PCSS penumbra)

option.AMBIENT_BRIGHTNESS=הרמת צל / סביבתי
option.AMBIENT_BRIGHTNESS.comment=שולט עד כמה כהים נראים אזורים מוצללים בלילה ובמערות.
value.AMBIENT_BRIGHTNESS.1=כהה
