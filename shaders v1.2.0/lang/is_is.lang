# ==============================================================================
# Quality Profiles
# ==============================================================================
profile.VERY_LOW=Mjög Lágt
profile.VERY_LOW.comment=Algjört FPS hámark. Allt aukaflutt slökkt: engar skuggar, engin ský, ekkert PBR, ekkert SSR, engar ljósgeislar. Aðeins lágmarksrendering.
profile.LOW=Lágt
profile.LOW.comment=Létt en spilanlegt. Heldur laufblaða/vatns hreyfimyndum, bjartari stjörnum, FXAA, myndramma. Engar skuggar, ský eða PBR.
profile.MED=Miðlungs
profile.MED.comment=Daglegt sætt punkt. Skuggar 1024, ský, PBR, SSR Fljótur, ljósgeislar, laufblaða SSS, blautar endurkast, þoka, stjörnuhröp.
profile.HIGH=Hátt
profile.HIGH.comment=Áhugamanneskjuk gæði. Skuggar 2048, SSR Jafnvægi, TAA, SSAO Fín, ljósgeislar Jafnvægi, SMAA.
profile.ULTRA=Ultra
profile.ULTRA.comment=Hágæða. Skuggar 4096, SSR Hátt, SSAO Jafnvægi, ljósgeislar Hátt, TAA Stöðugt, allir áhrif virk.
profile.EXTREME=Öfgafullt
profile.EXTREME.comment=Kvikmyndalegt hámark. Allt á hámarki: PBR Ótakmörkuð svið, ljósmynda tónkortlagning (AgX), dýpsta SSAO, stjörnuhrapsstormar.
profile.CUSTOM=Sérsniðið
profile.CUSTOM.comment=Sérsniðnar stillingar breyttar af notanda.

screen.TRANSLATION_NOTICE=⚠ Þýðingar geta innihaldið villur
screen.TRANSLATION_NOTICE.comment=Sumar staðfærslustrengir gætu verið ónákvæmir. Ef eitthvað lítur skrýtið út, berðu saman við enska frumtextann.

# Screens
screen.LIGHTING=Ljósstillingar
screen.LIGHTING.comment=Stilltu skugga, ljósliti og birtu.

screen.FOLIAGE=Gróðurstillingar
screen.FOLIAGE.comment=Stilltu bylgjuhreyfimyndir fyrir gras og lauf.

screen.WATER=Vatnsstillingar
screen.WATER.comment=Stilltu öldur, gegnsæi og útlit vatns.

screen.CLOUDS_MENU=Himinn og ský
screen.CLOUDS_MENU.comment=Stilltu líkamlega hæð, þykkt og útlit þrívíddarskýja og himináhrifa.

screen.POST_PROCESS=Eftirvinnsla og þoka
screen.POST_PROCESS.comment=Stilltu lýsingu, þoku og kvikmyndaáhrif.
screen.POST_FOG=Fog & Image
screen.POST_FOG.comment=Fog density, ground mist, heat shimmer and dithering.

# Options
option.SHADOWS=Kvikir Skuggar
option.SHADOWS.comment=Virkjaðu eða slökktu á mjúkum kvikum skuggum frá sól og tungli.

option.shadowMapResolution=Skuggaupplausn
option.shadowMapResolution.comment=Breyttu gæðum skuggakorts. Hærri gildi geta lækkað afköst.

option.PBR_LIGHTING=PBR-lýsing (LabPBR)
option.PBR_LIGHTING.comment=Virkjaðu eðlisfræðilega byggða myndgerð fyrir málma, grófleika og 3D venjulega kort (PBR auðlindapakki nauðsynlegur).

option.PBR_POM=3D Blokkarlágmynd (POM)
option.PBR_POM.comment=Virkjaðu eðlisfræðilega byggða Parallax Occlusion Mapping fyrir 3D blokkarmynstur. Mælt er með að slökkva á því á ósamhæfum auðlindapökkum.

option.PBR_STRENGTH=PBR-styrkur
option.PBR_STRENGTH.comment=Stjórnaðu endurspeglun og gljáa PBR málmyfirborða.

value.PBR_STRENGTH.1=Fíngert
value.PBR_STRENGTH.2=Staðlað
value.PBR_STRENGTH.3=Spegill

option.SSAO=SSAO / SAO Byrgir
option.SSAO.comment=Extreme profile: screen-space ambient occlusion for contact shadows in corners, under blocks, and around geometry intersections.
option.SSAO_STRENGTH=SSAO-styrkur
option.SSAO_STRENGTH.comment=Stjórnar dýpt umhverfisbyrgingar í skjárými. Aðeins virkt þegar SSAO er virkt.
value.SSAO_STRENGTH.1=Fíngert
value.SSAO_STRENGTH.2=Jafnvægi
value.SSAO_STRENGTH.3=Djúpt

option.LIGHTMAP_WARMTH=Kyndilhlýja
option.LIGHTMAP_WARMTH.comment=Stilltu hlýju og lit blokkar-/kyndilsljóss.

value.LIGHTMAP_WARMTH.1=Notalegt
value.LIGHTMAP_WARMTH.2=Hlýtt
value.LIGHTMAP_WARMTH.3=Ákaft

option.WAVING_LEAVES=Sveiflandi Lauf
option.WAVING_LEAVES.comment=Virkjaðu mjúkar sveifluhreyfimyndir fyrir trjálauf.

option.WAVING_GRASS=Sveiflandi Gróður
option.WAVING_GRASS.comment=Virkjaðu sveifluhreyfimyndir fyrir gras, blóm og uppskeru.

option.WIND_SPEED=Vindhraði
option.WIND_SPEED.comment=Stjórnaðu sveifluhraða laufa, plantna og vatnsöldu.

value.WIND_SPEED.1=Blítt
value.WIND_SPEED.2=Gola
value.WIND_SPEED.3=Stormur

option.WATER_WAVES=Vatnsöldur
option.WATER_WAVES.comment=Enable 3D geometric waves on the water surface.

option.WATER_TRANSPARENCY=Vatnsþéttleiki
option.WATER_TRANSPARENCY.comment=Control the transparency and opacity of the water.

value.WATER_TRANSPARENCY.1=Tært
value.WATER_TRANSPARENCY.2=Jafnvægi
value.WATER_TRANSPARENCY.3=Djúpt

option.PROCEDURAL_CLOUDS=Rúmfræðileg 3D Ský
option.PROCEDURAL_CLOUDS.comment=Virkjaðu eðlisfræðilega fljúganleg 3D ský sem hægt er að ná og fljúga í gegnum.

option.CLOUD_HEIGHT=Skýjahæð
option.CLOUD_HEIGHT.comment=Stilltu líkamlega hæð (Y-stig) skýjaþilfarsins í heiminum (í metrum).


option.CLOUD_THICKNESS=Skýjaþykkt
option.CLOUD_THICKNESS.comment=Stilltu lóðrétta þykkt og rúmmál skýjanna.


option.CLOUD_DISTANCE=Skýjateiknivegalengd
option.CLOUD_DISTANCE.comment=Hámarks teiknivegalengd fyrir rúmfræðileg ský. Gæðasnið auka hana sjálfkrafa.

option.CLOUD_SHADOWS=Skýjaskuggar
option.CLOUD_SHADOWS.comment=Bætir við gagnsæjum reikniritsskuggum úr rúmfræðilegri skýjaþéttleika á landslag. Jafnvægi með gæðasniðum.
option.CLOUD_SHADOW_STRENGTH=Skýjaskuggastyrkur
option.CLOUD_SHADOW_STRENGTH.comment=Stjórnar hversu sýnilegir og áhrifamiklir gagnsæir skýjaskuggar eru.
value.CLOUD_SHADOW_STRENGTH.1=Mjúkt
value.CLOUD_SHADOW_STRENGTH.2=Jafnvægi
value.CLOUD_SHADOW_STRENGTH.3=Áhrifamikið

option.GODRAYS=Sólargeislar (Godrays)
option.GODRAYS.comment=Adds physically-inspired volumetric single-scattering sun shafts with Beer-Lambert extinction, Mie phase and shadow-map occlusion.
option.GODRAYS_QUALITY=Godrays-gæði
option.GODRAYS_QUALITY.comment=Controls the sample count and integration distance of physically-based volumetric godrays.
value.GODRAYS_QUALITY.1=Hratt
value.GODRAYS_QUALITY.2=Jafnvægi
value.GODRAYS_QUALITY.3=Hátt

option.AURORA_MODE=Norðurljós
option.AURORA_MODE.comment=Stjórnaðu birtingu raunsærra streymandi norðurljósa á næturhimninum.

value.AURORA_MODE.0=Óvirkt
value.AURORA_MODE.1=Aðeins í Köldum Lífbeltum
value.AURORA_MODE.2=Alltaf Virkt

option.AURORA_SPEED=Norðurljósahraði
option.AURORA_SPEED.comment=Stjórnaðu sveiflu- og streymishraða norðurljósanna.

value.AURORA_SPEED.1=Hægt
value.AURORA_SPEED.2=Staðlað
value.AURORA_SPEED.3=Hratt

option.AURORA_STRENGTH=Norðurljósabirtan
option.AURORA_STRENGTH.comment=Stjórnaðu heildarbirtu ljóma norðurljósanna.

value.AURORA_STRENGTH.1=Mjúkt
value.AURORA_STRENGTH.2=Staðlað
value.AURORA_STRENGTH.3=Glóandi

option.AURORA_QUALITY=Aurora Quality
option.AURORA_QUALITY.comment=Raymarch steps for Aurora Borealis. Higher settings smooth curtain volume and reduce visible layering; the new centered sampling removes per-pixel grain.
value.AURORA_QUALITY.1=Soft (8 steps)
value.AURORA_QUALITY.2=Balanced (12 steps)
value.AURORA_QUALITY.3=Silky (18 steps)
option.NEBULA_BRIGHTNESS=Vetrarbrautarbirta
option.NEBULA_BRIGHTNESS.comment=Stilltu ljómabirtu skálæga brúnleita vetrarbrautaþokunnar á nóttunni.

value.NEBULA_BRIGHTNESS.1=Dauft
value.NEBULA_BRIGHTNESS.2=Staðlað
value.NEBULA_BRIGHTNESS.3=Bjart

option.STARS_BRIGHTNESS=Stjörnubirtan
option.STARS_BRIGHTNESS.comment=Stjórnaðu birtu og glitrandi ljóma stjarnanna á nóttunni.

value.STARS_BRIGHTNESS.1=Dauft
value.STARS_BRIGHTNESS.2=Staðlað
value.STARS_BRIGHTNESS.3=Glæsilegt

option.STARS_AMOUNT=Stjörnuþéttleiki
option.STARS_AMOUNT.comment=Stjórnaðu heildarmagni og þéttleika stjarnanna á himninum.

value.STARS_AMOUNT.1=Fáar
value.STARS_AMOUNT.2=Staðlað
value.STARS_AMOUNT.3=Þétt

option.RAINBOW_STRENGTH=Regnbogastyrkur
option.RAINBOW_STRENGTH.comment=Stilltu birtu og litamettun regnbogans eftir rigningu.

value.RAINBOW_STRENGTH.1=Fíngert
value.RAINBOW_STRENGTH.2=Jafnvægi
value.RAINBOW_STRENGTH.3=Líflegt

option.COZY_LIGHTS=Kyndilflökt
option.COZY_LIGHTS.comment=Virkjaðu hlýjar, notalegar, rauntíma flöktandi hreyfimyndir fyrir kyndla, varðelda og luktir.

option.WET_REFLECTIONS=Vætuspeglun Rigningar
option.WET_REFLECTIONS.comment=Þegar rignir verða solid blokkir eins og jörð, gras og steinn blaut, dökk og gljáandi undir himninum.

option.GROUND_MIST=Lág Jarðarþoka (Y=62-66)
option.GROUND_MIST.comment=Virkjaðu mjúk, gyllt-hvít morgun-/kvöldþokulög sem renna yfir vatn og ís í dögun og rökkri.

option.FOG_DENSITY_LEVEL=Þokuþéttleiki
option.FOG_DENSITY_LEVEL.comment=Stjórnaðu styrk andrúmslofts sjóndeildarhringsþoku.

value.FOG_DENSITY_LEVEL.1=Lágt
value.FOG_DENSITY_LEVEL.2=Miðlungs
value.FOG_DENSITY_LEVEL.3=Hátt







option.TAA=Tímabundin Sléttun (TAA)
option.TAA.comment=Tímabundin úrlausn með hreyfingarendurvarpi og nágrannaklippingu. Dregur úr flökti og hrjúfum brúnum á háum forstillingum.
option.TAA_STRENGTH=TAA-styrkur
option.TAA_STRENGTH.comment=Stjórnar sögublöndun. Hærra er stöðugra en getur verið mýkra í hreyfingu.
value.TAA_STRENGTH.1=Létt
value.TAA_STRENGTH.2=Jafnvægi
value.TAA_STRENGTH.3=Stöðugt

option.TAA_JITTER=Myndavélatitringur (TAA)
option.TAA_JITTER.comment=Undirpunktstitringur myndavélar (Halton) sem gerir TAA kleift að endurgera undirpunktaupplýsingar. Slökkt sjálfgefið fyrir fullkomlega stöðuga mynd; Ljúft og hærra fjarlægir hátíðniblikk á kostnað lítils tímabundins vagg. Krefst þess að TAA sé virkt.
value.TAA_JITTER.0=Af
value.TAA_JITTER.1=Ljúft
value.TAA_JITTER.2=Staðlað
value.TAA_JITTER.3=Sterkt


option.WATER_RIFFLES=Vatnsgárustyrkur
option.WATER_RIFFLES.comment=Adjust the waviness and intensity of the fine normal map ripples on the water.

value.WATER_RIFFLES.1=Rólegt
value.WATER_RIFFLES.2=Staðlað
value.WATER_RIFFLES.3=Ólgandi

option.WATER_SPECULAR_STRENGTH=Vatnsglans
option.WATER_SPECULAR_STRENGTH.comment=Adjust the brightness of sun/moon reflections on the water ripples.

value.WATER_SPECULAR_STRENGTH.1=Mjúkt
value.WATER_SPECULAR_STRENGTH.2=Staðlað
value.WATER_SPECULAR_STRENGTH.3=Glansandi

option.SHADOW_SOFTNESS=Skuggamýkt
option.SHADOW_SOFTNESS.comment=Stjórnar hversu mjúkar og dreifðar skuggabrúnirnar birtast. Notar snúið Poisson-diskssíun fyrir slétta hálfskugga.

value.SHADOW_SOFTNESS.1=Skarpt
value.SHADOW_SOFTNESS.2=Mjúkt
value.SHADOW_SOFTNESS.3=Ofurmjúkt

# ==============================================================================
# Sun & Moon Lighting (extended)
# ==============================================================================
screen.SUN_MOON=Sól og tungl
screen.SUN_MOON.comment=Fínstilltu styrkleika sólar og tungls, litahitastig og andrúmsloftsáhrif.

option.SUN_INTENSITY=Sólarstyrkur
option.SUN_INTENSITY.comment=Aðalbirtan á beinu sólarljósi. Hærra = sterkari dagsbirtuskil.
value.SUN_INTENSITY.1=Dempt
value.SUN_INTENSITY.2=Staðlað
value.SUN_INTENSITY.3=Hátt
value.SUN_INTENSITY.4=Brennandi

option.MOON_INTENSITY=Tunglstyrkur
option.MOON_INTENSITY.comment=Aðalbirtan á tunglskini. Hærra = bjartari, sýnilegri nætur.
value.MOON_INTENSITY.1=Kolniðamyrkur
value.MOON_INTENSITY.2=Staðlað
value.MOON_INTENSITY.3=Bjart Tungl
value.MOON_INTENSITY.4=Full Nótt

option.SUN_TEMPERATURE=Litahitastig Sólar
option.SUN_TEMPERATURE.comment=Færir Kelvin-feril sólarinnar. Raunsætt notar Tanner Helland svarthlut; hlýtt = gyllt; svalt = hlutlaust hvítt.
value.SUN_TEMPERATURE.1=Svalt / Hlutlaust
value.SUN_TEMPERATURE.2=Raunsætt
value.SUN_TEMPERATURE.3=Hlýtt Gyllt

option.MOON_TEMPERATURE=Litahitastig Tungls
option.MOON_TEMPERATURE.comment=Litblær tunglskins. Ísköld = bláleit köld; Silfur = raunsætt 4100K; Hlýtt = uppskerutungls rjómi.
value.MOON_TEMPERATURE.1=Ísblátt
value.MOON_TEMPERATURE.2=Silfur (Raunsætt)
value.MOON_TEMPERATURE.3=Hlýr Rjómi

option.SUN_HALO=Sólkringla (Mie-dreifing)
option.SUN_HALO.comment=Bætir við mjúkum hlýjum ljóma á landslag þegar horft er nálægt sólinni (Mie framávirk dreifing).

option.SUNRISE_GLOW=Aukinn Sólarupprás/-lag Ljómi
option.SUNRISE_GLOW.comment=Virkjar sterkari hlýja bakdreifingu sem vefst um fleti sem snúa frá lágri sólinni.

# ==============================================================================
# Extended shadow settings
# ==============================================================================
option.shadowDistance=Skuggavegalengd
option.shadowDistance.comment=Hámarksfjarlægð þar sem dynamískir skuggar eru renderadir. Hærri gildi lengja skugga út í renderingsfjarlægð; notaðu Shadow LOD til að viðhalda afköstum á lengri sviðum.
value.shadowDistance.60.0=Nálægt (60m)
value.shadowDistance.80.0=Staðlað (80m)
value.shadowDistance.120.0=Fjarri (120m)
value.shadowDistance.160.0=Ultra (160 m)
value.shadowDistance.256.0=Lengt (256 m)
value.shadowDistance.384.0=Renderingsfjarlægð (384 m)
value.shadowDistance.192.0=DH Seam (192m)
value.shadowDistance.512.0=DH Extended (512m)
value.shadowDistance.768.0=DH Far (768m)

option.SHADOW_LOD=Skugga LOD
option.SHADOW_LOD.comment=Stýrir skugga gæða rýrnun með fjarlægð. Með útbreiddri skugga fjarlægð (256-384 m) dregur LOD úr sýnafjölda og eykur síunaradius í fjarlægð til að viðhalda afköstum. Slökkt = jöfn gæði (hægt). Jafnvægi = minnkun við 25-50% fjarlægð. Árásargjarn = hámarks minnkun við 15-60% fjarlægð. Skuggar eru alveg slepptir fyrir utan 95% af renderingsfjarlægð.
value.SHADOW_LOD.0=Slökkt (jöfn gæði)
value.SHADOW_LOD.1=Jafnvægi
value.SHADOW_LOD.2=Árásargjarn
option.DH_SHADOW_RANGE=Distant Horizons Shadow Range
option.DH_SHADOW_RANGE.comment=Maximum range where Distant Horizons LOD terrain and water can receive samples from the shared DH shadow map. Seam keeps shadows close to vanilla chunks; Far extends coverage but can cost more GPU time. No effect without Distant Horizons.
value.DH_SHADOW_RANGE.1=Seam (1.25x)
value.DH_SHADOW_RANGE.2=Extended (2x)
value.DH_SHADOW_RANGE.3=Far (4x)
option.SHADOW_PCSS_BLUR=PCSS fjarlægðarþoka
option.SHADOW_PCSS_BLUR.comment=Virkjar PCSS hálfskugga mýkingu sem eykur skugga þoku með fjarlægð og í rigningu. Slökkva fyrir fastan mýkt (skarpari fjarlægir skuggar, minna raunhæft).
value.SHADOW_PCSS_BLUR.0=Slökkt (fastur mýkt)
value.SHADOW_PCSS_BLUR.1=Kveikt (PCSS hálfskuggi)


option.AMBIENT_BRIGHTNESS=Skuggalyfting / Umhverfi
option.AMBIENT_BRIGHTNESS.comment=Stjórnar hversu dökk skuggasvæði birtast á nóttunni og í hellum.
value.AMBIENT_BRIGHTNESS.1=Dökkt
value.AMBIENT_BRIGHTNESS.2=Staðlað
value.AMBIENT_BRIGHTNESS.3=Lyft (Bjart)

option.SHADOW_TINT=Skuggablær
option.SHADOW_TINT.comment=Litar dagsbirtuskugga. Raunverulegir skuggar undir bláum himni hafa lúmskan svalan blæ.
value.SHADOW_TINT.1=Hlutlaus grár
value.SHADOW_TINT.2=Svalur blár (raunsær)
value.SHADOW_TINT.3=Hlýtt

option.LIGHT_WRAP=Ljósvöfun
option.LIGHT_WRAP.comment=Mýkir mörkin milli lýstra og ólýstra flata. Raunsætt = eðlisfræðilegt Lambert; Mjúkt = notalegt fyrir skjámyndir.
value.LIGHT_WRAP.1=Raunsætt (Lambert)
value.LIGHT_WRAP.2=Mjúk Vöfun
value.LIGHT_WRAP.3=Stílfært

