option.SHOOTING_STARS_FREQUENCY.comment=Približná zenitálna hodinová miera. Sporadicky = realistické pozadie ~10 za hodinu. Aktívne = mierny roj. Búrka = vrcholová hustota (~100/h).
value.SHOOTING_STARS_FREQUENCY.1=Sporadicky (~10/h)
value.SHOOTING_STARS_FREQUENCY.2=Aktívny roj
value.SHOOTING_STARS_FREQUENCY.3=Meteorická búrka
option.SHOOTING_STARS_BRIGHTNESS=Škála magnitúdy
option.SHOOTING_STARS_BRIGHTNESS.comment=Hlavný násobiteľ na škále magnitúdy meteoru. Slabé = realistický priemer; Jasné = škáluje ohnivé gule pre filmovú viditeľnosť.
value.SHOOTING_STARS_BRIGHTNESS.1=Slabé (Realistické)
value.SHOOTING_STARS_BRIGHTNESS.2=Štandardná
value.SHOOTING_STARS_BRIGHTNESS.3=Jasné ohnivé gule
option.SPATIAL_AA_MODE=Priestorové vyhladzovanie hrán
option.SPATIAL_AA_MODE.comment=Vyberte metódu vyhladzovania hrán po spracovaní. FXAA je rýchle a lacné. SMAA používa hĺbkový buffer pre lepšiu kvalitu na geometrických hranách. Možno kombinovať s TAA.
value.SPATIAL_AA_MODE.0=Vypnuté
value.SPATIAL_AA_MODE.1=FXAA (Rýchle)
value.SPATIAL_AA_MODE.2=SMAA (Kvalita)
option.HEAT_SHIMMER=Tepelné chvenie nad lávou
option.HEAT_SHIMMER.comment=Zapnite jemný efekt tepelného skreslenia v priestore obrazovky nad povrchmi lávy.
option.HEAT_SHIMMER_STRENGTH=Sila tepelného chvenia
