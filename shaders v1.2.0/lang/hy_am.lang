value.MOON_TEMPERATURE.2=Արծաթ (Իրատեսական)
value.MOON_TEMPERATURE.3=Տաք կրեմ

option.SUN_HALO=Արևի լուսապսակ (Mie ցրում)
option.SUN_HALO.comment=Ավելացնում է փափուկ տաք շող տեղանքի վրա, երբ նայում եք արևի մոտ (Mie առաջընթաց ցրում)։

option.SUNRISE_GLOW=Ուժեղացված արևածագի/մայրամուտի շող
option.SUNRISE_GLOW.comment=Միացնում է ավելի ուժեղ տաք հետընթաց ցրում, որը պարուրում է ցածր արևից շեղված մակերեսները։

# ==============================================================================
# Extended shadow settings
# ==============================================================================
option.shadowDistance=Ստվերների հեռավորություն
option.shadowDistance.comment=Առավելագույն հեռավորությունը, որում վիզուալիզացվում են դինամիկ ստվերները: Ավելի բարձր արժեքները ընդլայնում են ստվերները մինչև վիզուալիզացիոն հեռավորությունը: Օգտագործեք Shadow LOD՝ ընդլայնված միջակայքերում արտադրողականությունը պահպանելու համար:
value.shadowDistance.60.0=Մոտ (60մ)
value.shadowDistance.80.0=Ստանդարտ (80մ)
value.shadowDistance.120.0=Հեռու (120մ)
value.shadowDistance.160.0=Ուլտրա (160մ)
value.shadowDistance.256.0=Ընդլայնված (256 մ)
value.shadowDistance.384.0=Վիզուալիզացիոն հեռավորություն (384 մ)
value.shadowDistance.192.0=DH Seam (192m)
value.shadowDistance.512.0=DH Extended (512m)
value.shadowDistance.768.0=DH Far (768m)

option.SHADOW_LOD=Ստվերների LOD
option.SHADOW_LOD.comment=Կառավարում է ստվերների որակի անկումը ըստ հեռավորության: Ընդլայնված ստվերների հեռավորությամբ (256-384 մ) LOD-ը նվազեցնում է նմուշների քանակը և մեծացնում ֆիլտրի շառավիղը հեռավորության վրա՝ արտադրողականությունը պահպանելու համար: Անջատված = հավասարաչափ որակ (դանդաղ): Հավասարակշռված = նվազեցում 25-50% հեռավորությամբ: Ագրեսիվ = առավելագույն նվազեցում 15-60% հեռավորությամբ: Ստվերները լիովին բաց են թողնվում 95% վիզուալիզացիոն հեռավորությունից ավելի:
value.SHADOW_LOD.0=Անջատված (հավասարաչափ որակ)
value.SHADOW_LOD.1=Հավասարակշռված
value.SHADOW_LOD.2=Ագրեսիվ
option.DH_SHADOW_RANGE=Distant Horizons Shadow Range
option.DH_SHADOW_RANGE.comment=Maximum range where Distant Horizons LOD terrain and water can receive samples from the shared DH shadow map. Seam keeps shadows close to vanilla chunks; Far extends coverage but can cost more GPU time. No effect without Distant Horizons.
value.DH_SHADOW_RANGE.1=Seam (1.25x)
value.DH_SHADOW_RANGE.2=Extended (2x)
value.DH_SHADOW_RANGE.3=Far (4x)
option.SHADOW_PCSS_BLUR=PCSS հեռավորության մշուշ
option.SHADOW_PCSS_BLUR.comment=Միացնում է PCSS կիսաստվերի փափկեցումը, որը մեծացնում է ստվերների մշուշը ըստ հեռավորության և անձրևի ժամանակ: Անջատեք ֆիքսված փափկության համար (ավելի սուր հեռավոր ստվերներ, ավելի քիչ իրատել):
value.SHADOW_PCSS_BLUR.0=Անջատված (ֆիքսված փափկություն)
