value.SPATIAL_AA_MODE.2=SMAA (Որակ)

option.WATER_RIFFLES=Ջրի ալիքների ուժ
option.WATER_RIFFLES.comment=Կարգավորեք ջրի վրա նուրբ նորմալ քարտեզի ալիքների ալիքավորումն ու ինտենսիվությունը։ Չի ազդում սառույցի կամ ապակու վրա։

value.WATER_RIFFLES.1=Հանգիստ
value.WATER_RIFFLES.2=Ստանդարտ
value.WATER_RIFFLES.3=Ալեկոծ

option.WATER_SPECULAR_STRENGTH=Ջրի փայլուն շող
option.WATER_SPECULAR_STRENGTH.comment=Կարգավորեք ջրի ալիքների վրա արևի/լուսնի անդրադարձումների պայծառությունը։

value.WATER_SPECULAR_STRENGTH.1=Փափուկ
value.WATER_SPECULAR_STRENGTH.2=Ստանդարտ
value.WATER_SPECULAR_STRENGTH.3=Փայլատակող

option.SHADOW_SOFTNESS=Ստվերների փափկություն
option.SHADOW_SOFTNESS.comment=Կառավարում է, թե որքան փափուկ և ցրված են երևում ստվերների եզրերը։ Օգտագործում է պտտված Poisson սկավառակի զտում՝ հարթ կիսաստվերի համար։

value.SHADOW_SOFTNESS.1=Սուր
value.SHADOW_SOFTNESS.2=Փափուկ
value.SHADOW_SOFTNESS.3=Ուլտրա փափուկ

# ==============================================================================
# Sun & Moon Lighting
# ==============================================================================
screen.SUN_MOON=Արև և լուսին
screen.SUN_MOON.comment=Ճշգրիտ կարգավորեք արևի և լուսնի ինտենսիվությունը, գույնի ջերմաստիճանը և մթնոլորտային էֆեկտները։

option.SUN_INTENSITY=Արևի ինտենսիվություն
option.SUN_INTENSITY.comment=Ուղիղ արևի լույսի հիմնական պայծառություն։ Ավելի բարձր = ավելի ուժեղ ցերեկային կոնտրաստ։
value.SUN_INTENSITY.1=Աղոտ
value.SUN_INTENSITY.2=Ստանդարտ
value.SUN_INTENSITY.3=Պայծառ
value.SUN_INTENSITY.4=Կիզիչ

option.MOON_INTENSITY=Լուսնի ինտենսիվություն
option.MOON_INTENSITY.comment=Լուսնի լույսի հիմնական պայծառություն։ Ավելի բարձր = ավելի պայծառ, ավելի տեսանելի գիշերներ։
value.MOON_INTENSITY.1=Անթափանց գիշեր
value.MOON_INTENSITY.2=Ստանդարտ
value.MOON_INTENSITY.3=Պայծառ լուսին
value.MOON_INTENSITY.4=Լիարժեք գիշեր

option.SUN_TEMPERATURE=Արևի գույնի ջերմաստիճան
option.SUN_TEMPERATURE.comment=Տեղափոխում է արևի Կելվինի կորը։ Իրատեսականն օգտագործում է Tanner Helland սև մարմինը; տաք = ոսկեգույն; սառը = չեզոք սպիտակ։
