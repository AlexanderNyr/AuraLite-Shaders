# ==============================================================================
# Quality Profiles
# ==============================================================================
profile.VERY_LOW=Isel Iawn
profile.VERY_LOW.comment=FPS mwyaf absoliwt. Pob ychwanegiad i ffwrdd: dim cysgodion, cymylau, PBR, SSR, pelydrau. Dim ond isafswm rendro.
profile.LOW=Isel
profile.LOW.comment=Ysgafn ond chwaraeadwy. Yn cadw animeiddiant dail/dŵr, sêr mwy disglair, FXAA, finët. Dim cysgodion, cymylau na PBR.
profile.MED=Canolig
profile.MED.comment=Y pwynt melys dyddiol. Cysgodion 1024, cymylau, PBR, SSR Cyflym, pelydrau, SSS dail, adlewyrchiadau gwlyb, niwl, sêr gwib.
profile.HIGH=Uchel
profile.HIGH.comment=Ansawdd i frantasiaid. Cysgodion 2048, SSR Cytbwys, TAA, SSAO Mân, pelydrau Cytbwys, SMAA.
profile.ULTRA=Eithaf
profile.ULTRA.comment=Uwchraddol. Cysgodion 4096, SSR Uchel, SSAO Cytbwys, pelydrau Uchel, TAA Sefydlog, pob effaith ymlaen.
profile.EXTREME=Eithafol
profile.EXTREME.comment=Sinematig uchafbwynt. Popeth ar y uchaf: PBR Amrediad diderfyn, tônluniad ffotograffig (AgX), SSAO dyfnaf, stormydd sêr gwib.
profile.CUSTOM=Personol
profile.CUSTOM.comment=Gosodiadau wedi'u haddasu gan y defnyddiwr.

screen.TRANSLATION_NOTICE=⚠ Gall cyfieithiadau gynnwys gwallau
screen.TRANSLATION_NOTICE.comment=Gall rhai llinynnau cyfieithu fod yn anghywir. Os yw rhywbeth yn edrych yn rhyfedd, cymharwch â'r Saesneg gwreiddiol.

# Screens
screen.LIGHTING=Gosodiadau goleuo
screen.LIGHTING.comment=Cyfluniwch gysgodion, lliwiau golau, a llewyrch.

screen.FOLIAGE=Gosodiadau llystyfiant
screen.FOLIAGE.comment=Cyfluniwch animeiddiadau tonnog ar gyfer glaswellt a dail.

screen.WATER=Gosodiadau dŵr
screen.WATER.comment=Cyfluniwch donnau, tryloywder, ac arddull dŵr.

screen.CLOUDS_MENU=Awyr a chymylau
screen.CLOUDS_MENU.comment=Cyfluniwch uchder ffisegol, trwch, ac arddull cymylau 3D ac effeithiau awyr.

screen.POST_PROCESS=Ôl-brosesu a niwl
screen.POST_PROCESS.comment=Cyfluniwch amlygiad, niwl, ac effeithiau sinematig.
screen.POST_FOG=Fog & Image
screen.POST_FOG.comment=Fog density, ground mist, heat shimmer and dithering.

