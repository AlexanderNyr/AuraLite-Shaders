value.MOON_INTENSITY.2=Safonol
value.MOON_INTENSITY.3=Lleuad Llachar
value.MOON_INTENSITY.4=Nos Lawn

option.SUN_TEMPERATURE=Tymheredd Lliw Haul
option.SUN_TEMPERATURE.comment=Yn symud cromlin Kelvin yr haul. Mae realistig yn defnyddio corff du Tanner Helland; cynnes = euraidd; oer = gwyn niwtral.
value.SUN_TEMPERATURE.1=Oer / Niwtral
value.SUN_TEMPERATURE.2=Realistig
value.SUN_TEMPERATURE.3=Aur Cynnes

option.MOON_TEMPERATURE=Tymheredd Lliw Lleuad
option.MOON_TEMPERATURE.comment=Arlliw golau'r lleuad. Iasoer = oer glasaidd; Arian = realistig 4100K; Cynnes = hufen lleuad cynhaeaf.
value.MOON_TEMPERATURE.1=Glas Iasoer
value.MOON_TEMPERATURE.2=Arian (Realistig)
value.MOON_TEMPERATURE.3=Hufen Cynnes

option.SUN_HALO=Halo Haul (Gwasgariad Mie)
option.SUN_HALO.comment=Ychwanegu gwawl cynnes meddal ar dir wrth edrych ger yr haul (gwasgariad ymlaen Mie).

option.SUNRISE_GLOW=Gwawl Codiad/Machlud Haul Gwell
option.SUNRISE_GLOW.comment=Yn galluogi gwasgariad ôl cynnes cryfach sy'n lapio o amgylch arwynebau sy'n wynebu i ffwrdd o'r haul isel.

# ==============================================================================
# Extended shadow settings
# ==============================================================================
option.shadowDistance=Pellter Cysgod
option.shadowDistance.comment=Pellter mwyaf y mae cysgodau deinamig yn cael eu rendro. Mae gwerthoedd uwch yn ymestyn cysgodau i bellter rendro; defnyddiwch Shadow LOD i gynnal perfformiad ar ystodau estynedig.
value.shadowDistance.60.0=Agos (60m)
value.shadowDistance.80.0=Safonol (80m)
value.shadowDistance.120.0=Pell (120m)
value.shadowDistance.160.0=Ultra (160 m)
value.shadowDistance.256.0=Wedi'i ymestyn (256 m)
value.shadowDistance.384.0=Pellter rendro (384 m)
value.shadowDistance.192.0=DH Seam (192m)
value.shadowDistance.512.0=DH Extended (512m)
value.shadowDistance.768.0=DH Far (768m)

option.SHADOW_LOD=LOD cysgodol
option.SHADOW_LOD.comment=Yn rheoli dirywiad ansawdd cysgodion gyda phellter. Gyda phellter cysgod estynedig (256-384 m), mae LOD yn lleihau nifer y samplau ac yn cynyddu radiws y hidlydd ar bellter i gynnal perfformiad. I ffwrdd = ansawdd unfatharaf (araf). Cytbwys = gostyngiad ar 25-50% pellter. Ymosodol = gostyngiad uchaf ar 15-60% pellter. Mae cysgodion yn cael eu hepgor yn llwyr y tu hwnt i 95% o bellter rendro.
value.SHADOW_LOD.0=I ffwrdd (ansawdd unfath)
value.SHADOW_LOD.1=Cytbwys
value.SHADOW_LOD.2=Ymosodol
option.DH_SHADOW_RANGE=Distant Horizons Shadow Range
option.DH_SHADOW_RANGE.comment=Maximum range where Distant Horizons LOD terrain and water can receive samples from the shared DH shadow map. Seam keeps shadows close to vanilla chunks; Far extends coverage but can cost more GPU time. No effect without Distant Horizons.
value.DH_SHADOW_RANGE.1=Seam (1.25x)
value.DH_SHADOW_RANGE.2=Extended (2x)
value.DH_SHADOW_RANGE.3=Far (4x)
option.SHADOW_PCSS_BLUR=Pylu PCSS ar bellter
option.SHADOW_PCSS_BLUR.comment=Yn galluogi meddalu hanner-cysgod PCSS sy'n cynyddu pylu cysgodion gyda phellter ac yn ystod glaw. Analluogi ar gyfer meddalwch sefydlog (cysgodion pellach yn fwy miniog, llai realistig).
value.SHADOW_PCSS_BLUR.0=I ffwrdd (meddalwch sefydlog)
value.SHADOW_PCSS_BLUR.1=Ymlaen (PCSS hanner-cysgod)


option.AMBIENT_BRIGHTNESS=Codi Cysgod / Amgylchol
option.AMBIENT_BRIGHTNESS.comment=Rheoli pa mor dywyll y mae ardaloedd cysgodol yn ymddangos yn y nos ac mewn ogofâu.
value.AMBIENT_BRIGHTNESS.1=Tywyll
value.AMBIENT_BRIGHTNESS.2=Safonol
value.AMBIENT_BRIGHTNESS.3=Codwyd (Disglair)

option.SHADOW_TINT=Arlliw Cysgod
option.SHADOW_TINT.comment=Yn arlliwio cysgodion dydd. Mae gan gysgodion byd go iawn o dan awyr las arlliw oer cynnil.
value.SHADOW_TINT.1=Llwyd niwtral
value.SHADOW_TINT.2=Glas oer (realistig)
value.SHADOW_TINT.3=Cynnes

option.LIGHT_WRAP=Lapio Golau
option.LIGHT_WRAP.comment=Yn meddalu'r derfynydd rhwng arwynebau golau a heb olau. Realistig = Lambert ffisegol; Meddal = pleserus ar gyfer sgrinluniau.
value.LIGHT_WRAP.1=Realistig (Lambert)
value.LIGHT_WRAP.2=Lapio Meddal
value.LIGHT_WRAP.3=Steilyddiedig

