# ==============================================================================
# Quality Profiles
# ==============================================================================
profile.VERY_LOW=Velmi Nízký
profile.VERY_LOW.comment=Absolutní maximum FPS. Všechny doplňky vypnuty: bez stínů, mraků, PBR, SSR, godrays. Pouze minimální vykreslování.
profile.LOW=Nízký
profile.MED=Střední
profile.HIGH=Vysoký
profile.ULTRA=Ultra
profile.EXTREME=Extrémní
profile.EXTREME.comment=Kinematografický maximum. Vše na max: PBR Neomezený dosah, fotografické tónové mapování (AgX), nejhlubší SSAO, meteorické bouře.
profile.CUSTOM=Vlastní
profile.CUSTOM.comment=Vlastní nastavení upravená uživatelem.
profile.HIGH.comment=Kvalita pro nadšence. Stíny 2048, SSR Vyvážený, TAA, SSAO Jemné, godrays Vyvážené, SMAA.
profile.LOW.comment=Lehký, ale hratelný. Zachovává animaci listů/vody, jasnější hvězdy, FXAA, vinětaci. Bez stínů, mraků a PBR.
profile.MED.comment=Denní optimum. Stíny 1024, mraky, PBR, SSR Rychlý, godrays, SSS listí, mokré odrazy, mlha, meteory.
profile.ULTRA.comment=High-end. Stíny 4096, SSR Vysoký, SSAO Vyvážené, godrays Vysoké, TAA Stabilní, všechny efekty zapnuty.

screen.TRANSLATION_NOTICE=⚠ Překlady mohou obsahovat chyby
screen.TRANSLATION_NOTICE.comment=Některé lokalizační řetězce mohou být nepřesné. Pokud něco vypadá zvláštně, porovnejte s anglickým originálem.

# Screens
screen.LIGHTING=Nastavení Osvětlení
screen.LIGHTING.comment=Nastavte stíny, barvy světla a jas.
screen.FOLIAGE=Nastavení Vegetace
screen.FOLIAGE.comment=Nastavte animace vlnění trávy a listí.
screen.WATER=Nastavení Vody
screen.WATER.comment=Nastavte vlny, průhlednost a styl vody.
screen.CLOUDS_MENU=Obloha a Mraky
screen.CLOUDS_MENU.comment=Nastavte fyzickou výšku, tloušťku a styl 3D mraků a efektů oblohy.
screen.POST_PROCESS=Postprocessing a Mlha
screen.POST_PROCESS.comment=Nastavte expozici, mlhu a filmové efekty.
screen.POST_FOG=Fog & Image
screen.POST_FOG.comment=Fog density, ground mist, heat shimmer and dithering.

# Options
option.SHADOWS=Dynamické Stíny
option.SHADOWS.comment=Zapněte nebo vypněte měkké dynamické stíny od slunce a měsíce.
option.shadowMapResolution=Rozlišení Stínů
option.shadowMapResolution.comment=Změňte kvalitu mapy stínů. Vyšší hodnoty mohou snížit výkon.
option.PBR_LIGHTING=PBR Osvětlení (LabPBR)
option.PBR_LIGHTING.comment=Zapněte fyzikálně korektní vykreslování pro kovy, drsnost a 3D normálové mapy (vyžaduje balíček zdrojů PBR).
option.PBR_POM=3D Reliéf Bloků (POM)
option.PBR_POM.comment=Zapněte fyzikálně korektní Parallax Occlusion Mapping pro 3D textury bloků. Doporučeno vypnout u nekompatibilních balíčků zdrojů.
option.PBR_STRENGTH=Intenzita PBR
option.PBR_STRENGTH.comment=Ovládejte odrazivost a lesk kovových povrchů PBR.
value.PBR_STRENGTH.1=Jemná
value.PBR_STRENGTH.2=Standardní
value.PBR_STRENGTH.3=Zrcadlová
option.LIGHTMAP_WARMTH=Teplota Pochodně
option.LIGHTMAP_WARMTH.comment=Upravte teplotu a barvu světla bloků/pochodní.
value.LIGHTMAP_WARMTH.1=Útulná
value.LIGHTMAP_WARMTH.2=Teplý
value.LIGHTMAP_WARMTH.3=Intenzivní
option.WAVING_LEAVES=Vlnící se Listí
option.WAVING_LEAVES.comment=Zapněte jemné animace vlnění listí stromů.
option.WAVING_GRASS=Vlnící se Rostlinstvo
option.WAVING_GRASS.comment=Zapněte animace vlnění trávy, květin a plodin.
option.WIND_SPEED=Rychlost Větru
option.WIND_SPEED.comment=Ovládejte rychlost vlnění listí, rostlin a vodních vln.
value.WIND_SPEED.1=Mírný
value.WIND_SPEED.2=Vánek
value.WIND_SPEED.3=Vichřice
option.WATER_WAVES=Vodní Vlny
option.WATER_WAVES.comment=Zapne 3D geometrické vlny na povrchu vody.
option.WATER_TRANSPARENCY=Hustota Vody
option.WATER_TRANSPARENCY.comment=Řídí průhlednost a neprůhlednost vody.
value.WATER_TRANSPARENCY.1=Čistá
value.WATER_TRANSPARENCY.2=Vyvážená
value.WATER_TRANSPARENCY.3=Hluboká
option.PROCEDURAL_CLOUDS=Objemové 3D Mraky
option.PROCEDURAL_CLOUDS.comment=Zapněte fyzicky proletitelné 3D mraky, kterými lze proletět.
option.CLOUD_HEIGHT=Výška Mraků
option.CLOUD_HEIGHT.comment=Nastavte fyzickou výšku (Y-úroveň) vrstvy mraků ve světě (v metrech).
option.CLOUD_THICKNESS=Tloušťka Mraků
option.CLOUD_THICKNESS.comment=Nastavte svislou tloušťku a objem mraků.
option.AURORA_MODE=Polární Záře
option.AURORA_MODE.comment=Ovládejte zobrazení realistické plynoucí polární záře na noční obloze.
value.AURORA_MODE.0=Vypnuto
value.AURORA_MODE.1=Pouze ve Studených Biomech
value.AURORA_MODE.2=Vždy Zapnuto
option.AURORA_SPEED=Rychlost Polární Záře
option.AURORA_SPEED.comment=Ovládejte rychlost vlnění a proudění polární záře.
value.AURORA_SPEED.1=Pomalá
value.AURORA_SPEED.2=Standardní
value.AURORA_SPEED.3=Rychlá
option.AURORA_STRENGTH=Jas Polární Záře
option.AURORA_STRENGTH.comment=Ovládejte celkový jas záře polární záře.
value.AURORA_STRENGTH.1=Měkká
value.AURORA_STRENGTH.2=Standardní
value.AURORA_STRENGTH.3=Zářící
option.AURORA_QUALITY=Aurora Quality
option.AURORA_QUALITY.comment=Raymarch steps for Aurora Borealis. Higher settings smooth curtain volume and reduce visible layering; the new centered sampling removes per-pixel grain.
value.AURORA_QUALITY.1=Soft (8 steps)
value.AURORA_QUALITY.2=Balanced (12 steps)
value.AURORA_QUALITY.3=Silky (18 steps)
option.NEBULA_BRIGHTNESS=Jas Mléčné Dráhy
option.NEBULA_BRIGHTNESS.comment=Upravte jas záře diagonální nahnědlé galaktické mlhoviny v noci.
value.NEBULA_BRIGHTNESS.1=Tlumená
value.NEBULA_BRIGHTNESS.2=Standardní
value.NEBULA_BRIGHTNESS.3=Jasná
option.STARS_BRIGHTNESS=Jas Hvězd
option.STARS_BRIGHTNESS.comment=Ovládejte jas a jiskřivou záři hvězd v noci.
value.STARS_BRIGHTNESS.1=Slabá
value.STARS_BRIGHTNESS.2=Standardní
value.STARS_BRIGHTNESS.3=Brilantní
option.STARS_AMOUNT=Hustota Hvězd
option.STARS_AMOUNT.comment=Ovládejte celkové množství a hustotu hvězd na obloze.
value.STARS_AMOUNT.1=Málo
value.STARS_AMOUNT.2=Standardní
value.STARS_AMOUNT.3=Hustá
option.RAINBOW_STRENGTH=Intenzita Duhy
option.RAINBOW_STRENGTH.comment=Nastavte jas a sytost barev duhy po dešti.
value.RAINBOW_STRENGTH.1=Jemná
value.RAINBOW_STRENGTH.2=Vyvážená
value.RAINBOW_STRENGTH.3=Živá
option.COZY_LIGHTS=Blikání Pochodně
option.COZY_LIGHTS.comment=Zapněte teplé, útulné animace blikání v reálném čase pro pochodně, ohniště a lucerny.
option.WET_REFLECTIONS=Odrazy Mokra od Deště
option.WET_REFLECTIONS.comment=Když prší, pevné bloky jako země, tráva a kámen zvlhnou, ztmavnou a získají lesk pod oblohou.
option.GROUND_MIST=Nízká Přízemní Mlha (Y=62-66)
option.GROUND_MIST.comment=Zapněte jemné, zlatavě bílé ranní/večerní mlžné vrstvy, které kloužou nad vodou a ledem za svítání a soumraku.
option.FOG_DENSITY_LEVEL=Hustota Mlhy
option.FOG_DENSITY_LEVEL.comment=Ovládejte sílu atmosférické mlhy na horizontu.
value.FOG_DENSITY_LEVEL.1=Nízká
value.FOG_DENSITY_LEVEL.2=Střední
value.FOG_DENSITY_LEVEL.3=Vysoká

option.TAA=Časové Vyhlazování Hran (TAA)
option.TAA.comment=Časové řešení s reprojekcí pohybu a ořezáváním okolí. Snižuje blikání a zubaté hrany u vysokých profilů.
option.TAA_STRENGTH=Síla TAA
option.TAA_STRENGTH.comment=Ovládá mísení historie. Vyšší hodnota je stabilnější, ale může být měkčí během pohybu.
value.TAA_STRENGTH.1=Lehká
value.TAA_STRENGTH.2=Vyvážená
value.TAA_STRENGTH.3=Stabilní

option.TAA_JITTER=Chvění kamery (TAA)
option.TAA_JITTER.comment=Subpixelové chvění kamery (Halton), které umožňuje TAA rekonstruovat subpixelové detaily. Ve výchozím nastavení vypnuto pro naprosto stabilní obraz; Jemný a vyšší odstraňuje vysokofrekvenční blikání za cenu mírného časového kolísání. Vyžaduje zapnuté TAA.
value.TAA_JITTER.0=Vypnuto
value.TAA_JITTER.1=Jemný
value.TAA_JITTER.2=Standardní
value.TAA_JITTER.3=Silný
option.WATER_RIFFLES=Síla Vlnek na Vodě
option.WATER_RIFFLES.comment=Upravuje intenzitu jemných vlnek normal map na vodě.
value.WATER_RIFFLES.1=Klidná
value.WATER_RIFFLES.2=Standardní
value.WATER_RIFFLES.3=Rozbouřená
option.WATER_SPECULAR_STRENGTH=Zrcadlový Lesk Vody
option.WATER_SPECULAR_STRENGTH.comment=Upravuje jas odrazů Slunce/Měsíce na vodních vlnkách.
value.WATER_SPECULAR_STRENGTH.1=Měkká
value.WATER_SPECULAR_STRENGTH.2=Standardní
value.WATER_SPECULAR_STRENGTH.3=Blyštivá
option.SHADOW_SOFTNESS=Měkkost Stínů
option.SHADOW_SOFTNESS.comment=Ovládá, jak měkké a rozptýlené se jeví hrany stínů. Používá rotované Poissonovo diskové filtrování pro hladký polostín.
value.SHADOW_SOFTNESS.1=Ostrá
value.SHADOW_SOFTNESS.2=Měkká
value.SHADOW_SOFTNESS.3=Ultra Měkká

option.SSAO=Okluze SSAO / SAO
option.SSAO.comment=Extrémní profil: screen-space ambient occlusion pro kontaktní stíny v rozích, pod bloky a kolem průsečíků geometrie.
option.SSAO_STRENGTH=Síla SSAO
option.SSAO_STRENGTH.comment=Ovládá hloubku ambientní okluze v prostoru obrazovky. Aktivní pouze při zapnutém SSAO.
value.SSAO_STRENGTH.1=Jemná
value.SSAO_STRENGTH.2=Vyvážená
value.SSAO_STRENGTH.3=Hluboká

option.CLOUD_DISTANCE=Dohled Vykreslení Mraků
option.CLOUD_DISTANCE.comment=Maximální dohled vykreslení pro objemové mraky. Profily kvality jej automaticky zvyšují.

option.CLOUD_SHADOWS=Stíny Mraků
option.CLOUD_SHADOWS.comment=Přidává průhledné procedurální stíny z objemové hustoty mraků na terén. Vyváženo profily kvality.
option.CLOUD_SHADOW_STRENGTH=Síla Stínů Mraků
option.CLOUD_SHADOW_STRENGTH.comment=Ovládá, jak výrazné a dramatické jsou průhledné stíny mraků.
value.CLOUD_SHADOW_STRENGTH.1=Měkká
value.CLOUD_SHADOW_STRENGTH.2=Vyvážená
value.CLOUD_SHADOW_STRENGTH.3=Dramatická

option.GODRAYS=Godrays / Sluneční Paprsky
option.GODRAYS.comment=Adds realistic screen-space sun shafts through sky gaps and behind geometry.
option.GODRAYS_QUALITY=Kvalita Godrays
option.GODRAYS_QUALITY.comment=Controls sample count and cost of godrays.
value.GODRAYS_QUALITY.1=Rychlá
value.GODRAYS_QUALITY.2=Vyvážená
value.GODRAYS_QUALITY.3=Vysoká

# ==============================================================================
# Sun and Moon (extended lighting)
# ==============================================================================
screen.SUN_MOON=Slunce a Měsíc
screen.SUN_MOON.comment=Doluďte intenzitu slunce a měsíce, teplotu barev a atmosférické efekty.
option.SUN_INTENSITY=Intenzita Slunce
option.SUN_INTENSITY.comment=Hlavní jas přímého slunečního světla. Vyšší = silnější denní kontrast.
value.SUN_INTENSITY.1=Tlumená
value.SUN_INTENSITY.2=Standardní
value.SUN_INTENSITY.3=Jasná
value.SUN_INTENSITY.4=Planoucí
option.MOON_INTENSITY=Intenzita Měsíce
option.MOON_INTENSITY.comment=Hlavní jas měsíčního svitu. Vyšší = jasnější, viditelnější noci.
value.MOON_INTENSITY.1=Naprostá Tma Noci
value.MOON_INTENSITY.2=Standardní
value.MOON_INTENSITY.3=Jasný Měsíc
value.MOON_INTENSITY.4=Plná Noc
option.SUN_TEMPERATURE=Teplota Barvy Slunce
option.SUN_TEMPERATURE.comment=Posouvá Kelvinovu křivku slunce. Realistický režim používá černé těleso Tannera Hellanda; teplá = zlatavá; chladná = neutrální bílá.
value.SUN_TEMPERATURE.1=Chladná / Neutrální
value.SUN_TEMPERATURE.2=Realistická
value.SUN_TEMPERATURE.3=Teplá Zlatá
option.MOON_TEMPERATURE=Teplota Barvy Měsíce
option.MOON_TEMPERATURE.comment=Odstín měsíčního svitu. Ledový: namodralý chlad; Stříbrný: realistický 4100K; Teplý: krémový jako sklizňový měsíc.
value.MOON_TEMPERATURE.1=Ledová Modrá
value.MOON_TEMPERATURE.2=Stříbrná (Realistická)
value.MOON_TEMPERATURE.3=Teplá Krémová
option.SUN_HALO=Sluneční Halo (Mieho Rozptyl)
option.SUN_HALO.comment=Přidává jemnou teplou záři na terén při pohledu poblíž slunce (Mieho dopředný rozptyl).
option.SUNRISE_GLOW=Vylepšená Záře Východu/Západu Slunce
option.SUNRISE_GLOW.comment=Zapíná silnější teplý zpětný rozptyl, který obklopuje povrchy odvrácené od nízkého slunce.

# ==============================================================================
# Extended shadow settings
# ==============================================================================
option.shadowDistance=Dosah Stínů
option.shadowDistance.comment=Maximální vzdálenost, ve které jsou dynamické stíny vykreslovány. Vyšší hodnoty rozšiřují stíny na vykreslovací vzdálenost; pro udržení výkonu při rozšířeném dosahu použijte Shadow LOD.
value.shadowDistance.60.0=Blízko (60m)
value.shadowDistance.80.0=Standardní (80m)
value.shadowDistance.120.0=Daleko (120m)
value.shadowDistance.160.0=Ultra (160 m)
value.shadowDistance.256.0=Rozšířená (256 m)
value.shadowDistance.384.0=Vzdálenost vykreslování (384 m)
value.shadowDistance.192.0=DH Seam (192m)
value.shadowDistance.512.0=DH Extended (512m)
value.shadowDistance.768.0=DH Far (768m)

option.SHADOW_LOD=LOD stínů
option.SHADOW_LOD.comment=Řídí snižování kvality stínů s rostoucí vzdáleností. Při rozšířené vzdálenosti stínů (256-384 m) LOD snižuje počet vzorků a zvětšuje poloměr filtru na dálku pro udržení výkonu. Vypnuto = rovnoměrná kvalita (pomalé). Vyvážené = snížení na 25-50% vzdálenosti. Agresivní = maximální snížení na 15-60% vzdálenosti. Stíny jsou zcela přeskočeny za 95% vzdálenosti vykreslování.
value.SHADOW_LOD.0=Vypnuto (rovnoměrná kvalita)
value.SHADOW_LOD.1=Vyvážené
value.SHADOW_LOD.2=Agresivní
option.DH_SHADOW_RANGE=Distant Horizons Shadow Range
option.DH_SHADOW_RANGE.comment=Maximum range where Distant Horizons LOD terrain and water can receive samples from the shared DH shadow map. Seam keeps shadows close to vanilla chunks; Far extends coverage but can cost more GPU time. No effect without Distant Horizons.
value.DH_SHADOW_RANGE.1=Seam (1.25x)
value.DH_SHADOW_RANGE.2=Extended (2x)
value.DH_SHADOW_RANGE.3=Far (4x)
option.SHADOW_PCSS_BLUR=PCSS rozostření na vzdálenost
option.SHADOW_PCSS_BLUR.comment=Povoluje PCSS změkčení polostínu, které zvyšuje rozostření stínů s rostoucí vzdáleností a za deště. Vypněte pro pevnou měkkost (ostřejší vzdálené stíny, méně realistické).
value.SHADOW_PCSS_BLUR.0=Vypnuto (pevná měkkost)
value.SHADOW_PCSS_BLUR.1=Zapnuto (PCSS polostín)

option.AMBIENT_BRIGHTNESS=Zvednutí Stínů / Okolí
option.AMBIENT_BRIGHTNESS.comment=Ovládá, jak tmavě vypadají zastíněné oblasti v noci a v jeskyních.
value.AMBIENT_BRIGHTNESS.1=Tmavá
value.AMBIENT_BRIGHTNESS.2=Standardní
value.AMBIENT_BRIGHTNESS.3=Zvednutá (Jasná)
option.SHADOW_TINT=Odstín Stínu
option.SHADOW_TINT.comment=Zabarvuje denní stíny. Skutečné stíny pod modrou oblohou mají jemný chladný odstín.
value.SHADOW_TINT.1=Neutrální Šedá
value.SHADOW_TINT.2=Chladná Modrá (Realistická)
value.SHADOW_TINT.3=Teplý
option.LIGHT_WRAP=Obalení Světlem
option.LIGHT_WRAP.comment=Změkčuje terminátor mezi osvětlenými a neosvětlenými povrchy. Realistický = fyzikální Lambert; Měkký = příjemný pro screenshoty.
value.LIGHT_WRAP.1=Realistický (Lambert)
value.LIGHT_WRAP.2=Měkké Obalení
value.LIGHT_WRAP.3=Stylizovaný

# v0.2.9 — water/underwater option value labels (English fallback)
value.WATER_WAVE_SCALE.1=Klidná
value.WATER_WAVE_SCALE.2=Standardní
value.WATER_WAVE_SCALE.3=Rozbouřená
value.WATER_WAVE_SCALE.4=Bouřlivá
value.WATER_WAVE_DETAIL.1=Hrubá
value.WATER_WAVE_DETAIL.2=Standardní
value.WATER_WAVE_DETAIL.3=Hustá
value.UNDERWATER_NIGHT_DARKNESS.1=Jezírko za Měsíčního Svitu
value.UNDERWATER_NIGHT_DARKNESS.2=Tlumená
value.UNDERWATER_NIGHT_DARKNESS.3=Skutečná Noc
