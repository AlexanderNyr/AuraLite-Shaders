shaderDescription=AuraLite v1.2.0 — fizikai felhők, ég és víz csúszkákkal állítható színekkel
# AuraLite Shaders v1.2.0 - Copyright (c) 2026 AlexanderNyr. Licensed under CC BY-NC-SA 4.0.
# ==============================================================================
# AuraLite Shader Pack - Hungarian Language Translations
# ==============================================================================

# ==============================================================================
# Quality Profiles
# ==============================================================================
profile.VERY_LOW=Nagyon alacsony
profile.VERY_LOW.comment=Abszolút FPS maximum. Minden extra kikapcsolva: nincs árnyék, felhő, PBR, SSR, fénysugár. Csak minimális renderelés.
profile.LOW=Alacsony
profile.LOW.comment=Könnyű, de játszható. Megtartja a lombozat/víz animációt, világosabb csillagokat, FXAA-t, vignettát. Nincs árnyék, felhő vagy PBR.
profile.MED=Közepes
profile.MED.comment=A mindennapi édes pont. 1024 árnyék, felhők, PBR, SSR Gyors, fénysugarak, lombozat SSS, nedves visszaverődések, köd, meteorok.
profile.HIGH=Magas
profile.HIGH.comment=Hobbi minőség. 2048 árnyék, SSR Kiegyensúlyozott, TAA, SSAO Finom, fénysugarak Kiegyensúlyozott, SMAA.
profile.ULTRA=Ultra
profile.ULTRA.comment=Csúcskategória. 4096 árnyék, SSR Magas, SSAO Kiegyensúlyozott, fénysugarak Magas, TAA Stabil, minden effekt bekapcsolva.
profile.EXTREME=Extrém
profile.EXTREME.comment=Mozis maximum. Minden maximumon: PBR Korlátlan hatótávolság, fényképészeti tónusleképezés (AgX), legmélyebb SSAO, meteorviharok.
profile.CUSTOM=Egyéni
profile.CUSTOM.comment=Egyedi, felhasználó által módosított beállítások.

screen.TRANSLATION_NOTICE=⚠ A fordítások hibákat tartalmazhatnak
screen.TRANSLATION_NOTICE.comment=Egyes fordítási szövegek pontatlanok lehetnek. Ha valami furcsának tűnik, hasonlítsd össze az angol eredetivel.

# Screens
screen.LIGHTING=Fénybeállítások
screen.LIGHTING.comment=Állítsd be az árnyékokat, a fényszíneket és a fényerőt.

screen.FOLIAGE=Lombozat beállítások
screen.FOLIAGE.comment=Állítsd be a fű és a levelek hullámzó animációit.

screen.WATER=Víz beállítások
screen.WATER.comment=Állítsd be a hullámokat, az átlátszóságot és a víz stílusát.

screen.CLOUDS_MENU=Ég és felhők
screen.CLOUDS_MENU.comment=Állítsd be a 3D felhők és égi effektek fizikai magasságát, vastagságát és stílusát.

screen.POST_PROCESS=Utófeldolgozás és köd
screen.POST_PROCESS.comment=Állítsd be az expozíciót, a ködöt és a filmes hatásokat.
screen.POST_FOG=Fog & Image
screen.POST_FOG.comment=Fog density, ground mist, heat shimmer and dithering.

# Options
option.SHADOWS=Dinamikus árnyékok
option.SHADOWS.comment=Kapcsold be vagy ki a nap és a hold lágy dinamikus árnyékait.

option.shadowMapResolution=Árnyékfelbontás
option.shadowMapResolution.comment=Változtasd meg az árnyéktérkép minőségét. A magasabb értékek csökkenthetik a teljesítményt.

option.PBR_LIGHTING=PBR megvilágítás (LabPBR)
option.PBR_LIGHTING.comment=Kapcsold be a fizikai alapú megjelenítést a fémekhez, érdességhez és 3D normáltérképekhez (PBR erőforráscsomag szükséges).

option.PBR_POM=3D blokk-dombormű (POM)
option.PBR_POM.comment=Kapcsold be a fizikai alapú Parallax Occlusion Mapping-et a 3D blokktextúrákhoz. Nem kompatibilis erőforráscsomagok esetén ajánlott kikapcsolni.

option.PBR_STRENGTH=PBR intenzitás
option.PBR_STRENGTH.comment=Szabályozd a PBR fémes felületek visszaverő képességét és fényességét.

value.PBR_STRENGTH.1=Finom
value.PBR_STRENGTH.2=Alap
value.PBR_STRENGTH.3=Tükör

option.SSAO=SSAO / SAO takarás
option.SSAO.comment=Extreme profile: screen-space ambient occlusion for contact shadows in corners, under blocks, and around geometry intersections.
option.SSAO_STRENGTH=SSAO erőssége
option.SSAO_STRENGTH.comment=Szabályozza a képernyőtér ambiens takarásának mélységét. Csak akkor aktív, ha az SSAO be van kapcsolva.
value.SSAO_STRENGTH.1=Finom
value.SSAO_STRENGTH.2=Kiegyensúlyozott
value.SSAO_STRENGTH.3=Mély

option.LIGHTMAP_WARMTH=Fáklya melegsége
option.LIGHTMAP_WARMTH.comment=Állítsd be a blokk-/fáklyafény melegségét és színét.

value.LIGHTMAP_WARMTH.1=Hangulatos
value.LIGHTMAP_WARMTH.2=Meleg
value.LIGHTMAP_WARMTH.3=Intenzív

option.WAVING_LEAVES=Hullámzó levelek
option.WAVING_LEAVES.comment=Kapcsold be a fák leveleinek finom hullámzó animációit.

option.WAVING_GRASS=Hullámzó növényzet
option.WAVING_GRASS.comment=Kapcsold be a fű, virágok és növények hullámzó animációit.

option.WIND_SPEED=Szélsebesség
option.WIND_SPEED.comment=Szabályozd a levelek, növények és vízhullámok hullámzási sebességét.

value.WIND_SPEED.1=Enyhe
value.WIND_SPEED.2=Szellő
value.WIND_SPEED.3=Szélvihar

option.WATER_WAVES=Vízhullámok
option.WATER_WAVES.comment=Enable 3D geometric waves on the water surface.

option.WATER_TRANSPARENCY=Víz sűrűsége
option.WATER_TRANSPARENCY.comment=Control the transparency and opacity of the water.

value.WATER_TRANSPARENCY.1=Tiszta
value.WATER_TRANSPARENCY.2=Kiegyensúlyozott
value.WATER_TRANSPARENCY.3=Mély

option.PROCEDURAL_CLOUDS=Térfogati 3D felhők
option.PROCEDURAL_CLOUDS.comment=Kapcsold be a fizikailag átrepülhető 3D felhőket, amelyeket el lehet érni és át lehet repülni.

option.CLOUD_HEIGHT=Felhőmagasság
option.CLOUD_HEIGHT.comment=Állítsd be a felhőréteg fizikai magasságát (Y-szint) a világban (méterben).


option.CLOUD_THICKNESS=Felhővastagság
option.CLOUD_THICKNESS.comment=Állítsd be a felhők függőleges vastagságát és térfogatát.


option.CLOUD_DISTANCE=Felhő megjelenítési távolság
option.CLOUD_DISTANCE.comment=A térfogati felhők maximális megjelenítési távolsága. A minőségi profilok automatikusan növelik.

option.CLOUD_SHADOWS=Felhőárnyékok
option.CLOUD_SHADOWS.comment=Átlátszó procedurális árnyékokat ad hozzá a terephez a térfogati felhők sűrűségéből. A minőségi profilok egyensúlyozzák.
option.CLOUD_SHADOW_STRENGTH=Felhőárnyék erőssége
option.CLOUD_SHADOW_STRENGTH.comment=Szabályozza, mennyire láthatóak és drámaiak az átlátszó felhőárnyékok.
value.CLOUD_SHADOW_STRENGTH.1=Lágy
value.CLOUD_SHADOW_STRENGTH.2=Kiegyensúlyozott
value.CLOUD_SHADOW_STRENGTH.3=Drámai

option.GODRAYS=Napsugarak (Godrays)
option.GODRAYS.comment=Adds physically-inspired volumetric single-scattering sun shafts with Beer-Lambert extinction, Mie phase and shadow-map occlusion.
option.GODRAYS_QUALITY=Godrays minőség
option.GODRAYS_QUALITY.comment=Controls the sample count and integration distance of physically-based volumetric godrays.
value.GODRAYS_QUALITY.1=Gyors
value.GODRAYS_QUALITY.2=Kiegyensúlyozott
value.GODRAYS_QUALITY.3=Magas

option.AURORA_MODE=Sarki fény
option.AURORA_MODE.comment=Szabályozd a valósághűen áramló sarki fények megjelenítését az éjszakai égbolton.

value.AURORA_MODE.0=Letiltva
value.AURORA_MODE.1=Csak hideg biomokban
value.AURORA_MODE.2=Mindig bekapcsolva

option.AURORA_SPEED=Sarki fény sebessége
option.AURORA_SPEED.comment=Szabályozd a sarki fény hullámzásának és áramlásának sebességét.

value.AURORA_SPEED.1=Lassú
value.AURORA_SPEED.2=Alap
value.AURORA_SPEED.3=Gyors

option.AURORA_STRENGTH=Sarki fény fényessége
option.AURORA_STRENGTH.comment=Szabályozd a sarki fény izzásának összfényességét.

value.AURORA_STRENGTH.1=Lágy
value.AURORA_STRENGTH.2=Alap
value.AURORA_STRENGTH.3=Izzó

option.AURORA_QUALITY=Aurora Quality
option.AURORA_QUALITY.comment=Raymarch steps for Aurora Borealis. Higher settings smooth curtain volume and reduce visible layering; the new centered sampling removes per-pixel grain.
value.AURORA_QUALITY.1=Soft (8 steps)
value.AURORA_QUALITY.2=Balanced (12 steps)
value.AURORA_QUALITY.3=Silky (18 steps)
option.NEBULA_BRIGHTNESS=Tejút fényessége
option.NEBULA_BRIGHTNESS.comment=Állítsd be az átlós barnás galaktikus köd izzásának fényességét éjszaka.

value.NEBULA_BRIGHTNESS.1=Halvány
value.NEBULA_BRIGHTNESS.2=Alap
value.NEBULA_BRIGHTNESS.3=Fényes

option.STARS_BRIGHTNESS=Csillagfényesség
option.STARS_BRIGHTNESS.comment=Szabályozd a csillagok fényességét és csillogó ragyogását éjszaka.

value.STARS_BRIGHTNESS.1=Halvány
value.STARS_BRIGHTNESS.2=Alap
value.STARS_BRIGHTNESS.3=Ragyogó

option.STARS_AMOUNT=Csillagsűrűség
option.STARS_AMOUNT.comment=Szabályozd az égbolt csillagainak összmennyiségét és sűrűségét.

value.STARS_AMOUNT.1=Kevés
value.STARS_AMOUNT.2=Alap
value.STARS_AMOUNT.3=Sűrű

option.RAINBOW_STRENGTH=Szivárvány intenzitása
option.RAINBOW_STRENGTH.comment=Állítsd be az eső utáni szivárvány fényességét és színtelítettségét.

value.RAINBOW_STRENGTH.1=Finom
value.RAINBOW_STRENGTH.2=Kiegyensúlyozott
value.RAINBOW_STRENGTH.3=Élénk

option.COZY_LIGHTS=Fáklyapislákolás
option.COZY_LIGHTS.comment=Kapcsold be a fáklyák, tábortüzek és lámpások meleg, hangulatos, valós idejű pislákoló animációit.

option.WET_REFLECTIONS=Esős nedvesség tükröződések
option.WET_REFLECTIONS.comment=Esőben a szilárd blokkok, mint a talaj, fű és kő, nedvessé, sötétebbé és fényessé válnak az ég alatt.

option.GROUND_MIST=Alacsony talajköd (Y=62-66)
option.GROUND_MIST.comment=Kapcsold be a lágy, aranyfehér reggeli/esti ködrétegeket, amelyek hajnalban és alkonyatkor a víz és a jég felett siklanak.

option.FOG_DENSITY_LEVEL=Ködsűrűség
option.FOG_DENSITY_LEVEL.comment=Szabályozd a légköri horizontköd erősségét.

value.FOG_DENSITY_LEVEL.1=Alacsony
value.FOG_DENSITY_LEVEL.2=Közepes
value.FOG_DENSITY_LEVEL.3=Magas







option.TAA=Temporális élsimítás (TAA)
option.TAA.comment=Időbeli feloldás mozgás-újravetítéssel és szomszédsági vágással. Csökkenti a csillogást és a recés éleket magas beállításoknál.
option.TAA_STRENGTH=TAA erőssége
option.TAA_STRENGTH.comment=Szabályozza az előzmény keverést. A magasabb érték stabilabb, de mozgás közben lágyabb lehet.
value.TAA_STRENGTH.1=Enyhe
value.TAA_STRENGTH.2=Kiegyensúlyozott
value.TAA_STRENGTH.3=Stabil

option.TAA_JITTER=Kamerarezgés (TAA)
option.TAA_JITTER.comment=Szubpixeles kamerarezgés (Halton), amely lehetővé teszi a TAA számára a szubpixeles részletek rekonstrukcióját. Alapértelmezésben kikapcsolva a teljesen stabil kép érdekében; a Finom és magasabb eltávolítja a nagyfrekvenciás vibrálást egy enyhe időbeli imbolygás árán. TAA bekapcsolását igényli.
value.TAA_JITTER.0=Ki
value.TAA_JITTER.1=Finom
value.TAA_JITTER.2=Alap
value.TAA_JITTER.3=Erős


option.WATER_RIFFLES=Vízfodor erőssége
option.WATER_RIFFLES.comment=Adjust the waviness and intensity of the fine normal map ripples on the water.

value.WATER_RIFFLES.1=Nyugodt
value.WATER_RIFFLES.2=Alap
value.WATER_RIFFLES.3=Hullámzó

option.WATER_SPECULAR_STRENGTH=Víz csillogása
option.WATER_SPECULAR_STRENGTH.comment=Adjust the brightness of sun/moon reflections on the water ripples.

value.WATER_SPECULAR_STRENGTH.1=Lágy
value.WATER_SPECULAR_STRENGTH.2=Alap
value.WATER_SPECULAR_STRENGTH.3=Csillogó

option.SHADOW_SOFTNESS=Árnyék lágysága
option.SHADOW_SOFTNESS.comment=Szabályozza, mennyire lágyak és diffúzak az árnyékélek. Forgatott Poisson-lemez szűrést használ a sima félárnyékhoz.

value.SHADOW_SOFTNESS.1=Éles
value.SHADOW_SOFTNESS.2=Lágy
value.SHADOW_SOFTNESS.3=Ultra lágy

# ==============================================================================
# Sun & Moon Lighting (extended)
# ==============================================================================
screen.SUN_MOON=Nap és Hold
screen.SUN_MOON.comment=Finomhangold a nap és a hold intenzitását, a színhőmérsékletet és az atmoszférikus hatásokat.

option.SUN_INTENSITY=Nap intenzitása
option.SUN_INTENSITY.comment=A közvetlen napfény fő fényereje. Magasabb = erősebb nappali kontraszt.
value.SUN_INTENSITY.1=Tompított
value.SUN_INTENSITY.2=Alap
value.SUN_INTENSITY.3=Fényes
value.SUN_INTENSITY.4=Lángoló

option.MOON_INTENSITY=Hold intenzitása
option.MOON_INTENSITY.comment=A holdfény fő fényereje. Magasabb = fényesebb, láthatóbb éjszakák.
value.MOON_INTENSITY.1=Koromsötét éjszaka
value.MOON_INTENSITY.2=Alap
value.MOON_INTENSITY.3=Fényes hold
value.MOON_INTENSITY.4=Teljes éjszaka

option.SUN_TEMPERATURE=Nap színhőmérséklete
option.SUN_TEMPERATURE.comment=Eltolja a nap Kelvin-görbéjét. Reális a Tanner Helland feketetest modellt használja; meleg = arany; hideg = semleges fehér.
value.SUN_TEMPERATURE.1=Hideg / Semleges
value.SUN_TEMPERATURE.2=Reális
value.SUN_TEMPERATURE.3=Meleg arany

option.MOON_TEMPERATURE=Hold színhőmérséklete
option.MOON_TEMPERATURE.comment=A holdfény árnyalata. Jeges = kékes hideg; Ezüst = valósághű 4100K; Meleg = aratóhold krémszín.
value.MOON_TEMPERATURE.1=Jeges kék
value.MOON_TEMPERATURE.2=Ezüst (Reális)
value.MOON_TEMPERATURE.3=Meleg krém

option.SUN_HALO=Napglória (Mie-szórás)
option.SUN_HALO.comment=Lágy meleg ragyogást ad a tereptárgyakhoz, amikor a nap közelébe nézünk (Mie előreszórás).

option.SUNRISE_GLOW=Fokozott napkelte/napnyugta ragyogás
option.SUNRISE_GLOW.comment=Erősebb meleg visszaszórást tesz lehetővé, amely körbefonja az alacsony naptól elforduló felületeket.

# ==============================================================================
# Extended shadow settings
# ==============================================================================
option.shadowDistance=Árnyéktávolság
option.shadowDistance.comment=A maximális távolság, ameddig a dinamikus árnyékok renderelődnek. Nagyobb értékek kiterjesztik az árnyékokat a renderelési távolságig; használja a Shadow LOD-ot a teljesítmény fenntartásához kiterjesztett tartományokban.
value.shadowDistance.60.0=Közel (60m)
value.shadowDistance.80.0=Szabványos (80 m)
value.shadowDistance.120.0=Távol (120m)
value.shadowDistance.160.0=Ultra (160 m)
value.shadowDistance.256.0=Kiterjesztett (256 m)
value.shadowDistance.384.0=Renderelési távolság (384 m)
value.shadowDistance.192.0=DH Seam (192m)
value.shadowDistance.512.0=DH Extended (512m)
value.shadowDistance.768.0=DH Far (768m)

option.SHADOW_LOD=Árnyék LOD
option.SHADOW_LOD.comment=Az árnyékok minőségromlását szabályozza a távolsággal. Kiterjesztett árnyéktávolságnál (256-384 m) a LOD csökkenti a minták számát és növeli a szűrő sugarát a távolban a teljesítmény fenntartása érdekében. Kikapcsolva = egyenletes minőség (lassú). Kiegyensúlyozott = csökkentés 25-50% távolságnál. Agresszív = maximális csökkentés 15-60% távolságnál. Az árnyékok a renderelési távolság 95%-án túl teljesen kimaradnak.
value.SHADOW_LOD.0=Kikapcsolva (egyenletes minőség)
value.SHADOW_LOD.1=Kiegyensúlyozott
value.SHADOW_LOD.2=Agresszív
option.DH_SHADOW_RANGE=Distant Horizons Shadow Range
option.DH_SHADOW_RANGE.comment=Maximum range where Distant Horizons LOD terrain and water can receive samples from the shared DH shadow map. Seam keeps shadows close to vanilla chunks; Far extends coverage but can cost more GPU time. No effect without Distant Horizons.
value.DH_SHADOW_RANGE.1=Seam (1.25x)
value.DH_SHADOW_RANGE.2=Extended (2x)
value.DH_SHADOW_RANGE.3=Far (4x)
option.SHADOW_PCSS_BLUR=PCSS távolsági elmosás
option.SHADOW_PCSS_BLUR.comment=Engedélyezi a PCSS félárnyék-lágyítást, amely növeli az árnyékok elmosását a távolsággal és esőben. Kapcsolja ki a fix lágysághoz (élesebb távoli árnyékok, kevésbé valósághű).
value.SHADOW_PCSS_BLUR.0=Kikapcsolva (rögzített lágyság)
value.SHADOW_PCSS_BLUR.1=Bekapcsolva (PCSS félárnyék)


option.AMBIENT_BRIGHTNESS=Árnyékemelés / ambiens
option.AMBIENT_BRIGHTNESS.comment=Szabályozza, mennyire sötétnek tűnnek az árnyékos területek éjszaka és barlangokban.
value.AMBIENT_BRIGHTNESS.1=Sötét
value.AMBIENT_BRIGHTNESS.2=Alap
value.AMBIENT_BRIGHTNESS.3=Emelt (Fényes)

option.SHADOW_TINT=Árnyék árnyalata
option.SHADOW_TINT.comment=Színezi a nappali árnyékokat. A valós árnyékok kék ég alatt enyhén hideg árnyalatúak.
value.SHADOW_TINT.1=Semleges szürke
value.SHADOW_TINT.2=Hideg kék (Reális)
value.SHADOW_TINT.3=Meleg

option.LIGHT_WRAP=Fényburkolás
option.LIGHT_WRAP.comment=Lágyítja a megvilágított és nem megvilágított felületek közötti terminátort. Reális = fizikai Lambert; Lágy = kellemes képernyőképekhez.
value.LIGHT_WRAP.1=Reális (Lambert)
value.LIGHT_WRAP.2=Lágy burkolás
value.LIGHT_WRAP.3=Stilizált

# v0.2.9 — water/underwater option value labels (English fallback)
value.WATER_WAVE_SCALE.1=Nyugodt
value.WATER_WAVE_SCALE.2=Alap
value.WATER_WAVE_SCALE.3=Hullámzó
value.WATER_WAVE_SCALE.4=Viharos
value.WATER_WAVE_DETAIL.1=Durva
value.WATER_WAVE_DETAIL.2=Alap
value.WATER_WAVE_DETAIL.3=Sűrű
value.UNDERWATER_NIGHT_DARKNESS.1=Holdfényes tó
value.UNDERWATER_NIGHT_DARKNESS.2=Halvány
value.UNDERWATER_NIGHT_DARKNESS.3=Valódi éjszaka
value.UNDERWATER_NIGHT_DARKNESS.4=Koromsötét
# ==============================================================================
# Experimental Tab & New Sky (v1.1.0)
# ==============================================================================
screen.EXPERIMENTAL=Kísérleti
screen.EXPERIMENTAL.comment=Kísérleti

screen.ATMOSPHERE_OPTIONS=Atmosphere
screen.ATMOSPHERE_OPTIONS.comment=Physical-sky scattering, altitude and temporal resolve controls.
option.ATMOSPHERE_TURBIDITY=Atmospheric Turbidity
option.ATMOSPHERE_TURBIDITY.comment=Controls aerosol haze in Physical Sky. Crisp gives a deep blue sky; Hazy gives a brighter, softer horizon and stronger forward scatter.
value.ATMOSPHERE_TURBIDITY.1=Crisp
value.ATMOSPHERE_TURBIDITY.2=Balanced
value.ATMOSPHERE_TURBIDITY.3=Hazy
option.ATMOSPHERE_SCALE=Atmosphere Scale
option.ATMOSPHERE_SCALE.comment=Converts Minecraft altitude into atmosphere height for Physical Sky. Compact makes mountains affect the sky less; Cinematic preserves the original large-scale altitude effect.
value.ATMOSPHERE_SCALE.1=Compact (25m/block)
value.ATMOSPHERE_SCALE.2=Balanced (50m/block)
value.ATMOSPHERE_SCALE.3=Cinematic (100m/block)
option.GROUND_BOUNCE_MODE=Ground Bounce Albedo
option.GROUND_BOUNCE_MODE.comment=Controls the lower-atmosphere ground-bounce colour in Physical Sky. Auto adapts to cold and swamp biome signals.
value.GROUND_BOUNCE_MODE.0=Auto (Biome-aware)
value.GROUND_BOUNCE_MODE.1=Neutral Soil
value.GROUND_BOUNCE_MODE.2=Vegetation
value.GROUND_BOUNCE_MODE.3=Snow
value.GROUND_BOUNCE_MODE.4=Desert
option.SKY_TEMPORAL=Physical Sky Temporal Resolve
option.SKY_TEMPORAL.comment=Uses rotation-only history blending for Physical Sky to smooth low-sample scattering and horizon gradients. Disable if animated cloud/aurora ghosting is noticeable.
option.SKY_MODE=Új égbolt (Légköri szórás)
option.SKY_STYLE=Égbolt stílusa
option.SKY_STYLE.comment=A fizikai égbolt művészi iránya. Realisztikus = valódi szögméretek és semleges színek (csillagászati megjelenés). Félrealisztikus = olvasható nap/hold (×2,8), gazdagabb színek, lágy ragyogás. Fantázia = nagy nap/hold (×5,5), nagy korona, élénk sötétkék/bíbor/indigó paletta.
