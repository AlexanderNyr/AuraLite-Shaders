option.WATER_SPECULAR_STRENGTH.comment=Past de helderheid van zon-/maanreflecties op de waterrimpels aan.
value.WATER_SPECULAR_STRENGTH.1=Zacht
value.WATER_SPECULAR_STRENGTH.2=Standaard
value.WATER_SPECULAR_STRENGTH.3=Flonkerend
option.SHADOW_SOFTNESS=Schaduwzachtheid
option.SHADOW_SOFTNESS.comment=Regelt hoe zacht en diffuus de schaduwranden eruitzien. Gebruikt geroteerde Poisson disk-filtering voor een gladde penumbra.
value.SHADOW_SOFTNESS.1=Scherp
value.SHADOW_SOFTNESS.2=Zacht
value.SHADOW_SOFTNESS.3=Ultra Zacht

option.SSAO=SSAO / SAO-occlusie
option.SSAO.comment=Extreem profiel: screen-space ambient occlusion voor contactschaduwen in hoeken, onder blokken en rond geometrieovergangen.
option.SSAO_STRENGTH=SSAO-sterkte
option.SSAO_STRENGTH.comment=Regelt de diepte van screen-space ambient occlusion. Alleen actief wanneer SSAO is ingeschakeld.
value.SSAO_STRENGTH.1=Subtiel
value.SSAO_STRENGTH.2=Gebalanceerd
value.SSAO_STRENGTH.3=Diep

option.CLOUD_DISTANCE=Wolkweergaveafstand
option.CLOUD_DISTANCE.comment=Maximale weergaveafstand voor volumetrische wolken. Kwaliteitsprofielen verhogen dit automatisch.

option.CLOUD_SHADOWS=Wolkschaduwen
option.CLOUD_SHADOWS.comment=Voegt transparante procedurele schaduwen van volumetrische wolkdichtheid toe aan het terrein. Wordt uitgebalanceerd door kwaliteitsprofielen.
option.CLOUD_SHADOW_STRENGTH=Wolkschaduwsterkte
option.CLOUD_SHADOW_STRENGTH.comment=Regelt hoe zichtbaar en dramatisch de transparante wolkschaduwen zijn.
value.CLOUD_SHADOW_STRENGTH.1=Zacht
value.CLOUD_SHADOW_STRENGTH.2=Gebalanceerd
value.CLOUD_SHADOW_STRENGTH.3=Dramatisch

option.GODRAYS=Godrays / Zonnestralen
option.GODRAYS.comment=Adds realistic screen-space sun shafts through sky gaps and behind geometry.
option.GODRAYS_QUALITY=Godrays-kwaliteit
option.GODRAYS_QUALITY.comment=Controls sample count and cost of godrays.
value.GODRAYS_QUALITY.1=Snel
value.GODRAYS_QUALITY.2=Gebalanceerd
value.GODRAYS_QUALITY.3=Hoog

# ==============================================================================
# Zon en Maan (uitgebreide belichting)
# ==============================================================================
screen.SUN_MOON=Zon en Maan
screen.SUN_MOON.comment=Fijnafstemming van zon- & maanintensiteit, kleurtemperatuur en atmosferische effecten.
option.SUN_INTENSITY=Zonintensiteit
option.SUN_INTENSITY.comment=Hoofdhelderheid van direct zonlicht. Hoger = sterker daglichtcontrast.
value.SUN_INTENSITY.1=Dof
value.SUN_INTENSITY.2=Standaard
value.SUN_INTENSITY.3=Helder
value.SUN_INTENSITY.4=Vlammend
option.MOON_INTENSITY=Maanintensiteit
option.MOON_INTENSITY.comment=Hoofdhelderheid van maanlicht. Hoger = helderdere, beter zichtbare nachten.
value.MOON_INTENSITY.1=Pikdonkere Nacht
value.MOON_INTENSITY.2=Standaard
value.MOON_INTENSITY.3=Heldere Maan
value.MOON_INTENSITY.4=Volle Nacht
option.SUN_TEMPERATURE=Zonkleurtemperatuur
option.SUN_TEMPERATURE.comment=Verschuift de Kelvin-curve van de zon. Realistisch gebruikt Tanner Helland zwart lichaam; warm = goud; koel = neutraal wit.
value.SUN_TEMPERATURE.1=Koel / Neutraal
value.SUN_TEMPERATURE.2=Realistisch
value.SUN_TEMPERATURE.3=Warm Goud
option.MOON_TEMPERATURE=Maankleurtemperatuur
option.MOON_TEMPERATURE.comment=Tint van het maanlicht. IJzig = blauwachtig koud; Zilver = realistisch 4100K; Warm = oogstmaan-crème.
value.MOON_TEMPERATURE.1=IJzig Blauw
value.MOON_TEMPERATURE.2=Zilver (Realistisch)
value.MOON_TEMPERATURE.3=Warm Crème
option.SUN_HALO=Zonhalo (Mie-verstrooiing)
option.SUN_HALO.comment=Voegt een zachte warme gloed toe aan het terrein bij het kijken in de buurt van de zon (Mie-voorwaartse verstrooiing).
option.SUNRISE_GLOW=Verbeterde Zonsopgang/Zonsondergang-gloed
option.SUNRISE_GLOW.comment=Schakelt sterkere warme terugverstrooiing in die om oppervlakken heen wikkelt die van de lage zon afgekeerd zijn.

# ==============================================================================
# Uitgebreide schaduwinstellingen
# ==============================================================================
option.shadowDistance=Schaduwafstand
option.shadowDistance.comment=Maximale afstand waarop dynamische schaduwen worden gerenderd. Hogere waarden breiden schaduwen uit tot render-afstand; gebruik Shadow LOD om prestaties te behouden bij uitgebreide bereiken.
value.shadowDistance.60.0=Dichtbij (60m)
value.shadowDistance.80.0=Standaard (80m)
value.shadowDistance.120.0=Ver (120m)
value.shadowDistance.160.0=Ultra (160 m)
value.shadowDistance.256.0=Uitgebreid (256 m)
value.shadowDistance.384.0=Render-afstand (384 m)
value.shadowDistance.192.0=DH Seam (192m)
value.shadowDistance.512.0=DH Extended (512m)
value.shadowDistance.768.0=DH Far (768m)

option.SHADOW_LOD=Schaduw-LOD
option.SHADOW_LOD.comment=Bepaalt kwaliteitsverlaging van schaduwen met afstand. Bij uitgebreide schaduwafstand (256-384 m) vermindert LOD het aantal monsters en vergroot de filterradius op afstand om prestaties te behouden. Uit = uniforme kwaliteit (langzaam). Gebalanceerd = reductie op 25-50% afstand. Agressief = maximale reductie op 15-60% afstand. Schaduwen worden volledig overgeslagen voorbij 95% van de render-afstand.
value.SHADOW_LOD.0=Uit (uniforme kwaliteit)
value.SHADOW_LOD.1=Gebalanceerd
value.SHADOW_LOD.2=Agressief
option.DH_SHADOW_RANGE=Distant Horizons Shadow Range
option.DH_SHADOW_RANGE.comment=Maximum range where Distant Horizons LOD terrain and water can receive samples from the shared DH shadow map. Seam keeps shadows close to vanilla chunks; Far extends coverage but can cost more GPU time. No effect without Distant Horizons.
value.DH_SHADOW_RANGE.1=Seam (1.25x)
value.DH_SHADOW_RANGE.2=Extended (2x)
value.DH_SHADOW_RANGE.3=Far (4x)
option.SHADOW_PCSS_BLUR=PCSS-afstandsvervaging
option.SHADOW_PCSS_BLUR.comment=Schakelt PCSS-penumbra-verzachting in die schaduwvervaging vergroot met afstand en tijdens regen. Uitschakelen voor vaste zachtheid (scherpere verre schaduwen, minder realistisch).
value.SHADOW_PCSS_BLUR.0=Uit (vaste zachtheid)
value.SHADOW_PCSS_BLUR.1=Aan (PCSS-penumbra)

option.AMBIENT_BRIGHTNESS=Schaduwoplichting / Omgeving
option.AMBIENT_BRIGHTNESS.comment=Regelt hoe donker beschaduwde gebieden eruitzien in de nacht en in grotten.
value.AMBIENT_BRIGHTNESS.1=Donker
value.AMBIENT_BRIGHTNESS.2=Standaard
value.AMBIENT_BRIGHTNESS.3=Opgelicht (Helder)
option.SHADOW_TINT=Schaduwtint
option.SHADOW_TINT.comment=Tint dagschaduwen. Schaduwen in de echte wereld onder een blauwe hemel hebben een subtiele koele tint.
value.SHADOW_TINT.1=Neutraal Grijs
value.SHADOW_TINT.2=Koel Blauw (Realistisch)
value.SHADOW_TINT.3=Warm
option.LIGHT_WRAP=Lichtomhulling
option.LIGHT_WRAP.comment=Verzacht de terminator tussen verlichte en onverlichte oppervlakken. Realistisch = fysieke Lambert; Zacht = aangenaam voor screenshots.
value.LIGHT_WRAP.1=Realistisch (Lambert)
value.LIGHT_WRAP.2=Zachte Omhulling
value.LIGHT_WRAP.3=Gestileerd

