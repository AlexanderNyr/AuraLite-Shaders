value.SKY_QUALITY.2=Standaard
value.SKY_QUALITY.3=Hoog

# --- Auto-added missing translations (v1.1.0 sync) ---
option.FOLIAGE_SSS=Gebladerte-SSS
option.FOLIAGE_SSS.comment=Schakelt subsurface scattering (doorschijnendheid) in voor bladeren, gras en planten bij tegenlicht.
option.GODRAYS_STRENGTH=Godrays-intensiteit
option.GODRAYS_STRENGTH.comment=Helderheid van de volumetrische lichtstralen. Subtiel: zachte atmosferische nevel. Gebalanceerd: duidelijk zichtbare stralen. Dramatisch: gedurfde cinematische stralen.
value.GODRAYS_STRENGTH.1=Subtiel
value.GODRAYS_STRENGTH.2=Gebalanceerd
value.GODRAYS_STRENGTH.3=Dramatisch
option.SHOOTING_STARS=Meteoren (Vallende Sterren)
option.SHOOTING_STARS.comment=Fysiek gebaseerde meteoren die de mesosfeer binnenkomen (~80-120 km). Rendert echte grootcirkel-3D-bogen met ablatie-lichtcurves, zwart-lichaam plasmakleur (3500-5500 K), Rayleigh-extinctie bij de horizon en aanhoudende ionisatiesporen op vuurbollen.
option.SHOOTING_STARS_FREQUENCY=Meteoractiviteit (ZHR)
option.SHOOTING_STARS_FREQUENCY.comment=Geschatte Zenithal Hourly Rate. Sporadisch = realistische achtergrond van ~10 per uur. Actief = milde regen. Storm = piekdichtheid (~100/uur).
value.SHOOTING_STARS_FREQUENCY.1=Sporadisch (~10/uur)
value.SHOOTING_STARS_FREQUENCY.2=Actieve Regen
value.SHOOTING_STARS_FREQUENCY.3=Meteorenstorm
option.SHOOTING_STARS_BRIGHTNESS=Magnitudeschaal
option.SHOOTING_STARS_BRIGHTNESS.comment=Hoofdvermenigvuldiger op de meteor-magnitudeschaal. Zwak = realistisch gemiddelde; Helder = schaalt vuurbollen voor cinematische zichtbaarheid.
value.SHOOTING_STARS_BRIGHTNESS.1=Zwak (Realistisch)
value.SHOOTING_STARS_BRIGHTNESS.2=Standaard
value.SHOOTING_STARS_BRIGHTNESS.3=Heldere Vuurbollen
option.SPATIAL_AA_MODE=Ruimtelijke Anti-Aliasing
