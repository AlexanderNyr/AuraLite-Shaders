# ==============================================================================
# Quality Profiles
# ==============================================================================
profile.VERY_LOW=Rất Thấp
profile.VERY_LOW.comment=FPS tối đa tuyệt đối. Tất cả các tính năng phụ tắt: không bóng, không mây, không PBR, không SSR, không tia sáng. Chỉ render tối thiểu.
profile.LOW=Thấp
profile.MED=Trung bình
profile.HIGH=Cao
profile.ULTRA=Siêu cao
profile.EXTREME=Cực Đại
profile.EXTREME.comment=Tối đa điện ảnh. Tất cả đều tối đa: PBR Phạm vi không giới hạn, bản đồ tông màu nhiếp ảnh (AgX), SSAO sâu nhất, bão sao băng.
profile.CUSTOM=Tùy chỉnh
profile.CUSTOM.comment=Cài đặt tùy chỉnh do người dùng thay đổi.
profile.HIGH.comment=Chất lượng cho người đam mê. Bóng 2048, SSR Cân bằng, TAA, SSAO Tinh tế, tia sáng Cân bằng, SMAA.
profile.LOW.comment=Nhẹ nhưng có thể chơi được. Giữ hoạt ảnh tán lá/nước, sao sáng hơn, FXAA, vignette. Không có bóng, mây hoặc PBR.
profile.MED.comment=Điểm ngọt hàng ngày. Bóng 1024, mây, PBR, SSR Nhanh, tia sáng, SSS tán lá, phản chiếu ướt, sương mù, sao băng.
profile.ULTRA.comment=Cao cấp. Bóng 4096, SSR Cao, SSAO Cân bằng, tia sáng Cao, TAA Ổn định, tất cả hiệu ứng bật.

screen.TRANSLATION_NOTICE=⚠ Bản dịch có thể chứa lỗi
screen.TRANSLATION_NOTICE.comment=Một số chuỗi bản dịch có thể không chính xác. Nếu có gì đó trông lạ, hãy so sánh với bản gốc tiếng Anh.

# Screens
screen.LIGHTING=Cài Đặt Ánh Sáng
screen.LIGHTING.comment=Cấu hình bóng đổ, màu sắc ánh sáng và độ sáng.
screen.FOLIAGE=Cài Đặt Cây Cối
screen.FOLIAGE.comment=Cấu hình hoạt ảnh đung đưa cho cỏ và lá cây.
screen.WATER=Cài Đặt Nước
screen.WATER.comment=Cấu hình sóng nước, độ trong suốt và kiểu dáng nước.
screen.CLOUDS_MENU=Bầu Trời & Mây
screen.CLOUDS_MENU.comment=Cấu hình độ cao vật lý, độ dày và kiểu dáng của mây 3D và hiệu ứng bầu trời.
screen.POST_PROCESS=Hậu Xử Lý & Sương Mù
screen.POST_PROCESS.comment=Cấu hình độ phơi sáng, sương mù và hiệu ứng điện ảnh.
screen.POST_FOG=Fog & Image
screen.POST_FOG.comment=Fog density, ground mist, heat shimmer and dithering.

# Options
option.SHADOWS=Bóng Đổ Động
option.SHADOWS.comment=Bật hoặc tắt bóng đổ động mềm mại từ mặt trời và mặt trăng.
option.shadowMapResolution=Độ Phân Giải Bóng Đổ
option.shadowMapResolution.comment=Thay đổi chất lượng bản đồ bóng đổ. Giá trị cao hơn có thể làm giảm hiệu năng.
option.PBR_LIGHTING=Chiếu Sáng PBR (LabPBR)
option.PBR_LIGHTING.comment=Bật kết xuất dựa trên vật lý cho kim loại, độ nhám và bản đồ pháp tuyến 3D (yêu cầu gói tài nguyên PBR).
option.PBR_POM=Nổi Khối 3D (POM)
option.PBR_POM.comment=Bật Parallax Occlusion Mapping dựa trên vật lý cho kết cấu khối 3D. Nên tắt với các gói tài nguyên không tương thích.
option.PBR_STRENGTH=Cường Độ PBR
option.PBR_STRENGTH.comment=Điều khiển độ phản chiếu và độ bóng của bề mặt kim loại PBR.
value.PBR_STRENGTH.1=Nhẹ
value.PBR_STRENGTH.2=Tiêu Chuẩn
value.PBR_STRENGTH.3=Gương
option.LIGHTMAP_WARMTH=Độ Ấm Đuốc
option.LIGHTMAP_WARMTH.comment=Điều chỉnh độ ấm và màu sắc của ánh sáng khối/đuốc.
value.LIGHTMAP_WARMTH.1=Ấm Cúng
value.LIGHTMAP_WARMTH.2=Ấm
value.LIGHTMAP_WARMTH.3=Mạnh
option.WAVING_LEAVES=Lá Đung Đưa
option.WAVING_LEAVES.comment=Bật hoạt ảnh đung đưa nhẹ nhàng cho lá cây.
option.WAVING_GRASS=Cây Cỏ Đung Đưa
option.WAVING_GRASS.comment=Bật hoạt ảnh đung đưa cho cỏ, hoa và cây trồng.
option.WIND_SPEED=Tốc Độ Gió
option.WIND_SPEED.comment=Điều khiển tốc độ đung đưa của lá, cây và sóng nước.
value.WIND_SPEED.1=Nhẹ Nhàng
value.WIND_SPEED.2=Gió Nhẹ
value.WIND_SPEED.3=Cuồng Phong
option.WATER_WAVES=Sóng Nước
option.WATER_WAVES.comment=Bật sóng hình học 3D trên bề mặt nước.
option.WATER_TRANSPARENCY=Độ Đặc Nước
option.WATER_TRANSPARENCY.comment=Điều khiển độ trong và độ mờ của nước.
value.WATER_TRANSPARENCY.1=Trong Suốt
value.WATER_TRANSPARENCY.2=Cân Bằng
value.WATER_TRANSPARENCY.3=Sâu
option.PROCEDURAL_CLOUDS=Mây 3D Thể Tích
option.PROCEDURAL_CLOUDS.comment=Bật mây 3D có thể bay xuyên qua theo vật lý thực tế.
option.CLOUD_HEIGHT=Độ Cao Mây
option.CLOUD_HEIGHT.comment=Đặt độ cao vật lý (mức Y) của tầng mây trong thế giới (theo mét).
option.CLOUD_THICKNESS=Độ Dày Mây
option.CLOUD_THICKNESS.comment=Cấu hình độ dày dọc và thể tích của mây.
option.AURORA_MODE=Cực Quang
option.AURORA_MODE.comment=Điều khiển hiển thị cực quang chảy chân thực trên bầu trời đêm.
value.AURORA_MODE.0=Đã Tắt
value.AURORA_MODE.1=Chỉ ở Vùng Lạnh
value.AURORA_MODE.2=Luôn Bật
option.AURORA_SPEED=Tốc Độ Cực Quang
option.AURORA_SPEED.comment=Điều khiển tốc độ đung đưa và chảy của cực quang.
value.AURORA_SPEED.1=Chậm
value.AURORA_SPEED.2=Tiêu Chuẩn
value.AURORA_SPEED.3=Nhanh
option.AURORA_STRENGTH=Độ Sáng Cực Quang
option.AURORA_STRENGTH.comment=Điều khiển độ sáng rực tổng thể của cực quang.
value.AURORA_STRENGTH.1=Mềm
value.AURORA_STRENGTH.2=Tiêu Chuẩn
value.AURORA_STRENGTH.3=Rực Sáng
option.AURORA_QUALITY=Aurora Quality
option.AURORA_QUALITY.comment=Raymarch steps for Aurora Borealis. Higher settings smooth curtain volume and reduce visible layering; the new centered sampling removes per-pixel grain.
value.AURORA_QUALITY.1=Soft (8 steps)
value.AURORA_QUALITY.2=Balanced (12 steps)
value.AURORA_QUALITY.3=Silky (18 steps)
option.NEBULA_BRIGHTNESS=Độ Sáng Dải Ngân Hà
option.NEBULA_BRIGHTNESS.comment=Điều chỉnh độ sáng rực của tinh vân thiên hà nâu chéo vào ban đêm.
value.NEBULA_BRIGHTNESS.1=Mờ
value.NEBULA_BRIGHTNESS.2=Tiêu Chuẩn
value.NEBULA_BRIGHTNESS.3=Sáng
option.STARS_BRIGHTNESS=Độ Sáng Sao
option.STARS_BRIGHTNESS.comment=Điều khiển độ sáng và ánh lấp lánh của các ngôi sao vào ban đêm.
value.STARS_BRIGHTNESS.1=Mờ
value.STARS_BRIGHTNESS.2=Tiêu Chuẩn
value.STARS_BRIGHTNESS.3=Rực Rỡ
option.STARS_AMOUNT=Mật Độ Sao
option.STARS_AMOUNT.comment=Điều khiển tổng số lượng và mật độ sao trên bầu trời.
value.STARS_AMOUNT.1=Ít
value.STARS_AMOUNT.2=Tiêu Chuẩn
value.STARS_AMOUNT.3=Dày Đặc
option.RAINBOW_STRENGTH=Cường Độ Cầu Vồng
option.RAINBOW_STRENGTH.comment=Cấu hình độ sáng và độ bão hòa màu của cầu vồng sau mưa.
value.RAINBOW_STRENGTH.1=Nhẹ
value.RAINBOW_STRENGTH.2=Cân Bằng
value.RAINBOW_STRENGTH.3=Rực Rỡ
option.COZY_LIGHTS=Đuốc Nhấp Nháy
option.COZY_LIGHTS.comment=Bật hoạt ảnh nhấp nháy ấm áp, ấm cúng theo thời gian thực cho đuốc, lửa trại và đèn lồng.
option.WET_REFLECTIONS=Phản Chiếu Ướt Do Mưa
option.WET_REFLECTIONS.comment=Khi trời mưa, các khối rắn như đất, cỏ và đá trở nên ướt, tối và bóng dưới bầu trời.
option.GROUND_MIST=Sương Mù Mặt Đất Thấp (Y=62-66)
option.GROUND_MIST.comment=Bật lớp sương mù trắng vàng mềm mại vào buổi sáng/tối lướt qua nước và băng vào lúc bình minh và hoàng hôn.
option.FOG_DENSITY_LEVEL=Mật Độ Sương Mù
option.FOG_DENSITY_LEVEL.comment=Điều khiển cường độ của sương mù chân trời khí quyển.
value.FOG_DENSITY_LEVEL.1=Thấp
value.FOG_DENSITY_LEVEL.2=Trung Bình
value.FOG_DENSITY_LEVEL.3=Cao

option.TAA=Khử Răng Cưa Thời Gian (TAA)
option.TAA.comment=Giải quyết theo thời gian với chiếu lại chuyển động và cắt xén lân cận. Giảm hiện tượng nhấp nháy và răng cưa ở các thiết lập cao.
option.TAA_STRENGTH=Cường Độ TAA
option.TAA_STRENGTH.comment=Điều khiển pha trộn lịch sử. Cao hơn ổn định hơn nhưng có thể mềm hơn khi chuyển động.
value.TAA_STRENGTH.1=Nhẹ
value.TAA_STRENGTH.2=Cân Bằng
value.TAA_STRENGTH.3=Ổn Định

option.TAA_JITTER=Rung máy ảnh (TAA)
option.TAA_JITTER.comment=Rung máy ảnh subpixel (Halton) giúp TAA tái tạo chi tiết subpixel. Tắt theo mặc định để hình ảnh hoàn toàn ổn định; Tinh tế trở lên loại bỏ nhấp nháy tần số cao với cái giá là lắc nhẹ theo thời gian. Yêu cầu bật TAA.
value.TAA_JITTER.0=Tắt
value.TAA_JITTER.1=Tinh tế
value.TAA_JITTER.2=Tiêu chuẩn
value.TAA_JITTER.3=Mạnh
option.WATER_RIFFLES=Cường Độ Gợn Nước
option.WATER_RIFFLES.comment=Điều chỉnh cường độ của các gợn sóng nhỏ trên bản đồ pháp tuyến của nước.
value.WATER_RIFFLES.1=Yên Tĩnh
value.WATER_RIFFLES.2=Tiêu Chuẩn
value.WATER_RIFFLES.3=Sóng Gợn
option.WATER_SPECULAR_STRENGTH=Ánh Sáng Phản Chiếu Nước
option.WATER_SPECULAR_STRENGTH.comment=Điều chỉnh độ sáng của phản chiếu mặt trời/mặt trăng trên gợn sóng nước.
value.WATER_SPECULAR_STRENGTH.1=Mềm
value.WATER_SPECULAR_STRENGTH.2=Tiêu Chuẩn
value.WATER_SPECULAR_STRENGTH.3=Lấp Lánh
option.SHADOW_SOFTNESS=Độ Mềm Bóng Đổ
option.SHADOW_SOFTNESS.comment=Điều khiển mức độ mềm mại và khuếch tán của các cạnh bóng đổ. Sử dụng bộ lọc đĩa Poisson xoay để tạo vùng nửa tối mượt mà.
value.SHADOW_SOFTNESS.1=Sắc Nét
value.SHADOW_SOFTNESS.2=Mềm
value.SHADOW_SOFTNESS.3=Cực Mềm

option.SSAO=Che Khuất SSAO / SAO
option.SSAO.comment=Hồ sơ Cực đoan: che khuất môi trường trong không gian màn hình cho bóng tiếp xúc ở góc, dưới khối và xung quanh các giao điểm hình học.
option.SSAO_STRENGTH=Cường Độ SSAO
option.SSAO_STRENGTH.comment=Điều khiển độ sâu của hiệu ứng che khuất môi trường không gian màn hình. Chỉ hoạt động khi SSAO được bật.
value.SSAO_STRENGTH.1=Nhẹ
value.SSAO_STRENGTH.2=Cân Bằng
value.SSAO_STRENGTH.3=Sâu

option.CLOUD_DISTANCE=Khoảng Cách Hiển Thị Mây
option.CLOUD_DISTANCE.comment=Khoảng cách vẽ tối đa cho mây thể tích. Hồ sơ chất lượng sẽ tự động tăng giá trị này.

option.CLOUD_SHADOWS=Bóng Mây
option.CLOUD_SHADOWS.comment=Thêm bóng đổ thủ tục trong suốt từ mật độ mây thể tích lên địa hình. Được cân bằng bởi hồ sơ chất lượng.
option.CLOUD_SHADOW_STRENGTH=Cường Độ Bóng Mây
option.CLOUD_SHADOW_STRENGTH.comment=Điều khiển mức độ rõ ràng và kịch tính của bóng mây trong suốt.
value.CLOUD_SHADOW_STRENGTH.1=Mềm
value.CLOUD_SHADOW_STRENGTH.2=Cân Bằng
value.CLOUD_SHADOW_STRENGTH.3=Kịch Tính

option.GODRAYS=Tia Sáng Godrays
option.GODRAYS.comment=Adds realistic screen-space sun shafts through sky gaps and behind geometry.
option.GODRAYS_QUALITY=Chất Lượng Godrays
option.GODRAYS_QUALITY.comment=Controls sample count and cost of godrays.
value.GODRAYS_QUALITY.1=Nhanh
value.GODRAYS_QUALITY.2=Cân Bằng
value.GODRAYS_QUALITY.3=Cao

# ==============================================================================
# Sun & Moon (extended lighting)
# ==============================================================================
screen.SUN_MOON=Mặt Trời & Mặt Trăng
screen.SUN_MOON.comment=Tinh chỉnh cường độ mặt trời & mặt trăng, nhiệt độ màu và hiệu ứng khí quyển.
option.SUN_INTENSITY=Cường Độ Mặt Trời
option.SUN_INTENSITY.comment=Độ sáng chính của ánh sáng mặt trời trực tiếp. Cao hơn = tương phản ban ngày mạnh hơn.
value.SUN_INTENSITY.1=Mờ
value.SUN_INTENSITY.2=Tiêu Chuẩn
value.SUN_INTENSITY.3=Sáng
value.SUN_INTENSITY.4=Rực Cháy
option.MOON_INTENSITY=Cường Độ Mặt Trăng
option.MOON_INTENSITY.comment=Độ sáng chính của ánh trăng. Cao hơn = ban đêm sáng hơn, dễ nhìn hơn.
value.MOON_INTENSITY.1=Đêm Tối Đen
value.MOON_INTENSITY.2=Tiêu Chuẩn
value.MOON_INTENSITY.3=Trăng Sáng
value.MOON_INTENSITY.4=Đêm Trọn Vẹn
option.SUN_TEMPERATURE=Nhiệt Độ Màu Mặt Trời
option.SUN_TEMPERATURE.comment=Dịch chuyển đường cong Kelvin của mặt trời. Thực tế sử dụng vật đen Tanner Helland; ấm = vàng kim; lạnh = trắng trung tính.
value.SUN_TEMPERATURE.1=Lạnh / Trung Tính
value.SUN_TEMPERATURE.2=Thực Tế
value.SUN_TEMPERATURE.3=Vàng Ấm
option.MOON_TEMPERATURE=Nhiệt Độ Màu Mặt Trăng
option.MOON_TEMPERATURE.comment=Sắc thái của ánh trăng. Băng giá = lạnh ánh xanh; Bạc = thực tế 4100K; Ấm = kem trăng mùa gặt.
value.MOON_TEMPERATURE.1=Xanh Băng
value.MOON_TEMPERATURE.2=Bạc (Thực Tế)
value.MOON_TEMPERATURE.3=Kem Ấm
option.SUN_HALO=Quầng Mặt Trời (Tán Xạ Mie)
option.SUN_HALO.comment=Thêm ánh sáng ấm áp dịu nhẹ trên địa hình khi nhìn gần mặt trời (tán xạ Mie thuận).
option.SUNRISE_GLOW=Ánh Sáng Bình Minh/Hoàng Hôn Nâng Cao
option.SUNRISE_GLOW.comment=Bật hiệu ứng tán xạ ngược ấm mạnh hơn bao quanh các bề mặt quay lưng khỏi mặt trời thấp.

# ==============================================================================
# Extended shadow settings
# ==============================================================================
option.shadowDistance=Khoảng Cách Bóng Đổ
option.shadowDistance.comment=Khoảng cách tối đa mà bóng động được render. Giá trị cao hơn mở rộng bóng đến khoảng cách render; sử dụng Shadow LOD để duy trì hiệu suất ở phạm vi mở rộng.
value.shadowDistance.60.0=Gần (60m)
value.shadowDistance.80.0=Tiêu Chuẩn (80m)
value.shadowDistance.120.0=Xa (120m)
value.shadowDistance.160.0=Siêu (160 m)
value.shadowDistance.256.0=Mở rộng (256 m)
value.shadowDistance.384.0=Khoảng cách render (384 m)
value.shadowDistance.192.0=DH Seam (192m)
value.shadowDistance.512.0=DH Extended (512m)
value.shadowDistance.768.0=DH Far (768m)

option.SHADOW_LOD=LOD bóng
option.SHADOW_LOD.comment=Kiểm soát sự suy giảm chất lượng bóng theo khoảng cách. Với khoảng cách bóng mở rộng (256-384 m), LOD giảm số lượng mẫu và tăng bán kính bộ lọc ở khoảng cách xa để duy trì hiệu suất. Tắt = chất lượng đồng đều (chậm). Cân bằng = giảm ở 25-50% khoảng cách. Mạnh = giảm tối đa ở 15-60% khoảng cách. Bóng được bỏ qua hoàn toàn vượt quá 95% khoảng cách render.
value.SHADOW_LOD.0=Tắt (chất lượng đồng đều)
value.SHADOW_LOD.1=Cân bằng
value.SHADOW_LOD.2=Mạnh
option.DH_SHADOW_RANGE=Distant Horizons Shadow Range
option.DH_SHADOW_RANGE.comment=Maximum range where Distant Horizons LOD terrain and water can receive samples from the shared DH shadow map. Seam keeps shadows close to vanilla chunks; Far extends coverage but can cost more GPU time. No effect without Distant Horizons.
value.DH_SHADOW_RANGE.1=Seam (1.25x)
value.DH_SHADOW_RANGE.2=Extended (2x)
value.DH_SHADOW_RANGE.3=Far (4x)
option.SHADOW_PCSS_BLUR=Làm mờ khoảng cách PCSS
option.SHADOW_PCSS_BLUR.comment=Kích hoạt làm mềm penumbra PCSS giúp tăng độ mờ của bóng theo khoảng cách và khi mưa. Tắt để có độ mềm cố định (bóng xa sắc nét hơn, kém chân thực hơn).
value.SHADOW_PCSS_BLUR.0=Tắt (độ mềm cố định)
value.SHADOW_PCSS_BLUR.1=Bật (PCSS penumbra)

option.AMBIENT_BRIGHTNESS=Nâng Bóng / Môi Trường
option.AMBIENT_BRIGHTNESS.comment=Điều khiển mức độ tối của các khu vực bị che bóng vào ban đêm và trong hang động.
value.AMBIENT_BRIGHTNESS.1=Tối
value.AMBIENT_BRIGHTNESS.2=Tiêu Chuẩn
value.AMBIENT_BRIGHTNESS.3=Nâng Cao (Sáng)
option.SHADOW_TINT=Sắc Thái Bóng Đổ
option.SHADOW_TINT.comment=Tô màu bóng đổ ban ngày. Bóng đổ ngoài đời thực dưới bầu trời xanh có sắc thái lạnh nhẹ.
value.SHADOW_TINT.1=Xám Trung Tính
