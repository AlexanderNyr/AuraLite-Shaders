value.FOG_DENSITY_LEVEL.1=Matala
value.FOG_DENSITY_LEVEL.2=Keskitaso
value.FOG_DENSITY_LEVEL.3=Korkea

option.TAA=Ajallinen Reunanpehmennys (TAA)
option.TAA.comment=Ajallinen ratkaisu liikkeen uudelleenprojisoinnilla ja naapuriston leikkauksella. Vähentää välkkymistä ja rosoisia reunoja korkeissa esiasetuksissa.
option.TAA_STRENGTH=TAA-voimakkuus
option.TAA_STRENGTH.comment=Hallitsee historian sekoitusta. Korkeampi on vakaampi, mutta voi olla pehmeämpi liikkeen aikana.
value.TAA_STRENGTH.1=Kevyt
value.TAA_STRENGTH.2=Tasapainoinen
value.TAA_STRENGTH.3=Vakaa

option.TAA_JITTER=Kameran tärinä (TAA)
option.TAA_JITTER.comment=Subpikselinen kameran tärinä (Halton), jonka avulla TAA voi rekonstruoida subpikseliyksityiskohtia. Oletuksena pois päältä täysin vakaata kuvaa varten; Hienovarainen ja parempi poistaa korkeataajuisen välkkymisen lievän ajallisen huojunnan hinnalla. Vaatii TAA:n päälle.
value.TAA_JITTER.0=Pois
value.TAA_JITTER.1=Hienovarainen
value.TAA_JITTER.2=Tavallinen
value.TAA_JITTER.3=Voimakas
option.WATER_RIFFLES=Veden Väreilyn Voimakkuus
option.WATER_RIFFLES.comment=Säätää veden hienojen normaalikartan väreiden voimakkuutta.
value.WATER_RIFFLES.1=Tyyni
value.WATER_RIFFLES.2=Vakio
value.WATER_RIFFLES.3=Aallokas
option.WATER_SPECULAR_STRENGTH=Veden Kiiltoheijastus
option.WATER_SPECULAR_STRENGTH.comment=Säätää auringon/kuun heijastusten kirkkautta veden väreissä.
value.WATER_SPECULAR_STRENGTH.1=Pehmeä
value.WATER_SPECULAR_STRENGTH.2=Vakio
value.WATER_SPECULAR_STRENGTH.3=Kimalteleva
option.SHADOW_SOFTNESS=Varjon Pehmeys
option.SHADOW_SOFTNESS.comment=Hallitsee kuinka pehmeiltä ja hajanaisilta varjon reunat näyttävät. Käyttää pyöritettyä Poisson-levysuodatusta pehmeän puolivarjon saavuttamiseksi.
value.SHADOW_SOFTNESS.1=Terävä
value.SHADOW_SOFTNESS.2=Pehmeä
value.SHADOW_SOFTNESS.3=Ultrapehmeä

option.SSAO=SSAO / SAO-varjostus
option.SSAO.comment=Extreme-profiili: screen-space ambient occlusion kontaktivarjoille kulmissa, lohkojen alla ja geometrian leikkauspisteissä.
option.SSAO_STRENGTH=SSAO-voimakkuus
option.SSAO_STRENGTH.comment=Hallitsee ruutuavaruuden ympäristövarjostuksen syvyyttä. Aktiivinen vain, kun SSAO on käytössä.
value.SSAO_STRENGTH.1=Hienovarainen
value.SSAO_STRENGTH.2=Tasapainoinen
value.SSAO_STRENGTH.3=Syvä

option.CLOUD_DISTANCE=Pilvien Piirtoetäisyys
option.CLOUD_DISTANCE.comment=Volymetristen pilvien enimmäispiirtoetäisyys. Laatuprofiilit lisäävät sitä automaattisesti.

option.CLOUD_SHADOWS=Pilvien Varjot
option.CLOUD_SHADOWS.comment=Lisää läpinäkyviä proseduraalisia varjoja volymetrisen pilvitiheyden perusteella maastoon. Laatuprofiilit tasapainottavat sitä.
option.CLOUD_SHADOW_STRENGTH=Pilvivarjon Voimakkuus
option.CLOUD_SHADOW_STRENGTH.comment=Hallitsee kuinka näkyviä ja dramaattisia läpinäkyvät pilvivarjot ovat.
value.CLOUD_SHADOW_STRENGTH.1=Pehmeä
value.CLOUD_SHADOW_STRENGTH.2=Tasapainoinen
value.CLOUD_SHADOW_STRENGTH.3=Dramaattinen

option.GODRAYS=Godrays / Auringonsäteet
option.GODRAYS.comment=Adds realistic screen-space sun shafts through sky gaps and behind geometry.
option.GODRAYS_QUALITY=Godrays-laatu
option.GODRAYS_QUALITY.comment=Controls sample count and cost of godrays.
value.GODRAYS_QUALITY.1=Nopea
value.GODRAYS_QUALITY.2=Tasapainoinen
value.GODRAYS_QUALITY.3=Korkea

# ==============================================================================
# Aurinko ja Kuu (laajennettu valaistus)
# ==============================================================================
screen.SUN_MOON=Aurinko ja Kuu
screen.SUN_MOON.comment=Hienosäädä auringon ja kuun voimakkuutta, värilämpötilaa ja ilmakehän efektejä.
option.SUN_INTENSITY=Auringon Voimakkuus
option.SUN_INTENSITY.comment=Suoran auringonvalon pääkirkkaus. Korkeampi = voimakkaampi päiväkontrasti.
value.SUN_INTENSITY.1=Himmeä
value.SUN_INTENSITY.2=Vakio
value.SUN_INTENSITY.3=Kirkas
value.SUN_INTENSITY.4=Hehkuva
option.MOON_INTENSITY=Kuun Voimakkuus
option.MOON_INTENSITY.comment=Kuunvalon pääkirkkaus. Korkeampi = kirkkaammat, näkyvämmät yöt.
value.MOON_INTENSITY.1=Pikimusta Yö
value.MOON_INTENSITY.2=Vakio
value.MOON_INTENSITY.3=Kirkas Kuu
value.MOON_INTENSITY.4=Täysi Yö
option.SUN_TEMPERATURE=Auringon Värilämpötila
option.SUN_TEMPERATURE.comment=Siirtää auringon Kelvin-käyrää. Realistinen käyttää Tanner Hellandin mustaa kappaletta; lämmin = kultainen; viileä = neutraali valkoinen.
value.SUN_TEMPERATURE.1=Viileä / Neutraali
value.SUN_TEMPERATURE.2=Realistinen
value.SUN_TEMPERATURE.3=Lämmin Kultainen
option.MOON_TEMPERATURE=Kuun Värilämpötila
option.MOON_TEMPERATURE.comment=Kuunvalon sävy. Jäinen = sinertävän kylmä; Hopea = realistinen 4100K; Lämmin = sadonkorjuukuun kermainen.
value.MOON_TEMPERATURE.1=Jäinen Sininen
value.MOON_TEMPERATURE.2=Hopea (Realistinen)
value.MOON_TEMPERATURE.3=Lämmin Kermainen
option.SUN_HALO=Auringon Halo (Mie-sironta)
option.SUN_HALO.comment=Lisää pehmeän lämpimän hehkun maastoon katsottaessa lähellä aurinkoa (Mie-eteenpäinsironta).
option.SUNRISE_GLOW=Tehostettu Auringonnousun/-laskun Hehku
option.SUNRISE_GLOW.comment=Ottaa käyttöön voimakkaamman lämpimän takaisinsironnan, joka kietoutuu matalasta auringosta poispäin osoittavien pintojen ympärille.

# ==============================================================================
# Laajennetut varjoasetukset
# ==============================================================================
option.shadowDistance=Varjon Etäisyys
option.shadowDistance.comment=Suurin etäisyys, johon dynaamisia varjoja renderöidään. Suuremmat arvot laajentavat varjot renderöintietäisyyteen; käytä Shadow LOD:ia suorituskyvyn ylläpitämiseen laajennetuilla alueilla.
value.shadowDistance.60.0=Lähellä (60m)
value.shadowDistance.80.0=Vakio (80m)
value.shadowDistance.120.0=Kaukana (120m)
value.shadowDistance.160.0=Ultra (160 m)
value.shadowDistance.256.0=Laajennettu (256 m)
value.shadowDistance.384.0=Renderöintietäisyys (384 m)
value.shadowDistance.192.0=DH Seam (192m)
value.shadowDistance.512.0=DH Extended (512m)
value.shadowDistance.768.0=DH Far (768m)

option.SHADOW_LOD=Varjo-LOD
option.SHADOW_LOD.comment=Hallitsee varjojen laadun heikkenemistä etäisyyden mukana. Laajennetulla varjoetäisyydellä (256-384 m) LOD vähentää näytteiden määrää ja kasvattaa suodattimen sädettä etäällä suorituskyvyn ylläpitämiseksi. Pois = tasainen laatu (hidas). Tasapainotettu = vähennys 25-50% etäisyydellä. Aggressiivinen = maksimaalinen vähennys 15-60% etäisyydellä. Varjot ohitetaan kokonaan 95% renderöintietäisyyden jälkeen.
value.SHADOW_LOD.0=Pois (tasainen laatu)
value.SHADOW_LOD.1=Tasapainotettu
value.SHADOW_LOD.2=Aggressiivinen
option.DH_SHADOW_RANGE=Distant Horizons Shadow Range
option.DH_SHADOW_RANGE.comment=Maximum range where Distant Horizons LOD terrain and water can receive samples from the shared DH shadow map. Seam keeps shadows close to vanilla chunks; Far extends coverage but can cost more GPU time. No effect without Distant Horizons.
value.DH_SHADOW_RANGE.1=Seam (1.25x)
value.DH_SHADOW_RANGE.2=Extended (2x)
value.DH_SHADOW_RANGE.3=Far (4x)
option.SHADOW_PCSS_BLUR=PCSS-etäisyyssumeus
option.SHADOW_PCSS_BLUR.comment=Ottaa käyttöön PCSS-puolivarjostuksen pehmennyksen, joka lisää varjojen sumenemista etäisyyden ja sateen myötä. Poista käytöstä kiinteää pehmeyttä varten (terävämmät kaukaiset varjot, vähemmän realistisia).
value.SHADOW_PCSS_BLUR.0=Pois (kiinteä pehmeys)
value.SHADOW_PCSS_BLUR.1=Päällä (PCSS-puolivarjo)

option.AMBIENT_BRIGHTNESS=Varjon Nosto / Ympäristö
option.AMBIENT_BRIGHTNESS.comment=Hallitsee kuinka pimeiltä varjoisat alueet näyttävät yöllä ja luolissa.
value.AMBIENT_BRIGHTNESS.1=Tumma
value.AMBIENT_BRIGHTNESS.2=Vakio
value.AMBIENT_BRIGHTNESS.3=Kohotettu (Kirkas)
option.SHADOW_TINT=Varjon Sävy
option.SHADOW_TINT.comment=Sävyttää päiväsajan varjot. Todellisen maailman varjot sinisen taivaan alla ovat hienovaraisen viileän sävyisiä.
value.SHADOW_TINT.1=Neutraali Harmaa
value.SHADOW_TINT.2=Viileä Sininen (Realistinen)
value.SHADOW_TINT.3=Lämmin
option.LIGHT_WRAP=Valon Kietoutuminen
option.LIGHT_WRAP.comment=Pehmentää valaistujen ja valaisemattomien pintojen välistä rajaa. Realistinen = fysikaalinen Lambert; Pehmeä = miellyttävä kuvakaappauksiin.
value.LIGHT_WRAP.1=Realistinen (Lambert)
value.LIGHT_WRAP.2=Pehmeä Kietoutuminen
value.LIGHT_WRAP.3=Tyylitelty

