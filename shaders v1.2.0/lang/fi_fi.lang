value.LIGHTMAP_WARMTH.1=Viihtyisä
value.LIGHTMAP_WARMTH.2=Lämmin
value.LIGHTMAP_WARMTH.3=Voimakas
option.WAVING_LEAVES=Heiluvat Lehdet
option.WAVING_LEAVES.comment=Ota käyttöön puiden lehtien pehmeä heiluntaefekti.
option.WAVING_GRASS=Heiluva Kasvillisuus
option.WAVING_GRASS.comment=Ota käyttöön ruohon, kukkien ja viljelyskasvien heiluntaefektit.
option.WIND_SPEED=Tuulen Nopeus
option.WIND_SPEED.comment=Hallitse lehtien, kasvien ja vesiaaltojen heiluntanopeutta.
