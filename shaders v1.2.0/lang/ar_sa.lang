# ==============================================================================
# Quality Profiles
# ==============================================================================
profile.VERY_LOW=منخفض جدًا
profile.VERY_LOW.comment=أقصى معدل FPS مطلق. جميع الميزات الإضافية معطلة: لا ظلال، لا سحب، لا PBR، لا SSR، لا أشعة الضوء. الحد الأدنى فقط من العرض.
profile.LOW=منخفض
profile.MED=متوسط
profile.HIGH=عالٍ
profile.ULTRA=ألترا
profile.EXTREME=شديد
profile.EXTREME.comment=الحد الأقصى السينمائي. كل شيء في الحد الأقصى: PBR مدى غير محدود، تدرج لوني تصويري (AgX)، SSAO عميق، عواصف شهابية.
profile.CUSTOM=مخصص
profile.CUSTOM.comment=إعدادات مخصصة معدّلة من قبل المستخدم.
profile.HIGH.comment=جودة عالية للهواة. ظلال 2048، SSR متوازن، TAA، SSAO دقيق، أشعة متوازنة، SMAA.
profile.LOW.comment=خفيف وقابل للعب. يحافظ على حركة الأشجار/الماء، نجوم أكثر إشراقًا، FXAA، تأثير vignette. بدون ظلال أو سحب أو PBR.
profile.MED.comment=النقطة المثالية اليومية. ظلال 1024، سحب، PBR، SSR السريع، أشعة الضوء، SSS للأوراق، انعكاسات مبللة، ضباب، شهب.
profile.ULTRA.comment=متطور. ظلال 4096، SSR عالي، SSAO متوازن، أشعة عالية، TAA مستقر، جميع التأثيرات مفعّلة.

screen.TRANSLATION_NOTICE=⚠ قد تحتوي الترجمات على أخطاء
screen.TRANSLATION_NOTICE.comment=قد تكون بعض نصوص الترجمة غير دقيقة. إذا بدا شيء غريبًا، قارنه بالنص الإنجليزي الأصلي.

# Screens
screen.LIGHTING=إعدادات الإضاءة
screen.LIGHTING.comment=قم بتكوين الظلال وألوان الإضاءة والسطوع.
screen.FOLIAGE=إعدادات النباتات
screen.FOLIAGE.comment=قم بتكوين رسوم الاهتزاز المتحركة للعشب والأوراق.
screen.WATER=إعدادات الماء
screen.WATER.comment=قم بتكوين الأمواج والشفافية وتنسيق المياه.
screen.CLOUDS_MENU=السماء والسحب
screen.CLOUDS_MENU.comment=قم بتكوين الارتفاع الفعلي والسُمك ونمط السحب ثلاثية الأبعاد وتأثيرات السماء.
screen.POST_PROCESS=المعالجة اللاحقة والضباب
screen.POST_PROCESS.comment=قم بتكوين التعرض للضوء والضباب والتأثيرات السينمائية.
screen.POST_FOG=Fog & Image
screen.POST_FOG.comment=Fog density, ground mist, heat shimmer and dithering.

# Options
option.SHADOWS=ظلال ديناميكية
option.SHADOWS.comment=تمكين أو تعطيل الظلال الديناميكية الناعمة من الشمس والقمر.
option.shadowMapResolution=دقة الظل
option.shadowMapResolution.comment=غيّر جودة خريطة الظل. قد تؤدي القيم الأعلى إلى تقليل الأداء.
option.PBR_LIGHTING=إضاءة PBR (LabPBR)
option.PBR_LIGHTING.comment=تمكين العرض القائم على الفيزياء للمعادن والخشونة وخرائط الانحدار ثلاثية الأبعاد (يتطلب حزمة موارد PBR).
option.PBR_POM=نقش الكتلة ثلاثي الأبعاد (POM)
option.PBR_POM.comment=تمكين رسم خرائط انسداد المنظور القائم على الفيزياء لأنسجة الكتل ثلاثية الأبعاد. يُنصح بالتعطيل على حزم الموارد غير المتوافقة.
option.PBR_STRENGTH=شدة PBR
option.PBR_STRENGTH.comment=تحكم في الانعكاسية واللمعان للأسطح المعدنية PBR.
value.PBR_STRENGTH.1=خفيف
value.PBR_STRENGTH.2=قياسي
value.PBR_STRENGTH.3=مرآة
option.LIGHTMAP_WARMTH=دفء الشعلة
option.LIGHTMAP_WARMTH.comment=اضبط دفء ولون ضوء الكتلة/الشعلة.
value.LIGHTMAP_WARMTH.1=دافئ ومريح
value.LIGHTMAP_WARMTH.2=دافئ
value.LIGHTMAP_WARMTH.3=شديد
option.WAVING_LEAVES=تمايل الأوراق
option.WAVING_LEAVES.comment=تمكين رسوم متحركة لطيفة لتمايل أوراق الأشجار.
option.WAVING_GRASS=تمايل النباتات
option.WAVING_GRASS.comment=تمكين الرسوم المتحركة المتمايلة للعشب والزهور والمحاصيل.
option.WIND_SPEED=سرعة الرياح
option.WIND_SPEED.comment=تحكم في سرعة تمايل الأوراق والنباتات وأمواج الماء.
value.WIND_SPEED.1=نسيم خفيف
value.WIND_SPEED.2=نسيم
value.WIND_SPEED.3=عاصفة
option.WATER_WAVES=أمواج الماء
option.WATER_WAVES.comment=يفعّل أمواجاً هندسية ثلاثية الأبعاد على سطح الماء.
option.WATER_TRANSPARENCY=كثافة الماء
option.WATER_TRANSPARENCY.comment=يتحكم بشفافية وعتامة الماء.
value.WATER_TRANSPARENCY.1=صافٍ
value.WATER_TRANSPARENCY.2=متوازن
value.WATER_TRANSPARENCY.3=عميق
option.PROCEDURAL_CLOUDS=سحب ثلاثية الأبعاد حجمية
option.PROCEDURAL_CLOUDS.comment=تمكين السحب ثلاثية الأبعاد القابلة للطيران فعليًا والتي يمكن الوصول إليها والطيران خلالها.
option.CLOUD_HEIGHT=ارتفاع السحب
option.CLOUD_HEIGHT.comment=حدد الارتفاع الفعلي (مستوى Y) لطبقة السحب في العالم (بالأمتار).
option.CLOUD_THICKNESS=سُمك السحب
option.CLOUD_THICKNESS.comment=قم بتكوين السُمك الرأسي وحجم السحب.
option.AURORA_MODE=الشفق القطبي
option.AURORA_MODE.comment=تحكم في عرض الشفق القطبي المتدفق الواقعي في سماء الليل.
value.AURORA_MODE.0=معطل
value.AURORA_MODE.1=فقط في المناطق الباردة
value.AURORA_MODE.2=مفعّل دائمًا
option.AURORA_SPEED=سرعة الشفق
option.AURORA_SPEED.comment=تحكم في سرعة تمايل وتدفق الأضواء الشمالية.
value.AURORA_SPEED.1=بطيء
value.AURORA_SPEED.2=قياسي
value.AURORA_SPEED.3=سريع
option.AURORA_STRENGTH=سطوع الشفق
option.AURORA_STRENGTH.comment=تحكم في السطوع العام لتوهج الأضواء الشمالية.
value.AURORA_STRENGTH.1=ناعم
value.AURORA_STRENGTH.2=قياسي
value.AURORA_STRENGTH.3=متوهج
option.AURORA_QUALITY=Aurora Quality
option.AURORA_QUALITY.comment=Raymarch steps for Aurora Borealis. Higher settings smooth curtain volume and reduce visible layering; the new centered sampling removes per-pixel grain.
value.AURORA_QUALITY.1=Soft (8 steps)
value.AURORA_QUALITY.2=Balanced (12 steps)
value.AURORA_QUALITY.3=Silky (18 steps)
option.NEBULA_BRIGHTNESS=سطوع درب التبانة
option.NEBULA_BRIGHTNESS.comment=اضبط سطوع توهج السديم المجري البني القطري ليلاً.
value.NEBULA_BRIGHTNESS.1=خافت
value.NEBULA_BRIGHTNESS.2=قياسي
value.NEBULA_BRIGHTNESS.3=ساطع
option.STARS_BRIGHTNESS=سطوع النجوم
option.STARS_BRIGHTNESS.comment=تحكم في سطوع وتألق توهج النجوم ليلاً.
value.STARS_BRIGHTNESS.1=خافت
value.STARS_BRIGHTNESS.2=قياسي
value.STARS_BRIGHTNESS.3=لامع
option.STARS_AMOUNT=كثافة النجوم
option.STARS_AMOUNT.comment=تحكم في الكمية الإجمالية وكثافة النجوم في السماء.
value.STARS_AMOUNT.1=قليل
value.STARS_AMOUNT.2=قياسي
value.STARS_AMOUNT.3=كثيف
option.RAINBOW_STRENGTH=شدة قوس قزح
option.RAINBOW_STRENGTH.comment=قم بتكوين سطوع وتشبع لون قوس قزح بعد المطر.
value.RAINBOW_STRENGTH.1=خفيف
value.RAINBOW_STRENGTH.2=متوازن
value.RAINBOW_STRENGTH.3=زاهٍ
option.COZY_LIGHTS=وميض الشعلة
option.COZY_LIGHTS.comment=تمكين رسوم متحركة دافئة ومريحة في الوقت الفعلي للشعلات ونيران المخيمات والفوانيس.
option.WET_REFLECTIONS=انعكاسات رطوبة المطر
option.WET_REFLECTIONS.comment=عند هطول المطر، تصبح الكتل الصلبة مثل الأرض والعشب والحجر مبللة وداكنة ولامعة تحت السماء.
option.GROUND_MIST=ضباب أرضي منخفض (Y=62-66)
option.GROUND_MIST.comment=تمكين طبقات ضباب صباحية/مسائية ناعمة بيضاء ذهبية تنزلق فوق الماء والجليد عند الفجر والغسق.
option.FOG_DENSITY_LEVEL=كثافة الضباب
option.FOG_DENSITY_LEVEL.comment=تحكم في قوة ضباب الأفق الجوي.
value.FOG_DENSITY_LEVEL.1=منخفض
value.FOG_DENSITY_LEVEL.2=متوسط
value.FOG_DENSITY_LEVEL.3=عالٍ

option.TAA=مضاد التعرج الزمني (TAA)
option.TAA.comment=حل زمني مع إعادة إسقاط الحركة وقص الجوار. يقلل من الوميض والحواف المسننة في الإعدادات المسبقة العالية.
option.TAA_STRENGTH=قوة TAA
option.TAA_STRENGTH.comment=يتحكم في مزج السجل. الأعلى أكثر استقرارًا ولكن يمكن أن يكون أكثر نعومة أثناء الحركة.
value.TAA_STRENGTH.1=خفيف
value.TAA_STRENGTH.2=متوازن
value.TAA_STRENGTH.3=مستقر

option.TAA_JITTER=اهتزاز الكاميرا (TAA)
option.TAA_JITTER.comment=اهتزاز كاميرا دون بكسل (Halton) يسمح لـ TAA بإعادة بناء التفاصيل دون البكسل. معطّل افتراضيًا لصورة مستقرة تمامًا؛ الخفيف وما فوق يزيل الوميض عالي التردد مقابل تمايل زمني طفيف. يتطلب تفعيل TAA.
value.TAA_JITTER.0=إيقاف
value.TAA_JITTER.1=خفيف
value.TAA_JITTER.2=قياسي
value.TAA_JITTER.3=قوي
option.WATER_RIFFLES=قوة تموجات الماء
option.WATER_RIFFLES.comment=يضبط شدة التموجات الدقيقة لخريطة الأسطح على الماء.
value.WATER_RIFFLES.1=هادئ
value.WATER_RIFFLES.2=قياسي
value.WATER_RIFFLES.3=مضطرب
option.WATER_SPECULAR_STRENGTH=توهج الماء اللامع
option.WATER_SPECULAR_STRENGTH.comment=يضبط سطوع انعكاسات الشمس/القمر على تموجات الماء.
value.WATER_SPECULAR_STRENGTH.1=ناعم
value.WATER_SPECULAR_STRENGTH.2=قياسي
value.WATER_SPECULAR_STRENGTH.3=لامع
option.SHADOW_SOFTNESS=نعومة الظل
option.SHADOW_SOFTNESS.comment=يتحكم في مدى نعومة وانتشار حواف الظل. يستخدم تصفية قرص بواسون الدوارة لشبه ظل ناعم.
value.SHADOW_SOFTNESS.1=حاد
value.SHADOW_SOFTNESS.2=ناعم
value.SHADOW_SOFTNESS.3=ناعم للغاية

option.SSAO=إخفاء SSAO / SAO
option.SSAO.comment=الملف المتطرف: حجب محيطي في فضاء الشاشة لظلال التلامس في الزوايا وتحت الكتل وعند تقاطعات الهندسة.
option.SSAO_STRENGTH=شدة SSAO
option.SSAO_STRENGTH.comment=يتحكم في عمق إخفاء الإضاءة المحيطة في مساحة الشاشة. نشط فقط عند تمكين SSAO.
value.SSAO_STRENGTH.1=خفيف
value.SSAO_STRENGTH.2=متوازن
value.SSAO_STRENGTH.3=عميق

option.CLOUD_DISTANCE=مسافة عرض السحب
option.CLOUD_DISTANCE.comment=أقصى مسافة رسم للسحب الحجمية. تزيدها ملفات الجودة تلقائيًا.

option.CLOUD_SHADOWS=ظلال السحب
option.CLOUD_SHADOWS.comment=يضيف ظلالاً إجرائية شفافة من كثافة السحب الحجمية على التضاريس. متوازن حسب ملفات الجودة.
option.CLOUD_SHADOW_STRENGTH=شدة ظلال السحب
option.CLOUD_SHADOW_STRENGTH.comment=يتحكم في مدى وضوح وإثارة ظلال السحب الشفافة.
value.CLOUD_SHADOW_STRENGTH.1=ناعم
value.CLOUD_SHADOW_STRENGTH.2=متوازن
value.CLOUD_SHADOW_STRENGTH.3=مثير

option.GODRAYS=أشعة الشمس (Godrays)
option.GODRAYS.comment=Adds realistic screen-space sun shafts through sky gaps and behind geometry.
option.GODRAYS_QUALITY=جودة Godrays
option.GODRAYS_QUALITY.comment=Controls sample count and cost of godrays.
value.GODRAYS_QUALITY.1=سريع
value.GODRAYS_QUALITY.2=متوازن
value.GODRAYS_QUALITY.3=عالٍ

# ==============================================================================
# Sun and Moon (extended lighting)
# ==============================================================================
screen.SUN_MOON=الشمس والقمر
screen.SUN_MOON.comment=اضبط بدقة شدة الشمس والقمر، ودرجة حرارة اللون، والتأثيرات الجوية.
option.SUN_INTENSITY=شدة الشمس
option.SUN_INTENSITY.comment=السطوع الرئيسي لضوء الشمس المباشر. الأعلى = تباين نهاري أقوى.
value.SUN_INTENSITY.1=باهت
value.SUN_INTENSITY.2=قياسي
value.SUN_INTENSITY.3=عالٍ
value.SUN_INTENSITY.4=مشتعل
option.MOON_INTENSITY=شدة القمر
option.MOON_INTENSITY.comment=السطوع الرئيسي لضوء القمر. الأعلى = ليالٍ أكثر سطوعًا ووضوحًا.
value.MOON_INTENSITY.1=ليل حالك
value.MOON_INTENSITY.2=قياسي
value.MOON_INTENSITY.3=قمر ساطع
value.MOON_INTENSITY.4=ليل كامل
option.SUN_TEMPERATURE=درجة حرارة لون الشمس
option.SUN_TEMPERATURE.comment=يحول منحنى كلفن للشمس. يستخدم الواقعي جسمًا أسود تانر هيلاند؛ دافئ = ذهبي؛ بارد = أبيض محايد.
value.SUN_TEMPERATURE.1=بارد / محايد
value.SUN_TEMPERATURE.2=واقعي
value.SUN_TEMPERATURE.3=ذهبي دافئ
option.MOON_TEMPERATURE=درجة حرارة لون القمر
option.MOON_TEMPERATURE.comment=صبغة ضوء القمر. جليدي: بارد مزرق؛ فضي: واقعي 4100 كلفن؛ دافئ: كريمي قمر الحصاد.
value.MOON_TEMPERATURE.1=أزرق جليدي
value.MOON_TEMPERATURE.2=فضي (واقعي)
value.MOON_TEMPERATURE.3=كريمي دافئ
option.SUN_HALO=هالة الشمس (تشتت مي)
option.SUN_HALO.comment=يضيف توهجًا دافئًا ناعمًا على التضاريس عند النظر بالقرب من الشمس (تشتت مي الأمامي).
option.SUNRISE_GLOW=توهج شروق/غروب الشمس المحسّن
option.SUNRISE_GLOW.comment=يمكّن تشتتًا خلفيًا دافئًا أقوى يلتف حول الأسطح البعيدة عن الشمس المنخفضة.

# ==============================================================================
# Extended shadow settings
# ==============================================================================
option.shadowDistance=مسافة الظل
option.shadowDistance.comment=المسافة القصوى التي يتم عندها عرض الظلال الديناميكية. القيم الأعلى تمدد الظلال إلى مسافة العرض؛ استخدم Shadow LOD للحفاظ على الأداء في النطاقات الممتدة.
value.shadowDistance.60.0=قريب (60م)
value.shadowDistance.80.0=قياسي (80م)
value.shadowDistance.120.0=بعيد (120م)
value.shadowDistance.160.0=ألترا (160م)
value.shadowDistance.256.0=موسعة (256 م)
value.shadowDistance.384.0=مسافة العرض (384 م)
value.shadowDistance.192.0=DH Seam (192m)
value.shadowDistance.512.0=DH Extended (512m)
value.shadowDistance.768.0=DH Far (768m)

option.SHADOW_LOD=مستوى تفاصيل الظلال
option.SHADOW_LOD.comment=يتحكم في تدهور جودة الظلال مع المسافة. مع مسافة الظلال الممتدة (256-384 م)، يقلل LOD عدد العينات ويزيد نصف قطر الفلتر في المسافة للحفاظ على الأداء. إيقاف = جودة موحدة (بطيء). متوازن = تخفيض عند 25-50% من المسافة. عدواني = تخفيض أقصى عند 15-60% من المسافة. يتم تخطي الظلال تمامًا بعد 95% من مسافة العرض.
value.SHADOW_LOD.0=إيقاف (جودة موحدة)
value.SHADOW_LOD.1=متوازن
value.SHADOW_LOD.2=عدواني
option.DH_SHADOW_RANGE=Distant Horizons Shadow Range
option.DH_SHADOW_RANGE.comment=Maximum range where Distant Horizons LOD terrain and water can receive samples from the shared DH shadow map. Seam keeps shadows close to vanilla chunks; Far extends coverage but can cost more GPU time. No effect without Distant Horizons.
value.DH_SHADOW_RANGE.1=Seam (1.25x)
value.DH_SHADOW_RANGE.2=Extended (2x)
value.DH_SHADOW_RANGE.3=Far (4x)
option.SHADOW_PCSS_BLUR=ضبابية PCSS بالمسافة
option.SHADOW_PCSS_BLUR.comment=يُمكّن تليين penumbra PCSS الذي يزيد من ضبابية الظلال مع المسافة وأثناء المطر. قم بإيقاف التشغيل للحصول على نعومة ثابتة (ظلال بعيدة أكثر حدة، أقل واقعية).
value.SHADOW_PCSS_BLUR.0=إيقاف (نعومة ثابتة)
value.SHADOW_PCSS_BLUR.1=تشغيل (penumbra PCSS)

option.AMBIENT_BRIGHTNESS=رفع الظل / محيطي
option.AMBIENT_BRIGHTNESS.comment=يتحكم في مدى ظلام المناطق المظللة ليلاً وفي الكهوف.
value.AMBIENT_BRIGHTNESS.1=داكن
value.AMBIENT_BRIGHTNESS.2=قياسي
value.AMBIENT_BRIGHTNESS.3=مرفوع (ساطع)
option.SHADOW_TINT=صبغة الظل
option.SHADOW_TINT.comment=يصبغ ظلال النهار. الظلال في العالم الحقيقي تحت سماء زرقاء لها صبغة باردة خفيفة.
value.SHADOW_TINT.1=رمادي محايد
value.SHADOW_TINT.2=أزرق بارد (واقعي)
value.SHADOW_TINT.3=دافئ
option.LIGHT_WRAP=التفاف الضوء
option.LIGHT_WRAP.comment=يعمل على تنعيم الخط الفاصل بين الأسطح المضاءة وغير المضاءة. واقعي = لامبرت الفيزيائي؛ ناعم = ممتع لقطات الشاشة.
value.LIGHT_WRAP.1=واقعي (لامبرت)
value.LIGHT_WRAP.2=التفاف ناعم
value.LIGHT_WRAP.3=مصمم

# v0.2.9 — water/underwater option value labels (English fallback)
value.WATER_WAVE_SCALE.1=هادئ
value.WATER_WAVE_SCALE.2=قياسي
value.WATER_WAVE_SCALE.3=مضطرب
value.WATER_WAVE_SCALE.4=عاصف
value.WATER_WAVE_DETAIL.1=خشن
value.WATER_WAVE_DETAIL.2=قياسي
value.WATER_WAVE_DETAIL.3=كثيف
