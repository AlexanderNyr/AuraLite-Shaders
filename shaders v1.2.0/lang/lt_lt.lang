value.WATER_WAVE_DETAIL.2=Standartinis
value.WATER_WAVE_DETAIL.3=Tankus
value.UNDERWATER_NIGHT_DARKNESS.1=Mėnulio nutviekstas tvenkinys
value.UNDERWATER_NIGHT_DARKNESS.2=Silpnas
