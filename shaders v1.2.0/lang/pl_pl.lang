# ==============================================================================
# Quality Profiles
# ==============================================================================
profile.VERY_LOW=Bardzo Niski
profile.VERY_LOW.comment=Absolutne maksimum FPS. Wszystkie dodatki wyłączone: bez cieni, chmur, PBR, SSR, promieni. Tylko minimalne renderowanie.
profile.LOW=Niski
profile.MED=Średni
profile.HIGH=Wysoki
profile.ULTRA=Ultra
profile.EXTREME=Ekstremalny
profile.EXTREME.comment=Kinematograficzne maksimum. Wszystko na max: PBR Nieskończony zasięg, fotograficzny mapowanie tonów (AgX), najgłębszy SSAO, burze meteorów.
profile.CUSTOM=Własny
profile.CUSTOM.comment=Niestandardowe ustawienia zmodyfikowane przez użytkownika.
profile.HIGH.comment=Jakość dla entuzjastów. Cienie 2048, SSR Zbalansowane, TAA, SSAO Subtelne, promienie Zbalansowane, SMAA.
profile.LOW.comment=Lekki, ale grywalny. Zachowuje animację liści/wody, jaśniejsze gwiazdy, FXAA, winietę. Bez cieni, chmur i PBR.
profile.MED.comment=Codzienny sweet spot. Cienie 1024, chmury, PBR, SSR Szybki, promienie, SSS liści, mokre odbicia, mgła, meteoryty.
profile.ULTRA.comment=High-end. Cienie 4096, SSR Wysokie, SSAO Zbalansowane, promienie Wysokie, TAA Stabilne, wszystkie efekty włączone.

screen.TRANSLATION_NOTICE=⚠ Tłumaczenia mogą zawierać błędy
screen.TRANSLATION_NOTICE.comment=Niektóre tłumaczenia mogą być niedokładne. Jeśli coś wygląda dziwnie, porównaj z oryginałem w języku angielskim.

# Screens
screen.LIGHTING=Ustawienia Oświetlenia
screen.LIGHTING.comment=Skonfiguruj cienie, kolory światła i jasność.
screen.FOLIAGE=Ustawienia Roślinności
screen.FOLIAGE.comment=Skonfiguruj animacje kołysania trawy i liści.
screen.WATER=Ustawienia Wody
screen.WATER.comment=Skonfiguruj fale, przezroczystość i styl wody.
screen.CLOUDS_MENU=Niebo i Chmury
screen.CLOUDS_MENU.comment=Skonfiguruj fizyczną wysokość, grubość i styl chmur 3D oraz efektów nieba.
screen.POST_PROCESS=Postprocessing i Mgła
screen.POST_PROCESS.comment=Skonfiguruj ekspozycję, mgłę i efekty kinowe.
screen.POST_FOG=Fog & Image
screen.POST_FOG.comment=Fog density, ground mist, heat shimmer and dithering.

# Options
option.SHADOWS=Dynamiczne Cienie
option.SHADOWS.comment=Włącz lub wyłącz miękkie dynamiczne cienie od słońca i księżyca.
option.shadowMapResolution=Rozdzielczość Cieni
option.shadowMapResolution.comment=Zmień jakość mapy cieni. Wyższe wartości mogą obniżyć wydajność.
option.PBR_LIGHTING=Oświetlenie PBR (LabPBR)
option.PBR_LIGHTING.comment=Włącz renderowanie oparte na fizyce dla metali, chropowatości i map normalnych 3D (wymagany pakiet zasobów PBR).
option.PBR_POM=Rzeźba Bloków 3D (POM)
option.PBR_POM.comment=Włącz oparte na fizyce mapowanie okluzji paralaksy dla tekstur bloków 3D. Zalecane wyłączenie przy niekompatybilnych paczkach zasobów.
option.PBR_STRENGTH=Intensywność PBR
option.PBR_STRENGTH.comment=Kontroluj refleksyjność i połysk metalicznych powierzchni PBR.
value.PBR_STRENGTH.1=Subtelna
value.PBR_STRENGTH.2=Standardowa
value.PBR_STRENGTH.3=Lustrzana
option.LIGHTMAP_WARMTH=Ciepło Pochodni
option.LIGHTMAP_WARMTH.comment=Dostosuj ciepło i kolor światła bloków/pochodni.
value.LIGHTMAP_WARMTH.1=Przytulna
value.LIGHTMAP_WARMTH.2=Ciepły
value.LIGHTMAP_WARMTH.3=Intensywna
option.WAVING_LEAVES=Kołyszące się Liście
option.WAVING_LEAVES.comment=Włącz delikatne animacje kołysania liści drzew.
option.WAVING_GRASS=Kołysząca się Roślinność
option.WAVING_GRASS.comment=Włącz animacje kołysania trawy, kwiatów i upraw.
option.WIND_SPEED=Prędkość Wiatru
option.WIND_SPEED.comment=Kontroluj prędkość kołysania liści, roślin i fal wody.
value.WIND_SPEED.1=Łagodny
value.WIND_SPEED.2=Bryza
value.WIND_SPEED.3=Wichura
option.WATER_WAVES=Fale Wody
option.WATER_WAVES.comment=Włącza geometryczne fale 3D na powierzchni wody.
option.WATER_TRANSPARENCY=Gęstość Wody
option.WATER_TRANSPARENCY.comment=Kontroluje przezroczystość i nieprzezroczystość wody.
value.WATER_TRANSPARENCY.1=Przejrzysta
value.WATER_TRANSPARENCY.2=Zrównoważona
value.WATER_TRANSPARENCY.3=Głęboka
option.PROCEDURAL_CLOUDS=Wolumetryczne Chmury 3D
option.PROCEDURAL_CLOUDS.comment=Włącz fizyczne, przelotowe chmury 3D, przez które można przelecieć.
option.CLOUD_HEIGHT=Wysokość Chmur
option.CLOUD_HEIGHT.comment=Ustaw fizyczną wysokość (poziom Y) warstwy chmur w świecie (w metrach).
option.CLOUD_THICKNESS=Grubość Chmur
option.CLOUD_THICKNESS.comment=Skonfiguruj pionową grubość i objętość chmur.
option.AURORA_MODE=Zorza Polarna
option.AURORA_MODE.comment=Kontroluj wyświetlanie realistycznej, płynącej zorzy polarnej na nocnym niebie.
value.AURORA_MODE.0=Wyłączona
value.AURORA_MODE.1=Tylko w Zimnych Biomach
value.AURORA_MODE.2=Zawsze Włączona
option.AURORA_SPEED=Prędkość Zorzy
option.AURORA_SPEED.comment=Kontroluj prędkość falowania i przepływu zorzy polarnej.
value.AURORA_SPEED.1=Wolna
value.AURORA_SPEED.2=Standardowa
value.AURORA_SPEED.3=Szybka
option.AURORA_STRENGTH=Jasność Zorzy
option.AURORA_STRENGTH.comment=Kontroluj ogólną jasność blasku zorzy polarnej.
value.AURORA_STRENGTH.1=Miękka
value.AURORA_STRENGTH.2=Standardowa
value.AURORA_STRENGTH.3=Świecąca
option.AURORA_QUALITY=Aurora Quality
option.AURORA_QUALITY.comment=Raymarch steps for Aurora Borealis. Higher settings smooth curtain volume and reduce visible layering; the new centered sampling removes per-pixel grain.
value.AURORA_QUALITY.1=Soft (8 steps)
value.AURORA_QUALITY.2=Balanced (12 steps)
value.AURORA_QUALITY.3=Silky (18 steps)
option.NEBULA_BRIGHTNESS=Jasność Drogi Mlecznej
option.NEBULA_BRIGHTNESS.comment=Dostosuj jasność blasku ukośnej, brązowawej mgławicy galaktycznej w nocy.
value.NEBULA_BRIGHTNESS.1=Przygaszona
value.NEBULA_BRIGHTNESS.2=Standardowa
value.NEBULA_BRIGHTNESS.3=Jasna
option.STARS_BRIGHTNESS=Jasność Gwiazd
option.STARS_BRIGHTNESS.comment=Kontroluj jasność i mieniący się blask gwiazd w nocy.
value.STARS_BRIGHTNESS.1=Słaba
value.STARS_BRIGHTNESS.2=Standardowa
value.STARS_BRIGHTNESS.3=Olśniewająca
option.STARS_AMOUNT=Gęstość Gwiazd
option.STARS_AMOUNT.comment=Kontroluj ogólną liczbę i gęstość gwiazd na niebie.
value.STARS_AMOUNT.1=Nieliczne
value.STARS_AMOUNT.2=Standardowa
value.STARS_AMOUNT.3=Gęsta
option.RAINBOW_STRENGTH=Intensywność Tęczy
option.RAINBOW_STRENGTH.comment=Skonfiguruj jasność i nasycenie kolorów tęczy po deszczu.
value.RAINBOW_STRENGTH.1=Subtelna
value.RAINBOW_STRENGTH.2=Zrównoważona
value.RAINBOW_STRENGTH.3=Żywa
option.COZY_LIGHTS=Migotanie Pochodni
option.COZY_LIGHTS.comment=Włącz ciepłe, przytulne animacje migotania w czasie rzeczywistym dla pochodni, ognisk i latarni.
option.WET_REFLECTIONS=Odbicia Mokrej Nawierzchni
option.WET_REFLECTIONS.comment=Podczas deszczu bloki takie jak ziemia, trawa i kamień stają się mokre, ciemne i błyszczące pod niebem.
option.GROUND_MIST=Niska Mgła Gruntowa (Y=62-66)
option.GROUND_MIST.comment=Włącz miękkie, złocisto-białe warstwy porannej/wieczornej mgły przesuwające się nad wodą i lodem o świcie i zmierzchu.
option.FOG_DENSITY_LEVEL=Gęstość Mgły
option.FOG_DENSITY_LEVEL.comment=Kontroluj siłę atmosferycznej mgły horyzontu.
value.FOG_DENSITY_LEVEL.1=Niska
value.FOG_DENSITY_LEVEL.2=Średnia
value.FOG_DENSITY_LEVEL.3=Wysoka

option.TAA=Czasowe Wygładzanie Krawędzi (TAA)
option.TAA.comment=Rozwiązanie czasowe z reprojekcją ruchu i przycinaniem sąsiedztwa. Zmniejsza migotanie i postrzępione krawędzie przy wysokich profilach.
option.TAA_STRENGTH=Siła TAA
option.TAA_STRENGTH.comment=Kontroluje mieszanie historii. Wyższe wartości są stabilniejsze, ale mogą być bardziej rozmyte podczas ruchu.
value.TAA_STRENGTH.1=Lekka
value.TAA_STRENGTH.2=Zrównoważona
value.TAA_STRENGTH.3=Stabilna

option.TAA_JITTER=Drganie kamery (TAA)
option.TAA_JITTER.comment=Subpikselowe drganie kamery (Halton), które pozwala TAA odtwarzać subpikselowe detale. Domyślnie wyłączone dla idealnie stabilnego obrazu; Subtilne i wyższe usuwa wysokoczęstotliwościowe migotanie kosztem lekkiego czasowego kołysania. Wymaga włączonego TAA.
value.TAA_JITTER.0=Wyłączone
value.TAA_JITTER.1=Subtilne
value.TAA_JITTER.2=Standardowe
value.TAA_JITTER.3=Mocne
option.WATER_RIFFLES=Siła Zmarszczek Wody
option.WATER_RIFFLES.comment=Dostosowuje intensywność delikatnych zmarszczek mapy normalnych na wodzie.
value.WATER_RIFFLES.1=Spokojna
value.WATER_RIFFLES.2=Standardowa
value.WATER_RIFFLES.3=Wzburzona
option.WATER_SPECULAR_STRENGTH=Blask Odbić Wody
option.WATER_SPECULAR_STRENGTH.comment=Dostosowuje jasność odbić słońca/księżyca na zmarszczkach wody.
value.WATER_SPECULAR_STRENGTH.1=Miękka
value.WATER_SPECULAR_STRENGTH.2=Standardowa
value.WATER_SPECULAR_STRENGTH.3=Migocząca
option.SHADOW_SOFTNESS=Miękkość Cieni
option.SHADOW_SOFTNESS.comment=Kontroluje, jak miękkie i rozproszone są krawędzie cieni. Wykorzystuje obrócone filtrowanie dyskiem Poissona dla gładkiej półcienia.
value.SHADOW_SOFTNESS.1=Ostra
value.SHADOW_SOFTNESS.2=Miękka
value.SHADOW_SOFTNESS.3=Ultra Miękka

option.SSAO=Okluzja SSAO / SAO
option.SSAO.comment=Profil Ekstremalny: screen-space ambient occlusion dla cieni kontaktowych w rogach, pod blokami i wokół przecięć geometrii.
option.SSAO_STRENGTH=Siła SSAO
option.SSAO_STRENGTH.comment=Kontroluje głębię okluzji otoczenia w przestrzeni ekranu. Aktywne tylko przy włączonym SSAO.
value.SSAO_STRENGTH.1=Subtelna
value.SSAO_STRENGTH.2=Zrównoważona
value.SSAO_STRENGTH.3=Głęboka

option.CLOUD_DISTANCE=Zasięg Renderowania Chmur
option.CLOUD_DISTANCE.comment=Maksymalny zasięg rysowania dla chmur wolumetrycznych. Profile jakości zwiększają go automatycznie.

option.CLOUD_SHADOWS=Cienie Chmur
option.CLOUD_SHADOWS.comment=Dodaje przezroczyste, proceduralne cienie z gęstości chmur wolumetrycznych na teren. Zrównoważone przez profile jakości.
option.CLOUD_SHADOW_STRENGTH=Siła Cieni Chmur
option.CLOUD_SHADOW_STRENGTH.comment=Kontroluje, jak widoczne i dramatyczne są przezroczyste cienie chmur.
value.CLOUD_SHADOW_STRENGTH.1=Miękka
value.CLOUD_SHADOW_STRENGTH.2=Zrównoważona
value.CLOUD_SHADOW_STRENGTH.3=Dramatyczna

option.GODRAYS=Godrays / Promienie Słońca
option.GODRAYS.comment=Adds realistic screen-space sun shafts through sky gaps and behind geometry.
option.GODRAYS_QUALITY=Jakość Godrays
option.GODRAYS_QUALITY.comment=Controls sample count and cost of godrays.
value.GODRAYS_QUALITY.1=Szybka
value.GODRAYS_QUALITY.2=Zrównoważona
value.GODRAYS_QUALITY.3=Wysoka

# ==============================================================================
# Sun and Moon lighting (extended)
# ==============================================================================
screen.SUN_MOON=Słońce i Księżyc
screen.SUN_MOON.comment=Precyzyjnie dostosuj intensywność słońca i księżyca, temperaturę barwową oraz efekty atmosferyczne.
option.SUN_INTENSITY=Intensywność Słońca
option.SUN_INTENSITY.comment=Główna jasność bezpośredniego światła słonecznego. Wyższa = silniejszy kontrast w ciągu dnia.
value.SUN_INTENSITY.1=Przygaszona
value.SUN_INTENSITY.2=Standardowa
value.SUN_INTENSITY.3=Jasna
value.SUN_INTENSITY.4=Płonąca
option.MOON_INTENSITY=Intensywność Księżyca
option.MOON_INTENSITY.comment=Główna jasność światła księżyca. Wyższa = jaśniejsze, bardziej widoczne noce.
value.MOON_INTENSITY.1=Nieprzenikniona Noc
value.MOON_INTENSITY.2=Standardowa
value.MOON_INTENSITY.3=Jasny Księżyc
value.MOON_INTENSITY.4=Pełna Noc
option.SUN_TEMPERATURE=Temperatura Barwowa Słońca
option.SUN_TEMPERATURE.comment=Przesuwa krzywą Kelvina słońca. Realistyczna używa ciała doskonale czarnego Tannera Hellanda; ciepła = złota; chłodna = neutralna biel.
value.SUN_TEMPERATURE.1=Chłodna / Neutralna
value.SUN_TEMPERATURE.2=Realistyczna
value.SUN_TEMPERATURE.3=Ciepłe Złoto
option.MOON_TEMPERATURE=Temperatura Barwowa Księżyca
option.MOON_TEMPERATURE.comment=Odcień światła księżyca. Lodowaty = niebieskawy chłód; Srebrny = realistyczne 4100K; Ciepły = kremowy księżyc żniwny.
value.MOON_TEMPERATURE.1=Lodowaty Błękit
value.MOON_TEMPERATURE.2=Srebrny (Realistyczny)
value.MOON_TEMPERATURE.3=Ciepły Kremowy
option.SUN_HALO=Halo Słoneczne (Rozpraszanie Miego)
option.SUN_HALO.comment=Dodaje miękki, ciepły blask na terenie podczas patrzenia w pobliżu słońca (rozpraszanie Miego do przodu).
option.SUNRISE_GLOW=Wzmocniona Poświata Wschodu/Zachodu Słońca
option.SUNRISE_GLOW.comment=Włącza silniejsze, ciepłe rozpraszanie wsteczne, które oplata powierzchnie odwrócone od nisko położonego słońca.

# ==============================================================================
# Rozszerzone ustawienia cieni
# ==============================================================================
option.shadowDistance=Zasięg Cieni
option.shadowDistance.comment=Maksymalna odległość renderowania dynamicznych cieni. Wyższe wartości rozszerzają cienie do odległości renderowania; użyj Shadow LOD, aby utrzymać wydajność przy rozszerzonych zakresach.
value.shadowDistance.60.0=Blisko (60m)
value.shadowDistance.80.0=Standardowa (80m)
value.shadowDistance.120.0=Daleko (120m)
value.shadowDistance.160.0=Ultra (160 m)
value.shadowDistance.256.0=Rozszerzona (256 m)
value.shadowDistance.384.0=Odległość renderowania (384 m)
value.shadowDistance.192.0=DH Seam (192m)
value.shadowDistance.512.0=DH Extended (512m)
value.shadowDistance.768.0=DH Far (768m)

option.SHADOW_LOD=Poziom szczegółowości cieni
option.SHADOW_LOD.comment=Kontroluje degradację jakości cieni wraz z odległością. Przy rozszerzonej odległości cieni (256-384 m), LOD zmniejsza liczbę próbek i zwiększa promień filtra w oddali, aby utrzymać wydajność. Wyłączone = jednolita jakość (wolno). Zbalansowane = redukcja przy 25-50% odległości. Agresywne = maksymalna redukcja przy 15-60% odległości. Cienie są całkowicie pomijane powyżej 95% odległości renderowania.
value.SHADOW_LOD.0=Wyłączone (jednolita jakość)
value.SHADOW_LOD.1=Zbalansowane
value.SHADOW_LOD.2=Agresywne
option.DH_SHADOW_RANGE=Distant Horizons Shadow Range
option.DH_SHADOW_RANGE.comment=Maximum range where Distant Horizons LOD terrain and water can receive samples from the shared DH shadow map. Seam keeps shadows close to vanilla chunks; Far extends coverage but can cost more GPU time. No effect without Distant Horizons.
value.DH_SHADOW_RANGE.1=Seam (1.25x)
value.DH_SHADOW_RANGE.2=Extended (2x)
value.DH_SHADOW_RANGE.3=Far (4x)
option.SHADOW_PCSS_BLUR=Rozmycie PCSS na odległość
option.SHADOW_PCSS_BLUR.comment=Włącza zmiękczanie penumbry PCSS, które zwiększa rozmycie cieni wraz z odległością i podczas deszczu. Wyłącz dla stałej miękkości (bardziej ostre odległe cienie, mniej realistyczne).
value.SHADOW_PCSS_BLUR.0=Wyłączone (stała miękkość)
value.SHADOW_PCSS_BLUR.1=Włączone (penumbra PCSS)

option.AMBIENT_BRIGHTNESS=Rozjaśnienie Cieni / Otoczenie
option.AMBIENT_BRIGHTNESS.comment=Kontroluje, jak ciemne wyglądają zacienione obszary w nocy i w jaskiniach.
value.AMBIENT_BRIGHTNESS.1=Ciemna
value.AMBIENT_BRIGHTNESS.2=Standardowa
value.AMBIENT_BRIGHTNESS.3=Rozjaśniona (Jasna)
option.SHADOW_TINT=Odcień Cienia
option.SHADOW_TINT.comment=Zabarwia cienie w ciągu dnia. Rzeczywiste cienie pod błękitnym niebem mają subtelny chłodny odcień.
value.SHADOW_TINT.1=Neutralna Szarość
value.SHADOW_TINT.2=Chłodny Błękit (Realistyczny)
value.SHADOW_TINT.3=Ciepły
option.LIGHT_WRAP=Owinięcie Światła
option.LIGHT_WRAP.comment=Zmiękcza terminator między powierzchniami oświetlonymi i nieoświetlonymi. Realistyczny = fizyczny Lambert; Miękki = przyjemny do zrzutów ekranu.
value.LIGHT_WRAP.1=Realistyczne (Lambert)
value.LIGHT_WRAP.2=Miękkie Owinięcie
value.LIGHT_WRAP.3=Stylizowane

# v0.2.9 — water/underwater option value labels (English fallback)
value.WATER_WAVE_SCALE.1=Spokojna
value.WATER_WAVE_SCALE.2=Standardowa
value.WATER_WAVE_SCALE.3=Wzburzona
value.WATER_WAVE_SCALE.4=Sztormowa
value.WATER_WAVE_DETAIL.1=Zgrubna
value.WATER_WAVE_DETAIL.2=Standardowa
value.WATER_WAVE_DETAIL.3=Gęsta
value.UNDERWATER_NIGHT_DARKNESS.1=Staw w Blasku Księżyca
value.UNDERWATER_NIGHT_DARKNESS.2=Przyćmiona
value.UNDERWATER_NIGHT_DARKNESS.3=Prawdziwa Noc
value.UNDERWATER_NIGHT_DARKNESS.4=Nieprzenikniona Ciemność
# ==============================================================================
# Experimental Tab & New Sky (v1.1.0)
# ==============================================================================
screen.EXPERIMENTAL=Eksperymentalne
screen.EXPERIMENTAL.comment=Eksperymentalne

screen.ATMOSPHERE_OPTIONS=Atmosphere
screen.ATMOSPHERE_OPTIONS.comment=Physical-sky scattering, altitude and temporal resolve controls.
option.ATMOSPHERE_TURBIDITY=Atmospheric Turbidity
option.ATMOSPHERE_TURBIDITY.comment=Controls aerosol haze in Physical Sky. Crisp gives a deep blue sky; Hazy gives a brighter, softer horizon and stronger forward scatter.
value.ATMOSPHERE_TURBIDITY.1=Crisp
value.ATMOSPHERE_TURBIDITY.2=Balanced
value.ATMOSPHERE_TURBIDITY.3=Hazy
option.ATMOSPHERE_SCALE=Atmosphere Scale
option.ATMOSPHERE_SCALE.comment=Converts Minecraft altitude into atmosphere height for Physical Sky. Compact makes mountains affect the sky less; Cinematic preserves the original large-scale altitude effect.
value.ATMOSPHERE_SCALE.1=Compact (25m/block)
value.ATMOSPHERE_SCALE.2=Balanced (50m/block)
value.ATMOSPHERE_SCALE.3=Cinematic (100m/block)
option.GROUND_BOUNCE_MODE=Ground Bounce Albedo
option.GROUND_BOUNCE_MODE.comment=Controls the lower-atmosphere ground-bounce colour in Physical Sky. Auto adapts to cold and swamp biome signals.
value.GROUND_BOUNCE_MODE.0=Auto (Biome-aware)
value.GROUND_BOUNCE_MODE.1=Neutral Soil
value.GROUND_BOUNCE_MODE.2=Vegetation
value.GROUND_BOUNCE_MODE.3=Snow
value.GROUND_BOUNCE_MODE.4=Desert
option.SKY_TEMPORAL=Physical Sky Temporal Resolve
option.SKY_TEMPORAL.comment=Uses rotation-only history blending for Physical Sky to smooth low-sample scattering and horizon gradients. Disable if animated cloud/aurora ghosting is noticeable.
option.SKY_MODE=Nowe niebo (Rozpraszanie atmosferyczne)
option.SKY_STYLE=Styl Nieba
option.SKY_STYLE.comment=Kierunek artystyczny fizycznego nieba. Realistyczny = prawdziwe rozmiary kątowe i neutralne kolory (astronomiczny wygląd). Półrealistyczny = czytelne słońce/księżyc (×2,8), bogatsze kolory, miękka poświata. Fantasy = duże słońce/księżyc (×5,5), duża korona, żywa paleta morski/karmazyn/indygo.
option.SKY_MODE.comment=EXPERIMENTAL — off in all profiles. Gradient (legacy, default) or Physical realtime scattering with true multiple scattering (Rayleigh+Mie+Ozone, 1st+2nd+3rd order). Enable manually in this tab.
value.SKY_MODE.0=Gradient (Starszy)
value.SKY_STYLE.0=Realistyczna
