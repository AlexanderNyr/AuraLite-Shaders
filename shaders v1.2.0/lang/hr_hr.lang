# ==============================================================================
# Quality Profiles
# ==============================================================================
profile.VERY_LOW=Vrlo nisko
profile.VERY_LOW.comment=Apsolutni FPS maksimum. Sve dodatno isključeno: bez sjena, oblaka, PBR, SSR, svjetlosnih zraka. Samo minimalni prikaz.
profile.LOW=Nisko
profile.LOW.comment=Lagano, ali igrivo. Zadržava animaciju lišća/vode, svjetlije zvijezde, FXAA, vinjetu. Bez sjena, oblaka ili PBR-a.
profile.MED=Srednje
profile.MED.comment=Svakodnevni optimalni. Sjene 1024, oblaci, PBR, SSR Brzi, svjetlosne zrake, SSS lišća, mokri odrazi, magla, meteori.
profile.HIGH=Visoko
profile.HIGH.comment=Kvaliteta za entuzijaste. Sjene 2044, SSR Uravnotežen, TAA, SSAO Suptilan, svjetlosne zrake Uravnotežene, SMAA.
profile.ULTRA=Ultra
profile.ULTRA.comment=Visoka kvaliteta. Sjene 4096, SSR Visoki, SSAO Uravnotežen, svjetlosne zrake Visoke, TAA Stabilan, svi efekti uključeni.
profile.EXTREME=Ekstremno
profile.EXTREME.comment=Kinematografski maksimum. Sve na maksimumu: PBR Neograničeni domet, fotografsko tonsko mapiranje (AgX), najdublji SSAO, meteorske oluje.
profile.CUSTOM=Prilagođeno
profile.CUSTOM.comment=Prilagođene postavke koje je izmijenio korisnik.

screen.TRANSLATION_NOTICE=⚠ Prijevodi mogu sadržavati pogreške
screen.TRANSLATION_NOTICE.comment=Neki lokalizacijski nizovi mogu biti netočni. Ako nešto izgleda čudno, usporedite s engleskim izvornikom.

# Screens
screen.LIGHTING=Postavke osvjetljenja
screen.LIGHTING.comment=Konfigurirajte sjene, boje svjetla i svjetlinu.

screen.FOLIAGE=Postavke vegetacije
screen.FOLIAGE.comment=Konfigurirajte animacije njihanja za travu i lišće.

screen.WATER=Postavke vode
screen.WATER.comment=Konfigurirajte valove, prozirnost i stiliziranje vode.

screen.CLOUDS_MENU=Nebo i oblaci
screen.CLOUDS_MENU.comment=Konfigurirajte fizičku visinu, debljinu i stil 3D oblaka i efekata neba.

screen.POST_PROCESS=Post-obrada i magla
screen.POST_PROCESS.comment=Konfigurirajte ekspoziciju, maglu i filmske efekte.
screen.POST_FOG=Fog & Image
screen.POST_FOG.comment=Fog density, ground mist, heat shimmer and dithering.

# Options
option.SHADOWS=Dinamičke sjene
option.SHADOWS.comment=Omogućite ili onemogućite meke dinamičke sjene od sunca i mjeseca.

option.shadowMapResolution=Rezolucija sjena
option.shadowMapResolution.comment=Promijenite kvalitetu karte sjena. Veće vrijednosti mogu smanjiti performanse.

option.PBR_LIGHTING=PBR osvjetljenje (LabPBR)
option.PBR_LIGHTING.comment=Omogućite fizički temeljeno renderiranje za metale, hrapavost i 3D normalne karte (potreban PBR paket resursa).

option.PBR_POM=3D reljef blokova (POM)
option.PBR_POM.comment=Omogućite fizički temeljeno Parallax Occlusion Mapping za 3D teksture blokova. Preporučuje se onemogućiti kod nekompatibilnih paketa resursa.

option.PBR_STRENGTH=Intenzitet PBR-a
option.PBR_STRENGTH.comment=Kontrolirajte refleksivnost i sjaj metalnih PBR površina.

value.PBR_STRENGTH.1=Suptilno
value.PBR_STRENGTH.2=Standardno
value.PBR_STRENGTH.3=Zrcalno

option.SSAO=SSAO / SAO okluzija
option.SSAO.comment=Extreme profile: screen-space ambient occlusion for contact shadows in corners, under blocks, and around geometry intersections.
option.SSAO_STRENGTH=Snaga SSAO-a
option.SSAO_STRENGTH.comment=Kontrolira dubinu ambijentalne okluzije u prostoru zaslona. Aktivno samo kada je SSAO omogućen.
value.SSAO_STRENGTH.1=Suptilno
value.SSAO_STRENGTH.2=Uravnoteženo
value.SSAO_STRENGTH.3=Duboko

option.LIGHTMAP_WARMTH=Toplina baklje
option.LIGHTMAP_WARMTH.comment=Podesite toplinu i boju svjetla blokova/baklji.

value.LIGHTMAP_WARMTH.1=Ugodno
value.LIGHTMAP_WARMTH.2=Toplo
value.LIGHTMAP_WARMTH.3=Intenzivno

option.WAVING_LEAVES=Njihanje lišća
option.WAVING_LEAVES.comment=Omogućite blage animacije njihanja za lišće drveća.

option.WAVING_GRASS=Njihanje vegetacije
option.WAVING_GRASS.comment=Omogućite animacije njihanja za travu, cvijeće i usjeve.

option.WIND_SPEED=Brzina vjetra
option.WIND_SPEED.comment=Kontrolirajte brzinu njihanja lišća, biljaka i valova vode.

value.WIND_SPEED.1=Blag
value.WIND_SPEED.2=Povjetarac
value.WIND_SPEED.3=Olujni vjetar

option.WATER_WAVES=Valovi vode
option.WATER_WAVES.comment=Enable 3D geometric waves on the water surface.

option.WATER_TRANSPARENCY=Gustoća vode
option.WATER_TRANSPARENCY.comment=Control the transparency and opacity of the water.

value.WATER_TRANSPARENCY.1=Bistro
value.WATER_TRANSPARENCY.2=Uravnoteženo
value.WATER_TRANSPARENCY.3=Duboko

option.PROCEDURAL_CLOUDS=Volumetrijski 3D oblaci
option.PROCEDURAL_CLOUDS.comment=Omogućite fizički prohodne 3D oblake kroz koje se može letjeti.

option.CLOUD_HEIGHT=Visina oblaka
option.CLOUD_HEIGHT.comment=Postavite fizičku visinu (Y-razina) sloja oblaka u svijetu (u metrima).


option.CLOUD_THICKNESS=Debljina oblaka
option.CLOUD_THICKNESS.comment=Konfigurirajte vertikalnu debljinu i volumen oblaka.


option.CLOUD_DISTANCE=Udaljenost renderiranja oblaka
option.CLOUD_DISTANCE.comment=Maksimalna udaljenost iscrtavanja za volumetrijske oblake. Profili kvalitete je automatski povećavaju.

option.CLOUD_SHADOWS=Sjene oblaka
option.CLOUD_SHADOWS.comment=Dodaje prozirne proceduralne sjene iz gustoće volumetrijskih oblaka na teren. Uravnoteženo profilima kvalitete.
option.CLOUD_SHADOW_STRENGTH=Snaga sjena oblaka
option.CLOUD_SHADOW_STRENGTH.comment=Kontrolira koliko su vidljive i dramatične prozirne sjene oblaka.
value.CLOUD_SHADOW_STRENGTH.1=Mekano
value.CLOUD_SHADOW_STRENGTH.2=Uravnoteženo
value.CLOUD_SHADOW_STRENGTH.3=Dramatično

option.GODRAYS=Sunčeve zrake (Godrays)
option.GODRAYS.comment=Adds physically-inspired volumetric single-scattering sun shafts with Beer-Lambert extinction, Mie phase and shadow-map occlusion.
option.GODRAYS_QUALITY=Kvaliteta Godrays
option.GODRAYS_QUALITY.comment=Controls the sample count and integration distance of physically-based volumetric godrays.
value.GODRAYS_QUALITY.1=Brzo
value.GODRAYS_QUALITY.2=Uravnoteženo
value.GODRAYS_QUALITY.3=Visoko

option.AURORA_MODE=Polarna svjetlost (Aurora Borealis)
option.AURORA_MODE.comment=Kontrolirajte prikaz realistične tekuće aurore na noćnom nebu.

value.AURORA_MODE.0=Onemogućeno
value.AURORA_MODE.1=Samo u hladnim biomima
value.AURORA_MODE.2=Uvijek omogućeno

option.AURORA_SPEED=Brzina aurore
option.AURORA_SPEED.comment=Kontrolirajte brzinu njihanja i tečenja aurore.

value.AURORA_SPEED.1=Sporo
value.AURORA_SPEED.2=Standardno
value.AURORA_SPEED.3=Brzo

option.AURORA_STRENGTH=Svjetlina aurore
option.AURORA_STRENGTH.comment=Kontrolirajte ukupnu svjetlinu sjaja aurore.

value.AURORA_STRENGTH.1=Mekano
value.AURORA_STRENGTH.2=Standardno
value.AURORA_STRENGTH.3=Sjajno

option.AURORA_QUALITY=Aurora Quality
option.AURORA_QUALITY.comment=Raymarch steps for Aurora Borealis. Higher settings smooth curtain volume and reduce visible layering; the new centered sampling removes per-pixel grain.
value.AURORA_QUALITY.1=Soft (8 steps)
value.AURORA_QUALITY.2=Balanced (12 steps)
value.AURORA_QUALITY.3=Silky (18 steps)
option.NEBULA_BRIGHTNESS=Svjetlina Kumove slame
option.NEBULA_BRIGHTNESS.comment=Podesite svjetlinu sjaja dijagonalne smećkaste galaktičke maglice noću.

value.NEBULA_BRIGHTNESS.1=Slabo
value.NEBULA_BRIGHTNESS.2=Standardno
value.NEBULA_BRIGHTNESS.3=Svijetlo

option.STARS_BRIGHTNESS=Svjetlina zvijezda
option.STARS_BRIGHTNESS.comment=Kontrolirajte svjetlinu i iskričavi sjaj zvijezda noću.

value.STARS_BRIGHTNESS.1=Slabo
value.STARS_BRIGHTNESS.2=Standardno
value.STARS_BRIGHTNESS.3=Blistavo

option.STARS_AMOUNT=Gustoća zvijezda
option.STARS_AMOUNT.comment=Kontrolirajte ukupnu količinu i gustoću zvijezda na nebu.

value.STARS_AMOUNT.1=Malo
value.STARS_AMOUNT.2=Standardno
value.STARS_AMOUNT.3=Gusto

option.RAINBOW_STRENGTH=Intenzitet duge
option.RAINBOW_STRENGTH.comment=Konfigurirajte svjetlinu i zasićenost boja duge nakon kiše.

value.RAINBOW_STRENGTH.1=Suptilno
value.RAINBOW_STRENGTH.2=Uravnoteženo
value.RAINBOW_STRENGTH.3=Živo

option.COZY_LIGHTS=Treperenje baklje
option.COZY_LIGHTS.comment=Omogućite tople, ugodne animacije treperenja u stvarnom vremenu za baklje, logorske vatre i fenjere.

option.WET_REFLECTIONS=Odrazi mokrine od kiše
option.WET_REFLECTIONS.comment=Kad kiši, čvrsti blokovi poput tla, trave i kamena postaju mokri, tamni i sjajni pod nebom.

option.GROUND_MIST=Niska prizemna magla (Y=62-66)
option.GROUND_MIST.comment=Omogućite mekane, zlatno-bijele jutarnje/večernje slojeve magle koji klize preko vode i leda u zoru i sumrak.

option.FOG_DENSITY_LEVEL=Gustoća magle
option.FOG_DENSITY_LEVEL.comment=Kontrolirajte snagu atmosferske magle na horizontu.

value.FOG_DENSITY_LEVEL.1=Nisko
value.FOG_DENSITY_LEVEL.2=Srednje
value.FOG_DENSITY_LEVEL.3=Visoko







option.TAA=Vremensko izglađivanje rubova (TAA)
option.TAA.comment=Vremensko rješavanje s reprojekcijom pokreta i susjednim izrezivanjem. Smanjuje treperenje i nazubljene rubove na visokim postavkama.
option.TAA_STRENGTH=Snaga TAA
option.TAA_STRENGTH.comment=Kontrolira miješanje povijesti. Veće je stabilnije, ali može biti mekše tijekom pokreta.
value.TAA_STRENGTH.1=Lagano
value.TAA_STRENGTH.2=Uravnoteženo
value.TAA_STRENGTH.3=Stabilno

option.TAA_JITTER=Podrhtavanje kamere (TAA)
option.TAA_JITTER.comment=Subpikselno podrhtavanje kamere (Halton) koje omogućava TAA rekonstrukciju subpikselnih detalja. Isključeno prema zadanim postavkama za potpuno stabilnu sliku; Suptilno i više uklanja visokofrekventno treperenje po cijenu blagog vremenskog ljuljanja. Zahtijeva uključen TAA.
value.TAA_JITTER.0=Isključeno
value.TAA_JITTER.1=Suptilno
value.TAA_JITTER.2=Standardno
value.TAA_JITTER.3=Jako


option.WATER_RIFFLES=Snaga vodenih valića
option.WATER_RIFFLES.comment=Adjust the waviness and intensity of the fine normal map ripples on the water.

value.WATER_RIFFLES.1=Mirno
value.WATER_RIFFLES.2=Standardno
value.WATER_RIFFLES.3=Uzburkano

option.WATER_SPECULAR_STRENGTH=Sjaj odsjaja vode
option.WATER_SPECULAR_STRENGTH.comment=Adjust the brightness of sun/moon reflections on the water ripples.

value.WATER_SPECULAR_STRENGTH.1=Mekano
value.WATER_SPECULAR_STRENGTH.2=Standardno
value.WATER_SPECULAR_STRENGTH.3=Blistavo

option.SHADOW_SOFTNESS=Mekoća sjena
option.SHADOW_SOFTNESS.comment=Kontrolira koliko meki i difuzni izgledaju rubovi sjena. Koristi rotirano Poissonovo filtriranje diska za glatku polusjenu.

value.SHADOW_SOFTNESS.1=Oštro
value.SHADOW_SOFTNESS.2=Mekano
value.SHADOW_SOFTNESS.3=Ultra mekano

# ==============================================================================
# Sun & Moon Lighting (extended)
# ==============================================================================
screen.SUN_MOON=Sunce i Mjesec
screen.SUN_MOON.comment=Fino podesite intenzitet sunca i mjeseca, temperaturu boje i atmosferske efekte.

option.SUN_INTENSITY=Intenzitet sunca
option.SUN_INTENSITY.comment=Glavna svjetlina izravnog sunčevog svjetla. Veće = jači dnevni kontrast.
value.SUN_INTENSITY.1=Prigušeno
value.SUN_INTENSITY.2=Standardno
value.SUN_INTENSITY.3=Svijetlo
value.SUN_INTENSITY.4=Plamteće

option.MOON_INTENSITY=Intenzitet mjeseca
option.MOON_INTENSITY.comment=Glavna svjetlina mjesečine. Veće = svjetlije, vidljivije noći.
value.MOON_INTENSITY.1=Mrkla noć
value.MOON_INTENSITY.2=Standardno
value.MOON_INTENSITY.3=Svijetli mjesec
value.MOON_INTENSITY.4=Puna noć

option.SUN_TEMPERATURE=Temperatura boje sunca
option.SUN_TEMPERATURE.comment=Pomiče Kelvinovu krivulju sunca. Realistično koristi Tanner Helland crno tijelo; toplo = zlatno; hladno = neutralno bijelo.
value.SUN_TEMPERATURE.1=Hladno / Neutralno
value.SUN_TEMPERATURE.2=Realistično
value.SUN_TEMPERATURE.3=Toplo zlatno

option.MOON_TEMPERATURE=Temperatura boje mjeseca
option.MOON_TEMPERATURE.comment=Nijansa mjesečine. Ledeno = plavičasto hladno; Srebrno = realistično 4100K; Toplo = kremasto poput mjeseca žetve.
value.MOON_TEMPERATURE.1=Ledeno plavo
value.MOON_TEMPERATURE.2=Srebrno (Realistično)
value.MOON_TEMPERATURE.3=Toplo krem

option.SUN_HALO=Halo sunca (Mie raspršenje)
option.SUN_HALO.comment=Dodaje mekan topli sjaj na teren pri gledanju blizu sunca (Mie raspršenje unaprijed).

option.SUNRISE_GLOW=Poboljšani sjaj izlaska/zalaska sunca
option.SUNRISE_GLOW.comment=Omogućuje jače toplo povratno raspršenje koje obavija površine okrenute od niskog sunca.

# ==============================================================================
# Extended shadow settings
# ==============================================================================
option.shadowDistance=Udaljenost sjena
option.shadowDistance.comment=Maksimalna udaljenost na kojoj se renderiraju dinamičke sjene. Više vrijednosti proširuju sjene na udaljenost renderiranja; koristite Shadow LOD za održavanje performansi pri proširenim rasponima.
value.shadowDistance.60.0=Blizu (60m)
value.shadowDistance.80.0=Standardno (80m)
value.shadowDistance.120.0=Daleko (120m)
value.shadowDistance.160.0=Ultra (160 m)
value.shadowDistance.256.0=Proširena (256 m)
value.shadowDistance.384.0=Udaljenost renderiranja (384 m)
value.shadowDistance.192.0=DH Seam (192m)
value.shadowDistance.512.0=DH Extended (512m)
value.shadowDistance.768.0=DH Far (768m)

option.SHADOW_LOD=LOD sjena
option.SHADOW_LOD.comment=Kontrolira smanjenje kvalitete sjena s udaljenošću. S produženom udaljenošću sjena (256-384 m), LOD smanjuje broj uzoraka i povećava radijus filtra na daljinu za održavanje performansi. Isključeno = ujednačena kvaliteta (sporo). Uravnoteženo = smanjenje na 25-50% udaljenosti. Agresivno = maksimalno smanjenje na 15-60% udaljenosti. Sjene se potpuno preskaču izvan 95% udaljenosti renderiranja.
value.SHADOW_LOD.0=Isključeno (ujednačena kvaliteta)
value.SHADOW_LOD.1=Uravnoteženo
value.SHADOW_LOD.2=Agresivno
option.DH_SHADOW_RANGE=Distant Horizons Shadow Range
option.DH_SHADOW_RANGE.comment=Maximum range where Distant Horizons LOD terrain and water can receive samples from the shared DH shadow map. Seam keeps shadows close to vanilla chunks; Far extends coverage but can cost more GPU time. No effect without Distant Horizons.
value.DH_SHADOW_RANGE.1=Seam (1.25x)
value.DH_SHADOW_RANGE.2=Extended (2x)
value.DH_SHADOW_RANGE.3=Far (4x)
option.SHADOW_PCSS_BLUR=PCSS zamućenost na udaljenosti
option.SHADOW_PCSS_BLUR.comment=Omogućuje PCSS ublažavanje polusjene koje povećava zamućenost sjena s udaljenošću i tijekom kiše. Onemogućite za fiksnu mekoću (oštrije udaljene sjene, manje realistično).
value.SHADOW_PCSS_BLUR.0=Isključeno (fiksna mekoća)
value.SHADOW_PCSS_BLUR.1=Uključeno (PCSS polusjena)


option.AMBIENT_BRIGHTNESS=Podizanje sjena / ambijent
option.AMBIENT_BRIGHTNESS.comment=Kontrolira koliko tamna izgledaju zasjenjena područja noću i u špiljama.
value.AMBIENT_BRIGHTNESS.1=Tamno
value.AMBIENT_BRIGHTNESS.2=Standardno
value.AMBIENT_BRIGHTNESS.3=Podignuto (Svijetlo)

option.SHADOW_TINT=Nijansa sjena
option.SHADOW_TINT.comment=Boji dnevne sjene. Stvarne sjene pod plavim nebom imaju suptilnu hladnu nijansu.
value.SHADOW_TINT.1=Neutralno sivo
value.SHADOW_TINT.2=Hladno plavo (Realistično)
value.SHADOW_TINT.3=Toplo

option.LIGHT_WRAP=Omot svjetla
option.LIGHT_WRAP.comment=Ublažava terminator između osvijetljenih i neosvijetljenih površina. Realistično = fizikalni Lambert; Meko = ugodno za snimke zaslona.
value.LIGHT_WRAP.1=Realistično (Lambert)
value.LIGHT_WRAP.2=Meki omot
value.LIGHT_WRAP.3=Stilizirano

# v0.2.9 — water/underwater option value labels (English fallback)
