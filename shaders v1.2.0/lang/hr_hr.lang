option.POM_DEPTH=POM dubina
option.POM_DEPTH.comment=Kontrolira vidljivu dubinu parallax mapiranja kada je PBR POM omogućen.
value.POM_DEPTH.1=Niska
value.POM_DEPTH.2=Standardna
value.POM_DEPTH.3=Duboka
option.POM_STEPS=POM koraci
option.POM_STEPS.comment=Kontrolira broj koraka raymarch za parallax mapiranje. Više vrijednosti poboljšavaju kvalitetu, ali zahtijevaju više GPU vremena.
value.POM_STEPS.1=Brzi
