shaderDescription=AuraLite v1.2.0 — भौतिक ढग, आकाश आणि पाणी, रंग सुधारणा
# AuraLite Shaders v1.2.0 - Copyright (c) 2026 AlexanderNyr. Licensed under CC BY-NC-SA 4.0.
# ==============================================================================
# AuraLite Shader Pack - Marathi Language Translations
# ==============================================================================

# ==============================================================================
# Quality Profiles
# ==============================================================================
profile.VERY_LOW=अत्यंत कमी
profile.VERY_LOW.comment=पूर्ण कमाल FPS. सर्व अतिरिक्त बंद: सावल्या नाहीत, ढगाळ नाही, PBR नाही, SSR नाही, प्रकाश किरणे नाहीत. फक्त किमान रेंडरिंग.
profile.LOW=कमी
profile.LOW.comment=हलके पण खेळण्यायोग्य. पाने/पाणी अॅनिमेशन, अधिक तेजस्वी तारे, FXAA, व्हिनेट ठेवते. सावल्या, ढगाळ किंवा PBR नाही.
profile.MED=मध्यम
profile.MED.comment=दैनंदिन आदर्श स्थळ. सावल्या 1024, ढगाळ, PBR, जलद SSR, प्रकाश किरणे, पानांचे SSS, ओलसर प्रतिबिंब, धुके, उल्का.
profile.HIGH=उच्च
profile.HIGH.comment=उत्साही दर्जा. सावल्या 2048, संतुलित SSR, TAA, सूक्ष्म SSAO, संतुलित प्रकाश किरणे, SMAA.
profile.ULTRA=अल्ट्रा
profile.ULTRA.comment=हाय-एंड. सावल्या 4096, उच्च SSR, संतुलित SSAO, उच्च प्रकाश किरणे, स्थिर TAA, सर्व प्रभाव चालू.
profile.EXTREME=अत्यंत
profile.EXTREME.comment=सिनेमॅटिक कमाल. सर्व कमाल: PBR अमर्यादित श्रेणी, फोटोग्राफिक (AgX) टोन मॅप, सर्वात खोल SSAO, उल्का वादळे.
profile.CUSTOM=कस्टम
profile.CUSTOM.comment=वापरकर्त्याने सुधारित केलेल्या सानुकूल सेटिंग्ज.

screen.TRANSLATION_NOTICE=⚠ भाषांतरात चुका असू शकतात
screen.TRANSLATION_NOTICE.comment=काही स्थानिकीकरण स्ट्रिंग्स चुकीच्या असू शकतात. काही विचित्र वाटल्यास, इंग्रजी मूळशी तुलना करा.

# Screens
screen.LIGHTING=प्रकाश सेटिंग्ज
screen.LIGHTING.comment=सावल्या, प्रकाश रंग आणि चमक कॉन्फिगर करा.

screen.FOLIAGE=वनस्पती सेटिंग्ज
screen.FOLIAGE.comment=गवत आणि पानांसाठी लहरी अ‍ॅनिमेशन कॉन्फिगर करा.

screen.WATER=पाणी सेटिंग्ज
screen.WATER.comment=लाटा, पारदर्शकता आणि पाण्याची शैली कॉन्फिगर करा.

screen.CLOUDS_MENU=आकाश आणि ढग
screen.CLOUDS_MENU.comment=3D ढग आणि आकाश प्रभावांची भौतिक उंची, जाडी आणि शैली कॉन्फिगर करा.

screen.POST_PROCESS=पोस्ट-प्रोसेसिंग आणि धुके
screen.POST_PROCESS.comment=एक्सपोजर, धुके आणि सिनेमॅटिक प्रभाव कॉन्फिगर करा.
screen.POST_FOG=Fog & Image
screen.POST_FOG.comment=Fog density, ground mist, heat shimmer and dithering.

# Options
option.SHADOWS=डायनॅमिक सावल्या
option.SHADOWS.comment=सूर्य आणि चंद्रापासून मऊ डायनॅमिक सावल्या सक्षम किंवा अक्षम करा.

option.shadowMapResolution=सावली रिझोल्यूशन
option.shadowMapResolution.comment=सावली नकाशाची गुणवत्ता बदला. उच्च मूल्ये कार्यक्षमता कमी करू शकतात.

option.PBR_LIGHTING=PBR प्रकाशयोजना (LabPBR)
option.PBR_LIGHTING.comment=धातू, खडबडीतपणा आणि 3D सामान्य नकाशांसाठी भौतिक-आधारित रेंडरिंग सक्षम करा (PBR संसाधन पॅक आवश्यक).

option.PBR_POM=3D ब्लॉक रिलीफ (POM)
option.PBR_POM.comment=3D ब्लॉक टेक्सचरसाठी भौतिक-आधारित पॅरालॅक्स ऑक्लूजन मॅपिंग सक्षम करा. विसंगत संसाधन पॅकवर अक्षम करण्याची शिफारस केली जाते.

option.PBR_STRENGTH=PBR तीव्रता
option.PBR_STRENGTH.comment=PBR धातूच्या पृष्ठभागांची परावर्तकता आणि चमक नियंत्रित करा.

value.PBR_STRENGTH.1=सूक्ष्म
value.PBR_STRENGTH.2=मानक
value.PBR_STRENGTH.3=आरसा

option.SSAO=SSAO / SAO ऑक्लूजन
option.SSAO.comment=Extreme profile: screen-space ambient occlusion for contact shadows in corners, under blocks, and around geometry intersections.
option.SSAO_STRENGTH=SSAO सामर्थ्य
option.SSAO_STRENGTH.comment=स्क्रीन-स्पेस अ‍ॅम्बियंट ऑक्लूजनची खोली नियंत्रित करते. फक्त SSAO सक्षम असताना सक्रिय.
value.SSAO_STRENGTH.1=सूक्ष्म
value.SSAO_STRENGTH.2=संतुलित
value.SSAO_STRENGTH.3=खोल

option.LIGHTMAP_WARMTH=मशाल उबदारपणा
option.LIGHTMAP_WARMTH.comment=ब्लॉक/मशाल प्रकाशाची उबदारता आणि रंग समायोजित करा.

value.LIGHTMAP_WARMTH.1=आरामदायी
value.LIGHTMAP_WARMTH.2=उबदार
value.LIGHTMAP_WARMTH.3=तीव्र

option.WAVING_LEAVES=पाने डोलणे
option.WAVING_LEAVES.comment=झाडाच्या पानांसाठी सौम्य लहरी अ‍ॅनिमेशन सक्षम करा.

option.WAVING_GRASS=वनस्पती डोलणे
option.WAVING_GRASS.comment=गवत, फुले आणि पिकांसाठी लहरी अ‍ॅनिमेशन सक्षम करा.

option.WIND_SPEED=वाऱ्याचा वेग
option.WIND_SPEED.comment=पाने, वनस्पती आणि पाण्याच्या लाटांच्या डोलण्याचा वेग नियंत्रित करा.

value.WIND_SPEED.1=मृदू
value.WIND_SPEED.2=वारा
value.WIND_SPEED.3=वादळ

option.WATER_WAVES=पाण्याच्या लाटा
option.WATER_WAVES.comment=Enable 3D geometric waves on the water surface.

option.WATER_TRANSPARENCY=पाण्याची घनता
option.WATER_TRANSPARENCY.comment=Control the transparency and opacity of the water.

value.WATER_TRANSPARENCY.1=स्वच्छ
value.WATER_TRANSPARENCY.2=संतुलित
value.WATER_TRANSPARENCY.3=खोल

option.PROCEDURAL_CLOUDS=व्हॉल्यूमेट्रिक 3D ढग
option.PROCEDURAL_CLOUDS.comment=पोहोचता येण्याजोगे आणि उडता येण्याजोगे भौतिकदृष्ट्या उडणारे 3D ढग सक्षम करा.

option.CLOUD_HEIGHT=ढगांची उंची
option.CLOUD_HEIGHT.comment=जगातील ढगांच्या थराची भौतिक उंची (Y-पातळी) सेट करा (मीटरमध्ये).


option.CLOUD_THICKNESS=ढगांची जाडी
option.CLOUD_THICKNESS.comment=ढगांची उभी जाडी आणि आकारमान कॉन्फिगर करा.


option.CLOUD_DISTANCE=क्लाउड रेंडर अंतर
option.CLOUD_DISTANCE.comment=व्हॉल्यूमेट्रिक ढगांसाठी कमाल ड्रॉ अंतर. गुणवत्ता प्रोफाइल आपोआप ते वाढवतात.

option.CLOUD_SHADOWS=ढगांची सावली
option.CLOUD_SHADOWS.comment=व्हॉल्यूमेट्रिक ढगांच्या घनतेपासून पारदर्शक प्रक्रियात्मक सावल्या भूभागावर जोडते. गुणवत्ता प्रोफाइलद्वारे संतुलित.
option.CLOUD_SHADOW_STRENGTH=ढग सावली सामर्थ्य
option.CLOUD_SHADOW_STRENGTH.comment=पारदर्शक ढगांच्या सावल्या किती दृश्यमान आणि नाट्यमय आहेत हे नियंत्रित करते.
value.CLOUD_SHADOW_STRENGTH.1=मऊ
value.CLOUD_SHADOW_STRENGTH.2=संतुलित
value.CLOUD_SHADOW_STRENGTH.3=नाट्यमय

option.GODRAYS=सूर्यकिरणे (Godrays)
option.GODRAYS.comment=Adds physically-inspired volumetric single-scattering sun shafts with Beer-Lambert extinction, Mie phase and shadow-map occlusion.
option.GODRAYS_QUALITY=Godrays गुणवत्ता
option.GODRAYS_QUALITY.comment=Controls the sample count and integration distance of physically-based volumetric godrays.
value.GODRAYS_QUALITY.1=वेगवान
value.GODRAYS_QUALITY.2=संतुलित
value.GODRAYS_QUALITY.3=उच्च

option.AURORA_MODE=अरोरा बोरियालिस
option.AURORA_MODE.comment=रात्रीच्या आकाशात वास्तववादी वाहणाऱ्या अरोराच्या प्रदर्शनावर नियंत्रण ठेवा.

value.AURORA_MODE.0=अक्षम
value.AURORA_MODE.1=फक्त थंड बायोममध्ये
value.AURORA_MODE.2=नेहमी सक्षम

option.AURORA_SPEED=अरोरा वेग
option.AURORA_SPEED.comment=उत्तर दिव्यांचा डोलण्याचा आणि वाहण्याचा वेग नियंत्रित करा.

value.AURORA_SPEED.1=संथ
value.AURORA_SPEED.2=मानक
value.AURORA_SPEED.3=वेगवान

option.AURORA_STRENGTH=अरोरा तेजस्विता
option.AURORA_STRENGTH.comment=उत्तर दिव्यांच्या एकूण चमकाची तेजस्विता नियंत्रित करा.

value.AURORA_STRENGTH.1=मऊ
value.AURORA_STRENGTH.2=मानक
value.AURORA_STRENGTH.3=चमकणारे

option.AURORA_QUALITY=Aurora Quality
option.AURORA_QUALITY.comment=Raymarch steps for Aurora Borealis. Higher settings smooth curtain volume and reduce visible layering; the new centered sampling removes per-pixel grain.
value.AURORA_QUALITY.1=Soft (8 steps)
value.AURORA_QUALITY.2=Balanced (12 steps)
value.AURORA_QUALITY.3=Silky (18 steps)
option.NEBULA_BRIGHTNESS=आकाशगंगा तेजस्विता
option.NEBULA_BRIGHTNESS.comment=रात्री तिरप्या तपकिरी आकाशगंगा नेब्युलाची चमक समायोजित करा.

value.NEBULA_BRIGHTNESS.1=फिकट
value.NEBULA_BRIGHTNESS.2=मानक
value.NEBULA_BRIGHTNESS.3=तेजस्वी

option.STARS_BRIGHTNESS=तार्‍यांची तेजस्विता
option.STARS_BRIGHTNESS.comment=रात्री तार्‍यांची तेजस्विता आणि चमचमणारी चमक नियंत्रित करा.

value.STARS_BRIGHTNESS.1=फिकट
value.STARS_BRIGHTNESS.2=मानक
value.STARS_BRIGHTNESS.3=तेजस्वी

option.STARS_AMOUNT=तार्‍यांची घनता
option.STARS_AMOUNT.comment=आकाशातील तार्‍यांचे एकूण प्रमाण आणि घनता नियंत्रित करा.

value.STARS_AMOUNT.1=कमी
value.STARS_AMOUNT.2=मानक
value.STARS_AMOUNT.3=दाट

option.RAINBOW_STRENGTH=इंद्रधनुष्य तीव्रता
option.RAINBOW_STRENGTH.comment=पावसानंतरच्या इंद्रधनुष्याची चमक आणि रंग संपृक्तता कॉन्फिगर करा.

value.RAINBOW_STRENGTH.1=सूक्ष्म
value.RAINBOW_STRENGTH.2=संतुलित
value.RAINBOW_STRENGTH.3=चैतन्यशील

option.COZY_LIGHTS=मशाल लुकलुकणे
option.COZY_LIGHTS.comment=मशाल, कॅम्पफायर आणि कंदीलांसाठी उबदार, आरामदायक, रिअल-टाइम लुकलुकणारे अ‍ॅनिमेशन सक्षम करा.

option.WET_REFLECTIONS=पावसाच्या ओलाव्याचे प्रतिबिंब
option.WET_REFLECTIONS.comment=पाऊस पडत असताना, जमीन, गवत आणि दगड यांसारखे घन ब्लॉक्स आकाशाखाली ओले, गडद आणि चमकदार होतात.

option.GROUND_MIST=कमी जमिनीचे धुके (Y=62-66)
option.GROUND_MIST.comment=पहाटे आणि संध्याकाळी पाणी आणि बर्फावर सरकणारे मऊ, सोनेरी-पांढरे सकाळी/संध्याकाळचे धुक्याचे थर सक्षम करा.

option.FOG_DENSITY_LEVEL=धुक्याची घनता
option.FOG_DENSITY_LEVEL.comment=वातावरणीय क्षितिज धुक्याची ताकद नियंत्रित करा.

value.FOG_DENSITY_LEVEL.1=कमी
value.FOG_DENSITY_LEVEL.2=मध्यम
value.FOG_DENSITY_LEVEL.3=उच्च







option.TAA=टेम्पोरल अँटी-अलायझिंग (TAA)
option.TAA.comment=मोशन रिप्रोजेक्शन आणि नेबरहुड क्लिपिंगसह टेम्पोरल रिझॉल्व्ह. उच्च प्रीसेटवर लुकलुकणे आणि दातेरी कडा कमी करते.
option.TAA_STRENGTH=TAA सामर्थ्य
option.TAA_STRENGTH.comment=इतिहास मिश्रण नियंत्रित करते. जास्त अधिक स्थिर आहे परंतु हालचालीदरम्यान मऊ असू शकते.
value.TAA_STRENGTH.1=हलके
value.TAA_STRENGTH.2=संतुलित
value.TAA_STRENGTH.3=स्थिर

option.TAA_JITTER=कॅमेरा कंपन (TAA)
option.TAA_JITTER.comment=TAA ला सबपिक्सेल तपशील पुनर्निर्मित करण्यास अनुमती देणारा सबपिक्सेल Halton कॅमेरा कंपन. पूर्णपणे स्थिर प्रतिमेसाठी डीफॉल्टनुसार बंद; सूक्ष्म आणि त्याहून अधिक उच्च-फ्रिक्वेन्सी लुकलुकाट हलक्या तात्पुरत्या डोलण्याच्या किंमतीवर काढून टाकते. TAA चालू असणे आवश्यक आहे.
value.TAA_JITTER.0=बंद
value.TAA_JITTER.1=सूक्ष्म
value.TAA_JITTER.2=मानक
value.TAA_JITTER.3=मजबूत


option.WATER_RIFFLES=पाणी लहर सामर्थ्य
option.WATER_RIFFLES.comment=Adjust the waviness and intensity of the fine normal map ripples on the water.

value.WATER_RIFFLES.1=शांत
value.WATER_RIFFLES.2=मानक
value.WATER_RIFFLES.3=खवळलेले

option.WATER_SPECULAR_STRENGTH=पाणी स्पेक्युलर चमक
option.WATER_SPECULAR_STRENGTH.comment=Adjust the brightness of sun/moon reflections on the water ripples.

value.WATER_SPECULAR_STRENGTH.1=मऊ
value.WATER_SPECULAR_STRENGTH.2=मानक
value.WATER_SPECULAR_STRENGTH.3=चमकणारा

option.SHADOW_SOFTNESS=सावली मऊपणा
option.SHADOW_SOFTNESS.comment=सावलीच्या कडा किती मऊ आणि पसरलेल्या दिसतात हे नियंत्रित करते. गुळगुळीत उपछायेसाठी फिरवलेले पॉइसन डिस्क फिल्टरिंग वापरते.

value.SHADOW_SOFTNESS.1=तीक्ष्ण
value.SHADOW_SOFTNESS.2=मऊ
value.SHADOW_SOFTNESS.3=अति मऊ

# ==============================================================================
# Sun & Moon Lighting (extended)
# ==============================================================================
screen.SUN_MOON=सूर्य आणि चंद्र
screen.SUN_MOON.comment=सूर्य आणि चंद्राची तीव्रता, रंग तापमान आणि वातावरणीय प्रभाव सूक्ष्मपणे समायोजित करा.

option.SUN_INTENSITY=सूर्य तीव्रता
option.SUN_INTENSITY.comment=थेट सूर्यप्रकाशाची मास्टर चमक. जास्त = मजबूत दिवसाचा कॉन्ट्रास्ट.
value.SUN_INTENSITY.1=मंद
value.SUN_INTENSITY.2=मानक
value.SUN_INTENSITY.3=उच्च
value.SUN_INTENSITY.4=धगधगणारे

option.MOON_INTENSITY=चंद्र तीव्रता
option.MOON_INTENSITY.comment=चंद्रप्रकाशाची मास्टर चमक. जास्त = उजळ, अधिक दृश्यमान रात्री.
value.MOON_INTENSITY.1=मिट्ट काळोखी रात्र
value.MOON_INTENSITY.2=मानक
value.MOON_INTENSITY.3=तेजस्वी चंद्र
value.MOON_INTENSITY.4=पूर्ण रात्र

option.SUN_TEMPERATURE=सूर्य रंग तापमान
option.SUN_TEMPERATURE.comment=सूर्याचा केल्विन वक्र बदलतो. वास्तववादी टॅनर हेलँड ब्लॅकबॉडी वापरतो; उबदार = सोनेरी; थंड = तटस्थ पांढरा.
value.SUN_TEMPERATURE.1=थंड / तटस्थ
value.SUN_TEMPERATURE.2=वास्तववादी
value.SUN_TEMPERATURE.3=उबदार सोनेरी

option.MOON_TEMPERATURE=चंद्र रंग तापमान
